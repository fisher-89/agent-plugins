{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "matcher": "Write|StrReplace",
        "command": "node \"__INSTALL_PLUGIN_ROOT__/bin/dev-team_hooks.cjs\" protect-files"
      },
      {
        "matcher": "Shell",
        "command": "node \"__INSTALL_PLUGIN_ROOT__/bin/dev-team_hooks.cjs\" protect-files"
      }
    ],
    "postToolUse": [
      {
        "matcher": "Write|StrReplace|Shell|mcp__user-dev-team_mcp__phase_next|mcp__user-dev-team_mcp__phase_start",
        "command": "node \"__INSTALL_PLUGIN_ROOT__/bin/dev-team_hooks.cjs\" record-files"
      }
    ]
  }
}
