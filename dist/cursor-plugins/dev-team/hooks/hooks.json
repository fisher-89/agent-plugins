{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "matcher": "Write|StrReplace",
        "command": "node \"./bin/hooks.cjs\" protect-files"
      },
      {
        "matcher": "Shell",
        "command": "node \"./bin/hooks.cjs\" protect-files"
      }
    ],
    "postToolUse": [
      {
        "matcher": "Write|StrReplace|Shell|mcp__plugin_dev-team_dev-team__phase_next|mcp__plugin_dev-team_dev-team__phase_start",
        "command": "node \"./bin/hooks.cjs\" record-files"
      }
    ]
  }
}
