{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dev-team",
  "version": "../package.json",
  "identifier": "dev.wps.dev-team",
  "build": {
    "beforeDevCommand": "pnpm client:dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm client:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Dev Team",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/fisher-89/agent-plugins/releases/latest/download/latest.json"
      ],
