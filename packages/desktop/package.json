{
  "name": "desktop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tauri dev",
    "client:dev": "vp dev",
    "build": "tauri build",
    "client:build": "tsc && vp build",
    "check": "pnpm run client:check && pnpm run server:check",
    "client:check": "vp check --fix && knip",
    "server:check": "cd src-tauri && cargo fmt && cargo clippy",
    "test": "vp test && cd src-tauri && cargo test --workspace",
    "mutation-test": "stryker run"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^26.0.0",
    "knip": "^6.37.0",
    "typescript": "^5.6.0",
    "vite-plus": "^0.2.1"
  }
}
