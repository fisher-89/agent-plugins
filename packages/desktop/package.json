{
  "name": "desktop",
  "version": "0.3.9",
  "private": true,
  "scripts": {
    "dev": "tauri dev",
    "client:dev": "vp dev",
    "build": "pnpm run bindings:export && pnpm run server:build",
    "client:build": "tsc && vp build",
    "server:build": "cross-env TAURI_SIGNING_PRIVATE_KEY_PASSWORD= tauri build",
    "bindings:export": "cargo run --quiet -p export-bindings --manifest-path src-tauri/Cargo.toml",
    "bindings:check": "pnpm run bindings:export && git diff --exit-code -- src/types/generated",
    "check": "pnpm run server:check && pnpm run bindings:export && pnpm run client:check",
    "client:check": "vp check --fix && knip",
    "server:check": "cargo fmt --manifest-path src-tauri/Cargo.toml && cargo clippy --manifest-path src-tauri/Cargo.toml",
    "test": "pnpm run client:test && pnpm run server:test",
    "client:test": "vp test --sequence.shuffle",
    "server:test": "cargo test --workspace --manifest-path src-tauri/Cargo.toml",
    "mutate": "stryker run && cd src-tauri && cargo mutate",
    "tauri": "tauri"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.121",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@shadcn/react": "^0.3.1",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-updater": "~2.12.0",
    "@xyflow/react": "^12.11.0",
    "ai": "^7.0.118",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "react-resizable-panels": "^4.13.2",
    "react-router": "^7.18.4",
    "remark-gfm": "^4.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/react": "^16.3.0",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^10.1.0",
    "jsdom": "^26.0.0",
    "knip": "^6.37.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.0",
    "vite-plus": "^0.2.1"
  }
}
