{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "matcher": "Write|StrReplace",
        "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/hooks.cjs\" protect-files"
      },
      {
        "matcher": "Shell",
        "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/hooks.cjs\" protect-files"
      }
    ]
  }
}
