{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eval.schema.json",
  "title": "Evaluation Entry",
  "description": "Schema for a single evaluation entry appended to eval.json array",
  "type": "object",
  "required": ["phase", "timestamp", "attempt", "verdict", "report", "items", "backtrack_to", "schema_version"],
  "properties": {
    "phase": {
      "type": "string",
      "description": "Phase identifier (e.g. '01-proposal', '03-test-design')",
      "examples": ["01-proposal", "02-dev-design", "06-code-review"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of evaluation"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "description": "1-based attempt number for this phase"
    },
    "verdict": {
      "type": "string",
      "enum": ["pass", "fail"],
      "description": "Overall evaluation verdict"
    },
    "report": {
      "type": "string",
      "maxLength": 500,
      "description": "Human-readable summary of what was checked and why the verdict was reached"
    },
    "items": {
      "type": "array",
      "description": "Per-checklist-item evaluation results",
      "items": {
        "type": "object",
        "required": ["item", "pass", "evidence", "notes"],
        "properties": {
          "item": {
            "type": "string",
            "description": "Checklist item description (检查项)"
          },
          "pass": {
            "type": "boolean",
            "description": "Whether this checklist item passed"
          },
          "evidence": {
            "type": "string",
            "description": "Specific evidence quote or observation from artifact or code"
          },
          "notes": {
            "type": "string",
            "description": "Evaluator notes about this item"
          }
        }
      }
    },
    "backtrack_to": {
      "type": ["string", "null"],
      "description": "Phase identifier to backtrack to, or null if no backtrack needed"
    }
  }
}
