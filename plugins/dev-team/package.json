{
  "name": "dev-team-cli",
  "version": "2.10.43",
  "private": true,
  "description": "dev-team CLI - eval-log command for OpenSpec workflow",
  "type": "module",
  "scripts": {
    "build": "rimraf .pack-staging && vp pack",
    "start:likec4": "mcp-inspector npx -y @likec4/mcp@1.58.0",
