    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^25.9.3",
    "@types/picomatch": "^4.0.3",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/ui": "4.1.9",
    "knip": "^6.17.1",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vite-plus": "^0.2.1"
