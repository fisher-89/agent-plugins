{
  "description": "dev-team hooks：PreToolUse 保护受保护文件；SubagentStop 在 generator 结束时执行 static-check。",
  "preToolUse": [
    {
      "matchers": {
        "claudeNested": "Write|Edit",
        "cursorNative": "Write|StrReplace"
      },
      "commandTemplate": "node \"__DEV_TEAM_RUNTIME_ROOT__/bin/__BIN:hooks__\" protect-files"
    },
    {
      "matchers": {
        "claudeNested": "Bash",
        "cursorNative": "Shell"
      },
      "commandTemplate": "node \"__DEV_TEAM_RUNTIME_ROOT__/bin/__BIN:hooks__\" protect-files"
    },
    {
      "matchers": {
        "claudeNested": "PowerShell",
        "cursorNative": "PowerShell"
      },
      "commandTemplate": "node \"__DEV_TEAM_RUNTIME_ROOT__/bin/__BIN:hooks__\" protect-files"
    }
  ],
  "subagentStop": [
    {
      "agentLogicalId": "implementation-generator",
      "loop_limit": 5,
      "commandTemplate": "node \"__DEV_TEAM_RUNTIME_ROOT__/bin/__BIN:hooks__\" static-check"
    },
    {
      "agentLogicalId": "test-gen-generator",
      "loop_limit": 5,
      "commandTemplate": "node \"__DEV_TEAM_RUNTIME_ROOT__/bin/__BIN:hooks__\" static-check"
    }
  ]
}
