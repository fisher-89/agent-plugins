{
  "description": "dev-team hooks：PreToolUse 保护受保护文件；SubagentStop static-check 主要作用于 Claude（Cursor 经 agent include 软门禁）。",
  "preToolUse": [
    {
      "matchers": {
        "claude": "Write|Edit",
        "cursor": "Write|StrReplace"
      },
      "commandTemplate": "node \"__DEV_TEAM_ROOT__/bin/__BIN:hooks__\" protect-files"
    },
    {
      "matchers": {
        "claude": "Bash",
        "cursor": "Shell"
      },
      "commandTemplate": "node \"__DEV_TEAM_ROOT__/bin/__BIN:hooks__\" protect-files"
    },
    {
      "matchers": {
        "claude": "PowerShell",
        "cursor": null
      },
      "commandTemplate": "node \"__DEV_TEAM_ROOT__/bin/__BIN:hooks__\" protect-files"
    }
  ],
  "subagentStop": [
    {
      "matchers": {
        "claude": "__CALL_AGENT:implementation-generator__",
        "cursor": null
      },
      "loop_limit": 5,
      "commandTemplate": "node \"__DEV_TEAM_ROOT__/bin/__BIN:hooks__\" static-check"
    },
    {
      "matchers": {
        "claude": "__CALL_AGENT:test-gen-generator__",
        "cursor": null
      },
      "loop_limit": 5,
      "commandTemplate": "node \"__DEV_TEAM_ROOT__/bin/__BIN:hooks__\" static-check"
    }
  ]
}
