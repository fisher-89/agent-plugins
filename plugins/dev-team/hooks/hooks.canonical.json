{
  "description": "dev-team hooks：PreToolUse 保护受保护文件（写/删保护与批量还原拦截）；PostToolUse record-files 将文件操作归账到当前 change 的文件清单（Claude 与 Cursor，Cursor 工具集为 Write/StrReplace/Shell）；SubagentStop static-check 主要作用于 Claude（Cursor 经 agent include 软门禁）。",
  "preToolUse": [
    {
      "matchers": {
        "claude": "Write|Edit",
        "cursor": "Write|StrReplace"
      },
      "commandTemplate": "node \"__DEV_TEAM_ROOT__/bin/__BIN:hooks__\" protect-files"
    },
    {
      "matchers": {
        "claude": "Bash",
        "cursor": "Shell"
      },
      "commandTemplate": "node \"__DEV_TEAM_ROOT__/bin/__BIN:hooks__\" protect-files"
    },
    {
      "matchers": {
        "claude": "PowerShell",
        "cursor": null
      },
      "commandTemplate": "node \"__DEV_TEAM_ROOT__/bin/__BIN:hooks__\" protect-files"
    }
  ],
  "postToolUse": [
    {
      "matchers": {
        "claude": "Write|Edit|NotebookEdit|Bash|PowerShell|__MCP:phase_next__|__MCP:phase_start__",
        "cursor": "Write|StrReplace|Shell|__MCP:phase_next__|__MCP:phase_start__"
      },
      "commandTemplate": "node \"__DEV_TEAM_ROOT__/bin/__BIN:hooks__\" record-files"
    }
  ],
  "subagentStop": [
    {
      "matchers": {
        "claude": "__CALL_AGENT:implementation-generator__",
        "cursor": null
      },
      "loop_limit": 5,
      "commandTemplate": "node \"__DEV_TEAM_ROOT__/bin/__BIN:hooks__\" static-check"
    },
    {
      "matchers": {
        "claude": "__CALL_AGENT:test-gen-generator__",
        "cursor": null
      },
      "loop_limit": 5,
      "commandTemplate": "node \"__DEV_TEAM_ROOT__/bin/__BIN:hooks__\" static-check"
    }
  ],
  "userPromptSubmit": [
    {
      "matchers": {
        "claude": "*",
        "cursor": null
      },
      "commandTemplate": "node \"__DEV_TEAM_ROOT__/bin/__BIN:hooks__\" sweep-phase"
    }
  ]
}
