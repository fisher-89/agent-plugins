{
  "description": "dev-team 插件 hooks：PreToolUse 保护 eval.json 不被 agent 直接写入；subagentStop 在 implementation-generator 结束时自动执行 static_analysis 静态检查。",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/protect-eval.mjs\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/protect-eval.mjs\""
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/protect-eval.mjs\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "implementation-generator",
        "loop_limit": 5,
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/static-check.mjs\""
          }
        ]
      },
      {
        "matcher": "test-gen-generator",
        "loop_limit": 5,
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/static-check.mjs\""
          }
        ]
      }
    ]
  }
}
