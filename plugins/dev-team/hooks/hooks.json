{
  "description": "保护 eval.json 不被 agent 直接写入：所有对 openspec/changes/<name>/eval.json 的写入必须通过 phase_log MCP 工具 (mcp__plugin_dev-team_dev-team__phase_log) 完成。拦截内置工具 Write、Edit 和 Bash 对 eval.json 的直接写入。",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/protect-eval.sh\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/protect-eval.sh\""
          }
        ]
      }
    ]
  }
}
