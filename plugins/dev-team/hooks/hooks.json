{
  "description": "dev-team 插件 hooks：PreToolUse 保护 eval.json 不被 agent 直接写入；subagentStop 在 implementation-generator 结束时自动执行 static_analysis 静态检查，未通过则返回 followup_message 要求修复（最多 5 次循环）。",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/protect-eval.sh\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/protect-eval.sh\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "implementation-generator",
        "loop_limit": 5,
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/static-check.sh\""
          }
        ]
      }
    ]
  }
}
