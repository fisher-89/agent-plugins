{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "schema规则文件",
      "type": "string"
    },
    "schema": {
      "description": "@deprecated 模式标识，固定为 spec-driven",
      "type": "string",
      "const": "spec-driven"
    },
    "context": {
      "description": "项目上下文描述，用于向 AI 提供业务背景信息",
      "type": "string"
    },
    "rules": {
      "description": "自定义规则配置，按工作流阶段分组",
      "type": "object",
      "properties": {
        "proposal": {
          "description": "提案阶段的自定义规则列表",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tasks": {
          "description": "任务阶段的自定义规则列表",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "static_analysis": {
      "description": "静态分析工具配置（如 ESLint、Prettier）",
      "type": "string"
    },
    "tests": {
      "description": "测试 suite 配置列表",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "root": {
            "type": "string",
            "minLength": 1,
            "description": "suite 锚点路径（相对 projectRoot，禁止通配符）"
          },
          "framework": {
            "type": "string",
            "enum": [
              "jest",
              "vitest",
              "vite-plus",
              "bun",
              "rust",
              "node-test",
              "go",
              "pytest"
            ],
            "description": "测试框架"
          },
          "cwd": {
            "description": "执行目录（相对 root，默认 \".\"）",
            "type": "string"
          },
          "config": {
            "description": "框架配置文件路径（相对 root）",
            "type": "string",
            "minLength": 1
          },
          "includes": {
            "description": "匹配 glob 列表（相对 root）",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "excludes": {
            "description": "排除 glob 列表（相对 root）",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "coverage": {
            "description": "覆盖率阈值",
            "type": "object",
            "properties": {
              "lines": {
                "description": "行覆盖率阈值（百分比，默认 80）",
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "branches": {
                "description": "分支覆盖率阈值（百分比，默认 70）",
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "functions": {
                "description": "函数覆盖率阈值（百分比，默认 75）",
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            },
            "required": [
              "lines",
              "branches",
              "functions"
            ],
            "additionalProperties": false
          },
          "mutation": {
            "description": "变异测试配置",
            "type": "object",
            "properties": {
              "score": {
                "description": "变异测试得分阈值（百分比，默认 70）",
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            },
            "required": [
              "score"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "root",
          "framework",
          "cwd",
          "coverage",
          "mutation"
        ],
        "additionalProperties": false,
        "description": "测试 suite 配置"
      }
    },
    "write_protection": {
      "description": "写入保护配置，定义受保护的文件路径模式",
      "type": "object",
      "properties": {
        "files": {
          "description": "需要保护的文件 glob 模式列表",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "glob": {
                "description": "文件路径 glob 模式（如 \"openspec/changes/**/eval.json\"）",
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "description": "自定义拒绝原因，支持 %s（文件路径）和 %t（工具名称）占位符",
                "type": "string"
              }
            },
            "additionalProperties": false,
            "description": "单条写入保护规则"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "tests"
  ],
  "additionalProperties": {}
}