{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "schema规则文件",
      "type": "string"
    },
    "schema": {
      "description": "@deprecated 模式标识，固定为 spec-driven",
      "type": "string",
      "const": "spec-driven"
    },
    "context": {
      "description": "项目上下文描述，用于向 AI 提供业务背景信息",
      "type": "string"
    },
    "rules": {
      "description": "自定义规则配置，按工作流阶段分组",
      "type": "object",
      "properties": {
        "proposal": {
          "description": "提案阶段的自定义规则列表",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tasks": {
          "description": "任务阶段的自定义规则列表",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "static_analysis": {
      "description": "静态分析工具配置（如 ESLint、Prettier）",
      "type": "string"
    },
    "test": {
      "description": "测试相关配置",
      "type": "object",
      "properties": {
        "framework": {
          "type": "string",
          "enum": [
            "jest",
            "vitest",
            "vite-plus",
            "bun",
            "rust",
            "node-test",
            "go",
            "pytest"
          ],
          "description": "测试框架"
        },
        "coverage": {
          "description": "测试覆盖率",
          "type": "object",
          "properties": {
            "lines": {
              "description": "行覆盖率阈值（百分比，默认 80）",
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "branches": {
              "description": "分支覆盖率阈值（百分比，默认 70）",
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "functions": {
              "description": "函数覆盖率阈值（百分比，默认 75）",
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "lines",
            "branches",
            "functions"
          ],
          "additionalProperties": false
        },
        "mutation": {
          "description": "变异测试配置",
          "type": "object",
          "properties": {
            "score": {
              "description": "变异测试得分阈值（百分比，默认 70）",
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "score"
          ],
          "additionalProperties": false
        },
        "overrides": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1,
                "description": "文件路径，支持glob规则（如 \"src/**/*.test.ts\"）"
              },
              "framework": {
                "type": "string",
                "enum": [
                  "jest",
                  "vitest",
                  "vite-plus",
                  "bun",
                  "rust",
                  "node-test",
                  "go",
                  "pytest"
                ],
                "description": "测试框架"
              },
              "coverage": {
                "description": "测试覆盖率",
                "type": "object",
                "properties": {
                  "lines": {
                    "description": "行覆盖率阈值（百分比，默认 80）",
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "branches": {
                    "description": "分支覆盖率阈值（百分比，默认 70）",
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "functions": {
                    "description": "函数覆盖率阈值（百分比，默认 75）",
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  }
                },
                "required": [
                  "lines",
                  "branches",
                  "functions"
                ],
                "additionalProperties": false
              },
              "mutation": {
                "type": "object",
                "properties": {
                  "score": {
                    "description": "变异测试得分阈值（百分比）",
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  }
                },
                "additionalProperties": false,
                "description": "变异测试覆盖配置"
              }
            },
            "required": [
              "file"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "write_protection": {
      "description": "写入保护配置，定义受保护的文件路径模式",
      "type": "object",
      "properties": {
        "files": {
          "description": "需要保护的文件 glob 模式列表",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "glob": {
                "type": "string",
                "minLength": 1,
                "description": "文件路径 glob 模式（如 \"openspec/changes/**/eval.json\"）"
              },
              "reason": {
                "description": "自定义拒绝原因，支持 %s（文件路径）和 %t（工具名称）占位符",
                "type": "string"
              }
            },
            "required": [
              "glob"
            ],
            "additionalProperties": false,
            "description": "单条写入保护规则"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "test"
  ],
  "additionalProperties": false
}