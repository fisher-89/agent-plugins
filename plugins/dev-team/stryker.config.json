{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "bin/src/**/*.ts",
    "!bin/src/**/*.test.ts",
    "!bin/src/schemas/**",
    "build/**/*.ts",
    "!build/**/*.test.ts"
  ],
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": {
    "configFile": "vite.config.ts"
  },
  "ignoreStatic": true,
  "reporters": ["html", "clear-text", "progress"],
  "thresholds": { "high": 80, "low": 60, "break": 50 }
}
