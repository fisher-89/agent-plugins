{
  "$schema": "https://raw.githubusercontent.com/fisher-89/agent-plugins/refs/heads/master/packages/desktop/src-tauri/crates/core/config/config.schema.json",
  "schema": "spec-driven",
  "static_analysis": "pnpm run -C ./packages/desktop check",
  "projects": [{ "root": "packages/desktop" }, { "root": "packages/desktop/src-tauri" }],
  "tests": [
    {
      "root": "packages/desktop",
      "framework": "vite-plus",
      "config": "vite.config.ts",
      "includes": ["src/**/*.test.{ts,tsx}"],
      "excludes": ["src/components/ui/**/*", "src/routes.tsx", "src/types/generated/**/*"],
      "coverage": { "lines": 85, "branches": 75, "functions": 80 },
      "mutation": { "score": 60 }
    },
    {
      "root": "packages/desktop/src-tauri",
      "framework": "rust",
      "coverage": { "lines": 85, "branches": 75, "functions": 80 },
      "mutation": { "score": 60 }
    }
  ],
  "write_protection": {
    "files": [{ "glob": "packages/desktop/knip.json" }]
  }
}
