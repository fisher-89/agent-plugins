specification {
  element package
  element domain
  element module
  element component
}

model {
  // ==========================================================================
  // PACKAGES — top-level deployable units
  // ==========================================================================

  package DevTeamPlugin {
    // Custom Claude Code plugin implementing SDD workflow with hooks, agents, and utilities
    metadata { path ['./plugins/dev-team/'] }
  }

  package ClaudeCode {
    // Claude CLI runtime — hosts plugins and invokes hooks for tool lifecycle events
  }

  package OpenSpecCLI {
    // External CLI for OpenSpec workflow management (explore, propose, apply, archive)
  }

  // ==========================================================================
  // DEV-TEAM-PLUGIN DOMAINS
  // ==========================================================================

  extend DevTeamPlugin {
    domain Hooks {
      // Intercept Claude Code tool calls for workflow gates
      metadata { path ['./plugins/dev-team/hooks/'] }
    }

    domain Skills {
      // Slash command implementations (thin routing wrappers)
      metadata { path ['./plugins/dev-team/skills/'] }
    }

    domain Agents {
      // Subagent definitions for specialized, context-intensive tasks
      metadata { path ['./plugins/dev-team/agents/'] }
    }

    domain Utils {
      // Python utilities for deterministic, scriptable SDD workflow tasks
      metadata { path ['./plugins/dev-team/utils/'] }
    }

    domain Templates {
      // File templates for bootstrapping artifacts
      metadata { path ['./plugins/dev-team/templates/'] }
    }
  }

  // ==========================================================================
  // HOOKS DOMAIN — modules and components
  // ==========================================================================

  extend DevTeamPlugin.Hooks {
    module CommitGates {
      // Commit-time validation gates (quality + architecture)
      metadata { path ['./plugins/dev-team/hooks/commit-gates/'] }
    }

    component TDDGate {
      // PreToolUse (Write|Edit): injects TDD reminder
      metadata { path ['./plugins/dev-team/hooks/pre-tool-openspec-test.py'] }
    }

    component SkillGate {
      // PreToolUse (Skill): intercepts archive-change and apply-change skills
      metadata { path ['./plugins/dev-team/hooks/pre-tool-skill.py'] }
    }

    component SessionStartGate {
      // SessionStart: ensures openspec CLI is available
      metadata { path ['./plugins/dev-team/hooks/session-start-ensure-openspec.py'] }
    }
  }

  extend DevTeamPlugin.Hooks.CommitGates {
    component BeforeCommit {
      // Routes git commit events to QualityGate and ArchitectureGate
      metadata { path ['./plugins/dev-team/hooks/commit-gates/before-commit.py'] }
    }

    component QualityGate {
      // SDD quality gate: report chain, lint/type checks, test suite, code review
      metadata { path ['./plugins/dev-team/hooks/commit-gates/quality.py'] }
    }

    component ArchitectureGate {
      // Architecture validation gate: verifies staged code matches model
      metadata { path ['./plugins/dev-team/hooks/commit-gates/architecture.py'] }
    }
  }

  // ==========================================================================
  // SKILLS DOMAIN — components
  // ==========================================================================

  extend DevTeamPlugin.Skills {
    component ExploreSkill {
      // Routes to OpenSpec CLI explore mode
      metadata { path ['./plugins/dev-team/skills/openspec-explore/'] }
    }

    component ProposeSkill {
      // Routes to OpenSpec CLI to create new change proposals
      metadata { path ['./plugins/dev-team/skills/openspec-propose/'] }
    }

    component ApplyChangeSkill {
      // Routes to OpenSpec CLI to implement tasks from an active change
      metadata { path ['./plugins/dev-team/skills/openspec-apply-change/'] }
    }

    component ArchiveChangeSkill {
      // Routes to OpenSpec CLI to archive a completed change
      metadata { path ['./plugins/dev-team/skills/openspec-archive-change/'] }
    }

    component CodeReviewSkill {
      // Routes review requests to code-review subagent via Agent tool
      metadata { path ['./plugins/dev-team/skills/code-review/'] }
    }

    component UpdateArchitectureSkill {
      // Routes architecture requests to architecture subagent via Agent tool
      metadata { path ['./plugins/dev-team/skills/update-architecture/'] }
    }
  }

  // ==========================================================================
  // AGENTS DOMAIN — components
  // ==========================================================================

  extend DevTeamPlugin.Agents {
    component CodeReviewAgent {
      // Reviews staged code for logic errors, null handling, redundant logic, security
      metadata { path ['./plugins/dev-team/agents/code-review.md'] }
    }

    component ArchitectureAgent {
      // Manages architecture model, validates code, creates ADRs, reviews model quality
      metadata { path ['./plugins/dev-team/agents/architecture.md'] }
    }
  }

  // ==========================================================================
  // UTILS DOMAIN — components
  // ==========================================================================

  extend DevTeamPlugin.Utils {
    component ActiveChange {
      // Finds active OpenSpec change with priority ordering
      metadata { path ['./plugins/dev-team/utils/active-change.py'] }
    }

    component StepReport {
      // Saves and loads structured JSON step reports for SDD workflow
      metadata { path ['./plugins/dev-team/utils/step-report.py'] }
    }

    component ReportChain {
      // Validates SDD report chains (scope -> lint -> scoped-test)
      metadata { path ['./plugins/dev-team/utils/report-chain.py'] }
    }

    component TestScope {
      // Identifies test scope for changed files
      metadata { path ['./plugins/dev-team/utils/test-scope.py'] }
    }

    component TestGenerator {
      // Generates test skeletons for source files
      metadata { path ['./plugins/dev-team/utils/test-generator.py'] }
    }

    component LintRunner {
      // Runs type checks and linting tools
      metadata { path ['./plugins/dev-team/utils/lint-runner.py'] }
    }

    component TestRunner {
      // Runs test suites with structured output
      metadata { path ['./plugins/dev-team/utils/test-runner.py'] }
    }

    component ArchiModel {
      // Architecture model: query, validate, write DSL
      metadata { path ['./plugins/dev-team/utils/archi-model.py'] }
    }

    component ArchiValidate {
      // Cross-references code imports against model relationships
      metadata { path ['./plugins/dev-team/utils/archi-validate.py'] }
    }

    component ArchiDecide {
      // Creates, lists, and updates Architecture Decision Records
      metadata { path ['./plugins/dev-team/utils/archi-decide.py'] }
    }

    component HookOutput {
      // Unified output formatting for PreToolUse, SessionStart, UserPromptSubmit hooks
      metadata { path ['./plugins/dev-team/utils/hook_output.py'] }
    }
  }

  // ==========================================================================
  // TEMPLATES DOMAIN — components
  // ==========================================================================

  extend DevTeamPlugin.Templates {
    component StepReportTemplate {
      // JSON schema template for step report structure
      metadata { path ['./plugins/dev-team/templates/step-report.json'] }
    }

    component C4ModelTemplate {
      // DSL template for bootstrapping architecture models
      metadata { path ['./plugins/dev-team/templates/model.c4'] }
    }

    component AdrTemplate {
      // Markdown template for Architecture Decision Records
      metadata { path ['./plugins/dev-team/templates/adr.md'] }
    }
  }

  // ==========================================================================
  // RELATIONSHIPS — External
  // ==========================================================================

  ClaudeCode -> DevTeamPlugin "hosts and invokes hooks"
  DevTeamPlugin -> OpenSpecCLI "delegates workflow management to"

  // ==========================================================================
  // RELATIONSHIPS — Hook dependencies
  // ==========================================================================

  DevTeamPlugin.Hooks.TDDGate -> DevTeamPlugin.Utils.ActiveChange "imports find_active_change"
  DevTeamPlugin.Hooks.TDDGate -> DevTeamPlugin.Utils.HookOutput "imports output_pre_tool_use"

  DevTeamPlugin.Hooks.SkillGate -> DevTeamPlugin.Utils.ActiveChange "imports find_active_change"
  DevTeamPlugin.Hooks.SkillGate -> DevTeamPlugin.Utils.ReportChain "imports check_all_report_chains"
  DevTeamPlugin.Hooks.SkillGate -> DevTeamPlugin.Utils.HookOutput "imports output_pre_tool_use"

  DevTeamPlugin.Hooks.CommitGates.BeforeCommit -> DevTeamPlugin.Hooks.CommitGates.QualityGate "routes git commit events to"
  DevTeamPlugin.Hooks.CommitGates.BeforeCommit -> DevTeamPlugin.Hooks.CommitGates.ArchitectureGate "routes git commit events to"
  DevTeamPlugin.Hooks.CommitGates.BeforeCommit -> DevTeamPlugin.Utils.HookOutput "imports output_pre_tool_use"

  DevTeamPlugin.Hooks.CommitGates.QualityGate -> DevTeamPlugin.Utils.ActiveChange "imports find_active_change"
  DevTeamPlugin.Hooks.CommitGates.QualityGate -> DevTeamPlugin.Utils.ReportChain "imports check_report_chain"
  DevTeamPlugin.Hooks.CommitGates.QualityGate -> DevTeamPlugin.Utils.LintRunner "imports run_type_check, run_lint"
  DevTeamPlugin.Hooks.CommitGates.QualityGate -> DevTeamPlugin.Utils.TestRunner "imports run_tests"
  DevTeamPlugin.Hooks.CommitGates.QualityGate -> DevTeamPlugin.Utils.HookOutput "imports output_pre_tool_use"

  DevTeamPlugin.Hooks.CommitGates.ArchitectureGate -> DevTeamPlugin.Utils.HookOutput "imports output_pre_tool_use"
  DevTeamPlugin.Hooks.CommitGates.ArchitectureGate -> DevTeamPlugin.Utils.ArchiValidate "validates code changes via"

  // ==========================================================================
  // RELATIONSHIPS — Skill routing
  // ==========================================================================

  DevTeamPlugin.Skills.ExploreSkill -> OpenSpecCLI "invokes openspec explore"
  DevTeamPlugin.Skills.ProposeSkill -> OpenSpecCLI "invokes openspec propose"
  DevTeamPlugin.Skills.ApplyChangeSkill -> OpenSpecCLI "invokes openspec apply"
  DevTeamPlugin.Skills.ArchiveChangeSkill -> OpenSpecCLI "invokes openspec archive"
  DevTeamPlugin.Skills.CodeReviewSkill -> DevTeamPlugin.Agents.CodeReviewAgent "routes via Agent tool"
  DevTeamPlugin.Skills.UpdateArchitectureSkill -> DevTeamPlugin.Agents.ArchitectureAgent "routes via Agent tool"

  // ==========================================================================
  // RELATIONSHIPS — Agent -> Utility
  // ==========================================================================

  DevTeamPlugin.Agents.ArchitectureAgent -> DevTeamPlugin.Utils.ArchiModel "uses for model query, validate, write"
  DevTeamPlugin.Agents.ArchitectureAgent -> DevTeamPlugin.Utils.ArchiValidate "uses for cross-reference validation"
  DevTeamPlugin.Agents.ArchitectureAgent -> DevTeamPlugin.Utils.ArchiDecide "uses for ADR management"

}
