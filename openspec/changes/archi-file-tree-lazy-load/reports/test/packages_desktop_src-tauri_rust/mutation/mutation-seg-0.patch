+// 阻塞池 offload 判据（AC-2 / spec `desktop-app-shell`：MUST NOT 计时）
+// ---------------------------------------------------------------------------
+
+/// 命令 future 的**首次 poll** 必须为 `Pending`（= 命令体已投递阻塞池，未在 IPC 线程
+/// 内联执行）。判据只取单次 poll 的结果，零计时零阈值。
+fn assert_offloaded<F: std::future::Future>(future: F) {
+    use std::task::{Context, Poll, Waker};
+    let mut context = Context::from_waker(Waker::noop());
+    let mut future = std::pin::pin!(future);
+    match future.as_mut().poll(&mut context) {
+        Poll::Pending => {}
+        Poll::Ready(_) => {
+            panic!("首次 poll 必须为 Pending（命令体在 IPC 线程内联 ⇒ 窗口随取数冻结）")
+        }
+    }
+}
