+        .collect::<Vec<_>>();
+    assert_eq!(variants.len(), 5, "五变体声明，实际: {variants:?}");
+    assert_eq!(
+        *variants.last().expect("非空"),
+        "Interrupted,",
+        "Interrupted 声明在枚举闭合花括号前（末位追加）"
+    );
+}
