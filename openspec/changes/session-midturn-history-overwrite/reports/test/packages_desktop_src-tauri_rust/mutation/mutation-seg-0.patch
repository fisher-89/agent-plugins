+    let rest = &own[start..];
+    let body = &rest[..rest.find("\n}\n").expect("函数体闭合花括号在场")];
+
+    let interrupted_at = body
+        .find("AgentRunStatus::Interrupted =>")
+        .expect("Interrupted 臂在场");
