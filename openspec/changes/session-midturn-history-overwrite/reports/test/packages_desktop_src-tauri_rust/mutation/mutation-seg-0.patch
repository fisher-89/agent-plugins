+/// 定义面源码自证（边界）：derive 行仍派生 `specta::Type`（值域出线到生成物），
+/// 且 `Interrupted` 声明位于枚举闭合花括号前（末位判据的第二个观测面）。
+#[test]
+fn agent_run_status定义面派生specta且interrupted居末位() {
+    let own = std::fs::read_to_string(
