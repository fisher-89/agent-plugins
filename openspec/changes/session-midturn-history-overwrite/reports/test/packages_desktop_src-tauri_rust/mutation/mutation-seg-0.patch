+/// `worker_settle` 结构自证（边界）：`Interrupted` 臂体含 failed 两件套、紧邻
+/// `Stopped` 臂之后、函数体内零 `_ =>` 兜底臂。
+#[test]
+fn worker_settle结构自证_interrupted臂体与零兜底臂() {
+    let own = std::fs::read_to_string(
