+    );
+    for key in ["row", "stats", "turns"] {
+        assert!(value.get(key).is_some(), "出线键 {key} 恒在");
+    }
+    assert_eq!(
+        value["turns"][0]["status"],
+        serde_json::json!("interrupted")
+    );
+}
