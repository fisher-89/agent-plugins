+        started_at: 1_727_000_000_000,
+        finished_at: 1_727_000_005_000,
+        num_turns: None,
+        duration_ms: None,
+        cost_usd: None,
+        usage: serde_json::Value::Null,
+        error: None,
+        remote_session_id: None,
+    }
