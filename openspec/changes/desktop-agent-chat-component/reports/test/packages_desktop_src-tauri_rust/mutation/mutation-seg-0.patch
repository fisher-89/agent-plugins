+            source_ref: Some("chg-flow/implement/executor/1".to_owned()),
+        },
+        permission: AgentPermissionMode::BypassPermissions,
+        model_level: ModelLevel::High,
+        continue_session: None,
+        agent: None,
+        role: WorkerRole::Executor,
+    }
+}
