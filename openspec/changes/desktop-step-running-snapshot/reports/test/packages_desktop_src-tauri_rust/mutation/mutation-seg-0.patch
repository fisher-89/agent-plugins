+    let object = node_wire.as_object().expect("节点线面对象");
+    for key in ["startedAt", "endedAt", "tokenInput", "tokenOutput"] {
+        assert!(object.contains_key(key), "节点线面含 {key}（与活面 ChangeStepState 同形）");
