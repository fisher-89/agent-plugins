+    assert_eq!(
+        updated.relations,
+        RelationTally {
+            updated: 1,
+            ..Default::default()
+        },
+        "改值 ⇒ updated = 1"
+    );
+    assert_eq!(
+        updated.changed,
+        vec!["desc".to_owned()],
+        "changed ⊆ {{desc, apis}}"
+    );
+    fs::write(&updated.write.file, &updated.write.content).expect("落盘改值");
+
+    let deleted = plan_relation_delete(temp.root(), "A", "B", None).expect("删除关系");
+    assert!(deleted.warnings.is_empty(), "warnings 恒空");
+    assert_eq!(
+        deleted.relations,
+        RelationTally {
+            deleted: 1,
+            ..Default::default()
+        },
+        "删除 ⇒ deleted = 1"
+    );
