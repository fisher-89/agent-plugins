+            ("noPath", "warn"),
+            ("pathNotFound", "warn"),
+            ("docMissing", "warn"),
+            ("docNotFound", "error"),
+            ("apiUnexpected", "warn"),
+        ]
+        .into_iter()
+        .collect::<std::collections::BTreeSet<_>>(),
+        "五档组合逐值对齐（docNotFound 唯一 error）"
