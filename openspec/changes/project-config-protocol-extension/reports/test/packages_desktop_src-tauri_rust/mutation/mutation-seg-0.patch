+/// 带依赖声明的项目锚点（`depends_on` 逐字取自入参，保序）。
+fn proj_with(root: &str, depends_on: &[&str]) -> BootstrapProject {
+    BootstrapProject {
+        root: root.to_owned(),
+        depends_on: depends_on
+            .iter()
