+fn 聚合面entry不参与聚合键且零诊断() {
+    let temp = TempDir::new("entry-aggregation");
+    write_model(
+        temp.root(),
+        "02-with-entry.toml",
+        concat!(
+            "[element.\"App\"]\n",
+            "kind = \"package\"\n",
+            "\n",
