+fn element_entry与api四组合正交() {
+    let cases = [
+        ("declared", None),
+        ("declared", Some("src/a/lib.rs")),
+        ("none", None),
+        ("none", Some("src/a/main.rs")),
+    ];
+    for (api, entry) in cases {
+        let entry_line = entry
+            .map(|value| {
+                format!(
+                    "entry = \"{value}\"
+"
+                )
+            })
