+#[test]
+fn x_function_position_error文案面() {
+    let definition = serde_json::json!({
+        "type": "object",
+        "properties": {"m": {"x-function": {"params": [{"name": "xs", "schema": {"type": "array", "items": {"x-function": {}}}}]}}},
