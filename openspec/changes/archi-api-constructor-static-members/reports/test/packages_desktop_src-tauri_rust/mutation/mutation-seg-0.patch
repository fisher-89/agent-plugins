+/// `enum` / 纯 alias 两臂同断言。
+#[test]
+fn verify_class_key_positions非类条目四形态() {
+    let constructor = r#""x-constructor": {"x-function": {}}"#;
+    let statics = r#""x-static": {"open": {"x-function": {}}}"#;
