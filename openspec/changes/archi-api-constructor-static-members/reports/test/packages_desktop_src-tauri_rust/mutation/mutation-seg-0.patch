+/// 边界（`interface_block` 超大 body）：100 成员 ⇒ 逐行 2 空格缩进、interface 的 `}` 与值声明
+/// 之间零空行；零字段类 ⇒ `export interface T {}` 单行形态。
+#[test]
+fn render界面块百成员body() {
+    let mut properties = serde_json::Map::new();
+    for index in 0..100 {
