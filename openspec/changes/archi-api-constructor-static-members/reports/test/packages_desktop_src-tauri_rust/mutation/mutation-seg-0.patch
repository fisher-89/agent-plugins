+        ),
+        (
+            "标量",
+            format!(r#"{{"Plain": {{"type": "string", {constructor}}}}}"#),
+        ),
+        (
+            "纯 $ref alias",
+            format!(
+                r##"{{"Other": {{"type": "object"}}, "Plain": {{"$ref": "#/$defs/Other", {constructor}}}}}"##
+            ),
+        ),
+    ];
+    for (label, defs) in cases {
