+/// 边界（AC-3）：`path` 无前导 `./`、无尾 `/`、不产空 `path` 根条目；`name` 为
+/// 末段（单段时等于 `path`）。
+#[test]
+fn 路径形态与末段名派生() {
+    let temp = TempDir::new("path-shape");
+    temp.write_model(&[
+        ("App", "package", &[]),
+        ("App.Core", "domain", &[]),
+        ("App.Core.Archi", "module", &["./crates/core/archi/"]),
