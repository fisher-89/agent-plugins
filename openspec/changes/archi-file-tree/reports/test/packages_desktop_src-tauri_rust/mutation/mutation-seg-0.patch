+/// 枚举线值清单（`serde_json` 单值序列化；字面量镜像即尺寸判据）。
+fn line_words<T: serde::Serialize + Copy>(values: Vec<T>) -> Vec<String> {
+    values
+        .into_iter()
+        .map(|value| {
+            serde_json::to_value(value)
+                .expect("序列化")
+                .as_str()
+                .expect("线值为字符串")
+                .to_owned()
+        })
+        .collect()
+}
