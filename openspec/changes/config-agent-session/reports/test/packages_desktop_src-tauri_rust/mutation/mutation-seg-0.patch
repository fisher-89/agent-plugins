+        "盘面自该 root 读取"
+    );
+    let text = minted
+        .execute(&serde_json::json!({}))
+        .expect("只读模式应成功");
+    let payload: serde_json::Value = serde_json::from_str(&text).expect("输出为 JSON");
+    assert_eq!(payload["current"]["context"], serde_json::json!("铸造根"));
+}
