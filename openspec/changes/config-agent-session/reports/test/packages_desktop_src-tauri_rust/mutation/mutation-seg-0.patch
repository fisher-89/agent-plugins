diff --git a/crates/infra/agent/src/sdk/config_propose.rs b/crates/infra/agent/src/sdk/config_propose.rs
new file mode 100644
index 000000000000..bac2ef95269f
--- /dev/null
+++ b/crates/infra/agent/src/sdk/config_propose.rs
@@ -0,0 +1,212 @@
+//! `propose_config` 工具：config 会话**唯一**的提案出口。
+//!
+//! 两模式（参数面 `{ candidate?: object }`，`required: []`）：
+//! - 不给候选 = **只读模式**：返回当前盘面的 file face 投影（`candidate` 为 `null`、
+//!   `changes` 为空）；
+//! - 给候选 = **校验模式**：候选是整份文件面；`config::validate` 存在任一
+//!   `InvalidValue` 即 `Err`（逐条 `path: message` + 修正后重交完整候选），零违例
+//!   才把归一化候选与字段级差异一并返回。
+//!
+//! 三条不变量：输出恒为**单条** JSON 字符串（`ToolResult.content` 是扁平字符串），
+//! `current` / `candidate` **一律 file face**（MUST NOT 用 wire face）；一次调用
+//! **零副作用**（不写文件、不写库、不改会话状态——候选只活在会话转录里）；**无路径
+//! 参数**（盘面由服务端按仓根解析，工具在 `tools::input_path` 的无路径白名单内）。
+
+use std::collections::BTreeSet;
+use std::path::PathBuf;
+
+use config::{ConfigDiagnostic, DiagnosticKind};
+use rig::completion::ToolDefinition;
+use serde_json::Value;
+
+use crate::sdk::tools;
+
+/// `propose_config` 工具名（挂载清单 / 装配臂 / 沙箱白名单 / 执行上下文铸造四处
+/// 引用同一常量）。
+pub(crate) const PROPOSE_CONFIG_TOOL: &str = "propose_config";
+
+/// 工具定义（挂载清单第 14 项的定义来源）：名字与描述同源一处，避免「名字在挂载、
+/// 描述在执行体」两处分叉。
+pub(crate) fn definition() -> ToolDefinition {
+    ToolDefinition {
+        name: PROPOSE_CONFIG_TOOL.to_owned(),
+        description: concat!(
+            "提交工作区配置 proposal（两模式）。不给 candidate = 只读模式：返回当前盘面",
+            "（file face，candidate 为 null、changes 为空），先看盘再动手。给 candidate = 校验",
+            "模式：候选必须是**整份文件面**（一次全量，不接受片段；多词键用 snake_case：",
+            "static_analysis / write_protection / depends_on；未知顶层键直接写在顶层，不要包",
+            "进 extra）。校验有任一违例即返回错误，文案逐条列 path: message——按诊断修正后",
+            "**重交完整候选**。通过则返回归一化的 candidate 与字段级 changes（含 summary）。",
+            "无路径参数：盘面由服务端按仓根解析；本工具零副作用，不写文件、不写库，落盘只在",
+            "用户点「应用」后由应用进程完成"
+        )
+        .to_owned(),
+        parameters: serde_json::json!({
+            "type": "object",
+            "properties": {
+                "candidate": {
+                    "type": "object",
+                    "description": "整份文件面候选（snake_case：static_analysis / write_protection / depends_on；省略即只读模式）"
+                }
+            },
+            "required": []
+        }),
+    }
+}
+
+/// `propose_config` 执行上下文（per-turn 铸造：`root` = 主仓 root，配置权威所在）。
+pub(crate) struct ConfigContext {
+    root: PathBuf,
+}
+
+impl ConfigContext {
+    /// 上下文构造（泵起播按名字清单含 `propose_config` 铸造）。
+    pub(crate) fn new(root: PathBuf) -> Self {
+        Self { root }
+    }
+
+    /// 两模式执行体：输出单条 file-face JSON 字符串（过 L1 收口），零副作用。
+    pub(crate) fn execute(&self, input: &Value) -> Result<String, String> {
+        let (current, diagnostics) = config::load_file_face(&self.root)?;
+        let (candidate, changes, summary) = match candidate_of(input) {
+            None => (Value::Null, Vec::new(), read_only_summary(&diagnostics)),
+            Some(candidate) => {
+                let report = config::validate(candidate);
+                let violations: Vec<&ConfigDiagnostic> = report
+                    .diagnostics
+                    .iter()
+                    .filter(|diagnostic| matches!(diagnostic.kind, DiagnosticKind::InvalidValue))
+                    .collect();
+                if !violations.is_empty() {
+                    let mut message = violations
+                        .iter()
+                        .map(|diagnostic| format!("{}: {}", diagnostic.path, diagnostic.message))
+                        .collect::<Vec<String>>()
+                        .join("\n");
+                    message
+                        .push_str("\n请按上述诊断修正后重新提交完整候选（一次全量，不接受片段）。");
+                    return Err(message);
+                }
+                let normalized = config::to_file_value(&report.config, candidate)?;
+                let changes = diff(&current, &normalized);
+                let summary = if changes.is_empty() {
+                    "候选合法，与当前配置一致".to_owned()
+                } else {
+                    format!("候选合法，共 {} 处变更", changes.len())
+                };
+                (normalized, changes, summary)
+            }
+        };
+        let payload = serde_json::json!({
+            "current": current,
+            "candidate": candidate,
+            "changes": changes,
+            "summary": summary,
+        });
+        let text = serde_json::to_string(&payload)
+            .map_err(|error| format!("proposal 结果序列化失败: {error}"))?;
+        Ok(tools::cap_result(text))
+    }
+}
+
+/// 候选提取：缺键 / 显式 `null` 即只读模式（`None`）。
+fn candidate_of(input: &Value) -> Option<&Value> {
+    input
+        .get("candidate")
+        .filter(|candidate| !candidate.is_null())
+}
+
+/// 只读模式摘要：诊断条数 + 前若干 `path`（诊断折进 `summary`，不新增第五键）。
+fn read_only_summary(diagnostics: &[ConfigDiagnostic]) -> String {
+    const MAX_PATHS: usize = 5;
+    if diagnostics.is_empty() {
+        return "只读模式：返回当前盘面（无诊断）".to_owned();
+    }
+    let paths = diagnostics
+        .iter()
+        .take(MAX_PATHS)
+        .map(|diagnostic| diagnostic.path.as_str())
+        .collect::<Vec<&str>>()
+        .join("、");
+    let ellipsis = if diagnostics.len() > MAX_PATHS {
+        "、…"
+    } else {
+        ""
+    };
+    format!(
+        "只读模式：返回当前盘面（诊断 {} 条：{paths}{ellipsis}）",
+        diagnostics.len()
+    )
+}
+
+/// 单条字段级差异（`path` 为 file-face 键路径）。
+#[derive(Debug, serde::Serialize)]
+struct Change {
+    /// 点分键路径（顶层即键名）
+    path: String,
+    /// `added` / `removed` / `changed`（封闭三值）
+    kind: &'static str,
+    /// 变更前值（新增即 `null`）
+    before: Option<Value>,
+    /// 变更后值（删除即 `null`）
+    after: Option<Value>,
+}
+
+/// 字段级差异：**对象递归**（键并集、字母序）、**数组与标量作叶子**（整体替换）。
+/// 数组逐下标会把「插一条 suite」后面的全部项标成 changed——噪声灌满卡片，且
+/// `changes == []` 的「与盘面一致」判据随之失效。
+fn diff(current: &Value, candidate: &Value) -> Vec<Change> {
+    let mut changes = Vec::new();
+    diff_into("", current, candidate, &mut changes);
+    changes
+}
+
+/// 递归差异（`prefix` 为空表示顶层）。
+fn diff_into(prefix: &str, current: &Value, candidate: &Value, changes: &mut Vec<Change>) {
+    match (current, candidate) {
+        (Value::Object(left), Value::Object(right)) => {
+            let keys = left
+                .keys()
+                .chain(right.keys())
+                .collect::<BTreeSet<&String>>();
+            for key in keys {
+                let path = join_path(prefix, key);
+                match (left.get(key), right.get(key)) {
+                    (Some(before), Some(after)) => diff_into(&path, before, after, changes),
+                    (Some(before), None) => changes.push(Change {
+                        path,
+                        kind: "removed",
+                        before: Some(before.clone()),
+                        after: None,
+                    }),
+                    (None, Some(after)) => changes.push(Change {
+                        path,
+                        kind: "added",
+                        before: None,
+                        after: Some(after.clone()),
+                    }),
+                    (None, None) => {}
+                }
+            }
+        }
+        _ => {
+            if current != candidate {
+                changes.push(Change {
+                    path: prefix.to_owned(),
+                    kind: "changed",
+                    before: Some(current.clone()),
+                    after: Some(candidate.clone()),
+                });
+            }
+        }
+    }
+}
+
+/// 键路径拼接（顶层无前缀）。
+fn join_path(prefix: &str, key: &str) -> String {
+    if prefix.is_empty() {
+        key.to_owned()
+    } else {
+        format!("{prefix}.{key}")
+    }
+}
diff --git a/crates/infra/agent/src/sdk/config_propose_test.rs b/crates/infra/agent/src/sdk/config_propose_test.rs
new file mode 100644
index 000000000000..b6cd4aed063e
--- /dev/null
+++ b/crates/infra/agent/src/sdk/config_propose_test.rs
@@ -0,0 +1,775 @@
+//! `propose_config` 工具的单元测试：工具定义契约矩阵（名字 / 参数面 / 描述三面）、
+//! `ConfigContext` 两模式执行体（只读盘面 / 校验回环）、字段级 `changes` 形态与
+//! 零副作用双证。
+//!
+//! 零 mock（沿 test-design「Mock策略」表）：盘面读取走真实 `config::load_file_face`
+//! （唯一读入口）、校验与归一化走真实 `config::validate` / `config::to_file_value`、
+//! 输出收口走真实 `tools::cap_result`——替身会让「wire face 出线」「第二份上限实现」
+//! 这类回潮不被发现。文件系统即真实 tempdir（RAII 清理）。
+
+use std::fs;
+use std::path::{Path, PathBuf};
+
+use config::DiagnosticKind;
+use serde_json::{json, Value};
+
+use crate::sdk::config_propose::{definition, ConfigContext, PROPOSE_CONFIG_TOOL};
+use crate::sdk::mount;
+use crate::sdk::tools::MAX_RESULT_BYTES;
+
+/// 临时 workspace 根（RAII 清理）。
+struct TempRoot(tempfile::TempDir);
+
+impl TempRoot {
+    fn new(tag: &str) -> Self {
+        let dir = tempfile::Builder::new()
+            .prefix(&format!("config-propose-{tag}-"))
+            .tempdir()
+            .expect("创建临时目录失败");
+        Self(dir)
+    }
+
+    fn path(&self) -> &Path {
+        self.0.path()
+    }
+
+    /// 落一份盘面配置（自动建域目录）。
+    fn write_config(&self, content: &str) {
+        let path = foundation::layout::config_path(self.path());
+        fs::create_dir_all(path.parent().expect("配置路径应有父目录")).expect("建域目录失败");
+        fs::write(path, content).expect("写配置文件失败");
+    }
+
+    fn config_path(&self) -> PathBuf {
+        foundation::layout::config_path(self.path())
+    }
+}
+
+/// 上下文（`root` 为该临时根）。
+fn context_of(root: &TempRoot) -> ConfigContext {
+    ConfigContext::new(root.path().to_path_buf())
+}
+
+/// 执行并解析输出（输出恒单条 JSON 字符串）。
+fn execute_json(context: &ConfigContext, input: &Value) -> Result<Value, String> {
+    let text = context.execute(input)?;
+    serde_json::from_str(&text).map_err(|error| format!("输出不是合法 JSON（{error}）：{text}"))
+}
+
+/// 满配盘面（八键全字段 + 多 suite + 多项目 + 多写保护规则）。
+fn full_config_text() -> String {
+    serde_json::to_string_pretty(&json!({
+        "$schema": "https://example.com/spec-driven.schema.json",
+        "schema": "spec-driven",
+        "context": "桌面端插件仓库",
+        "static_analysis": "clippy",
+        "projects": [
+            {"root": "packages/desktop", "language": "typescript", "depends_on": ["packages/shared"]},
+            {"root": "packages/desktop/src-tauri", "language": "rust", "depends_on": ["packages/desktop"]},
+        ],
+        "rules": {"proposal": ["提案规则一"], "tasks": ["任务规则一"]},
+        "tests": [
+            {
+                "root": "packages/desktop",
+                "framework": "vite-plus",
+                "cwd": "packages/desktop",
+                "config": "vite-plus.config.ts",
+                "includes": ["src/**/*.test.tsx"],
+                "excludes": ["dist/**"],
+                "coverage": {"lines": 90, "branches": 88, "functions": 85},
+                "mutation": {"cwd": "packages/desktop", "score": 75},
+            },
+            {
+                "root": "src-tauri",
+                "framework": "rust",
+                "cwd": "src-tauri",
+                "coverage": {"lines": 80, "branches": 70, "functions": 75},
+                "mutation": {"score": 70},
+            },
+        ],
+        "write_protection": {
+            "files": [
+                {"glob": "tests/golden/**", "reason": "金样冻结"},
+                {"glob": "Cargo.lock"},
+            ],
+        },
+    }))
+    .expect("满配盘面序列化失败")
+}
+
+/// 盘面文件字节 + mtime（零副作用双证的两个观测面）。
+fn file_fingerprint(path: &Path) -> (Option<Vec<u8>>, Option<std::time::SystemTime>) {
+    match fs::metadata(path) {
+        Ok(metadata) => (
+            Some(fs::read(path).expect("读配置文件失败")),
+            metadata.modified().ok(),
+        ),
+        Err(_) => (None, None),
+    }
+}
+
+/// 目录条目数（无临时文件残留的观测面）。
+fn dir_entries(path: &Path) -> usize {
+    fs::read_dir(path)
+        .map(|entries| entries.count())
+        .unwrap_or(0)
+}
+
+// ---------------------------------------------------------------------------
+// 工具定义契约（名字常量 / 参数面 / 描述三面）
+// ---------------------------------------------------------------------------
+
+/// 正向：常量值、定义名与挂载清单三面同源（定义单源在 `config_propose`）。
+#[test]
+fn 常量三面同源_定义名与挂载命中逐字相同() {
+    assert_eq!(PROPOSE_CONFIG_TOOL, "propose_config");
+    assert_eq!(
+        definition().name,
+        PROPOSE_CONFIG_TOOL,
+        "定义名与常量逐字相同"
+    );
+    let mounted = mount::lookup(PROPOSE_CONFIG_TOOL).expect("挂载清单应命中该名");
+    assert_eq!(mounted.name, PROPOSE_CONFIG_TOOL);
+    assert_eq!(
+        mounted.parameters,
+        definition().parameters,
+        "挂载定义与执行体模块定义同源（零分叉）"
+    );
+}
+
+/// 边界：常量在挂载清单末项（第 14 项）出现恰一次（无重复登记）。
+#[test]
+fn 常量在挂载清单末项恰一处() {
+    let names: Vec<&str> = mount::registry()
+        .iter()
+        .map(|mount| mount.definition.name.as_str())
+        .collect();
+    assert_eq!(names.len(), 14, "挂载清单十四项");
+    assert_eq!(
+        names.last().copied(),
+        Some(PROPOSE_CONFIG_TOOL),
+        "末项为提案工具"
+    );
+    assert_eq!(
+        names
+            .iter()
+            .filter(|name| **name == PROPOSE_CONFIG_TOOL)
+            .count(),
+        1,
+        "名字清单无重复登记"
+    );
+}
+
+/// 正向：参数面 `{ candidate?: object }` + `required: []`，顶层无路径属性。
+#[test]
+fn 定义参数面_candidate可选对象且无路径属性() {
+    let parameters = definition().parameters;
+    assert_eq!(parameters["type"], json!("object"), "顶层类型为对象");
+    let properties = parameters["properties"]
+        .as_object()
+        .expect("properties 恒为对象");
+    assert_eq!(properties.len(), 1, "参数面只有 candidate 一项");
+    assert_eq!(properties["candidate"]["type"], json!("object"));
+    assert_eq!(
+        parameters["required"],
+        json!([]),
+        "required 为空（候选可省 = 只读模式）"
+    );
+    for absent in ["path", "root", "file", "workspace"] {
+        assert!(
+            properties.get(absent).is_none(),
+            "参数面不得出现路径属性 {absent}"
+        );
+    }
+}
+
+/// 正向：描述含两模式语义与「修正后重交完整候选」指引。
+#[test]
+fn 描述含两模式与重交完整候选指引() {
+    let description = definition().description;
+    for anchor in [
+        "只读模式",
+        "校验模式",
+        "整份文件面",
+        "重交完整候选",
+        "changes",
+    ] {
+        assert!(description.contains(anchor), "描述缺语义锚 {anchor}");
+    }
+}
+
+/// 边界：描述点明「无路径参数」与三处 snake_case 键形（防模型自造 `path` / camelCase）。
+#[test]
+fn 描述点明无路径参数与三处snake_case键形() {
+    let description = definition().description;
+    assert!(description.contains("无路径参数"), "描述须点明无路径参数");
+    for key in ["static_analysis", "write_protection", "depends_on"] {
+        assert!(
+            description.contains(key),
+            "描述缺点名的 snake_case 键 {key}"
+        );
+    }
+}
