+            Err(err) => Err(vec![ConfigDiagnostic {
+                kind: DiagnosticKind::JsonInvalid,
+                path: "$".to_owned(),
+                message: format!("工作区配置文件不是合法 JSON（{err}），呈现全部默认值。"),
+            }]),
+            Ok(Value::Object(map)) => Ok(map),
+            Ok(other) => Err(vec![invalid(
