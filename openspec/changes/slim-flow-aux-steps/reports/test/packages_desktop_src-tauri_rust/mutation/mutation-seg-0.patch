+/// 重入行的形态驱动面（同形态连调两次——形态决定落账前缀）。
+fn reenter_probe(tag: &str) -> SettleProbe {
+    match tag {
+        "fail" => SettleProbe::Fail {
+            item: "静态检查",
+            report: "升格".to_owned(),
+            evidence: "诊断".to_owned(),
+            executor_session: None,
+        },
+        "skipped" => SettleProbe::Skipped {
+            reason: "跳过因"
+        },
+        _ => SettleProbe::Pass {
+            evaluator_turn: None,
+            test_outcome: None,
+            mutation_outcome: None,
+            executor_session: None,
+        },
+    }
+}
