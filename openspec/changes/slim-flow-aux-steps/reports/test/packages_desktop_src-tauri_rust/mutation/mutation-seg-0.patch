+    let control = Arc::new(ChangeFlowControl::new());
+    let (task, _rx, history) = spawn_run(worker, steps, snapshot, &control, true, &root.root_str());
+
+    // evaluator 会话挂起 = 相位运行中窗口（开相已写、落账未发生）
