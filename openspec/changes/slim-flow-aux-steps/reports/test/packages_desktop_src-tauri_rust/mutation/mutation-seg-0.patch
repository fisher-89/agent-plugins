+        assert!(
+            reason.contains("implement"),
+            "{node:?} 记因携相位串: {reason}"
+        );
+        assert!(
+            reason.contains(node.as_str()),
+            "{node:?} 记因携步词 {}: {reason}",
+            node.as_str()
+        );
+        assert!(
+            finish.nodes.is_empty(),
+            "{node:?} 不可达臂零节点（未进入步体）: {:?}",
+            node_rows(&finish)
+        );
+    }
+}
