+/// struct 内某字段的整行（含缩进；缺席即断言失败）。
+fn field_line<'a>(text: &'a str, field: &str) -> &'a str {
+    text.lines()
+        .find(|line| line.trim_start().starts_with(&format!("pub {field}:")))
+        .unwrap_or_else(|| panic!("struct 内应有字段 `{field}`：\n{text}"))
+}
