+/// `api-op` 单操作源文（`params` / `returns` 原文直传）。
+fn op_source(params: &str, returns: &str) -> String {
+    format!(
+        "# {FQN}\n\n### load\n\n```json api-op\n{{\"params\": {params}, \"returns\": {returns}}}\n```\n"
+    )
+}
