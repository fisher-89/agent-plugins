+/// 单字段 `api-types` 源文（`$defs.Holder.properties.f` 取给定片段）。
+fn holder_types(fragment: &str, required: bool) -> String {
+    let required = if required {
+        ", \"required\": [\"f\"]"
+    } else {
+        ""
+    };
+    format!(r#"{{"Holder": {{"type": "object", "properties": {{"f": {fragment}}}{required}}}}}"#)
+}
