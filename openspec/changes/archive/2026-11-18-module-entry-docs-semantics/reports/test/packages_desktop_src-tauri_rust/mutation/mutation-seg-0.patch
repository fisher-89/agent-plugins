+    let mut removed = 0;
+    for entry in reader.flatten() {
+        let path = entry.path();
+        if path.is_dir() {
+            removed += remove_contract_md(&path);
+            continue;
+        }
+        if path.extension().and_then(|ext| ext.to_str()) == Some("md")
+            && fs::remove_file(&path).is_ok()
+        {
+            removed += 1;
+        }
+    }
+    removed
