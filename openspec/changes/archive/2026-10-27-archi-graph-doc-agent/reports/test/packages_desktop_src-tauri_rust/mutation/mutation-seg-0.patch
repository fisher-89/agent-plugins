+
+/// 边界：同文件双源合并取强——`README.md` 既在 `docs` 又在 `path` 目录内 →
+/// 恰一条且 `source = explicit`。
+#[test]
+fn 同文件双源合并取最强来源() {
+    let temp = TempDir::new("merge-sources");
