+    let outcome = parse_dir(temp.root());
+    assert_eq!(outcome.diagnostics.len(), 1, "恰一条读取失败诊断");
+    let diagnostic = &outcome.diagnostics[0];
+    assert_eq!(diagnostic.kind, DiagnosticKind::SyntaxError);
