+    );
+    assert_eq!(
+        diagnostic.file, "openspec/architecture/models/02-auth.toml",
+        "file 回填到失败文件"
+    );
+    assert_eq!(diagnostic.line, 0, "读取失败无位置（line 0）");
+    assert!(diagnostic.column.is_none(), "读取失败无列");
+    assert_eq!(
