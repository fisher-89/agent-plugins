+//! 架构模型纯读域：解析 / 内存图 / 结构诊断 / 文档关联 / 检索 / 结构 diff /
+//! `gate` 写回纯函数 / 三面共用投影。
+//!
+//! 四个消费面同源（进程内结构校验、agent 工具 `archi_*`、IPC 命令面、画布），
+//! 三条机械纪律：
+//! 1. **单点构建**：`ModelGraph` 只在 [`graph`] 建一次（外部只经 [`dto`] 的
+//!    投影入口消费），消费面 MUST NOT 各自再建图；
+//! 2. **投影零改写**：投影只裁剪（1-hop / 字段子集），MUST NOT 重算、MUST NOT
+//!    推导、MUST NOT 补默认值；
+//! 3. **词汇全量对拍**：封闭词汇（元素种类 / gate 档 / 结构诊断 / 文档警告 / 边
+//!    标记 / 节点标记）只有一份定义（[`dto`]），三面覆盖同一词汇集。
+//!
+//! 边界：零 UI 框架 / 零库句柄 / 零子进程 / 零工作流与编排 crate 依赖 / 零工作区
+//! 配置读取（工作区配置唯一出口纪律零变化）；本 crate 只读盘不写盘（唯一写动作
+//! 在命令层）。
+
+pub mod diff;
+pub mod docs;
+pub mod dto;
+pub mod edit;
+pub mod graph;
+pub mod model;
+pub mod parse;
+pub mod search;
+
+pub use dto::{
+    ArchiChangeSummary, ArchiGraph, ArchiModuleDetail, ArchiSearchResult, DiagnosticKind, DocKind,
+    DocRef, DocSource, EdgeMark, ElementKind, GateTier, NodeMark, SearchScope, WarningKind,
+};
+pub use model::{Diagnostic, Element, Model, Relation};
+
+#[cfg(test)]
+mod diff_test;
+#[cfg(test)]
+mod docs_test;
+#[cfg(test)]
+mod dto_test;
+#[cfg(test)]
+mod edit_test;
+#[cfg(test)]
+mod graph_test;
+#[cfg(test)]
+mod model_test;
+#[cfg(test)]
+mod search_test;
diff --git a/crates/core/archi/src/model.rs b/crates/core/archi/src/model.rs
new file mode 100644
index 000000000000..f0db0440448e
--- /dev/null
+++ b/crates/core/archi/src/model.rs
@@ -0,0 +1,116 @@
+//! 格式无关 AST：模型 / 元素 / 关系 / 源区间 / 诊断 / 解析产物。
+//!
+//! 词汇（`ElementKind` / `GateTier` / `DiagnosticKind`）单点在 [`crate::dto`]，
+//! 本模块反向引用——不存在第二份枚举定义。`derive PartialEq`（UI diff 预留）；
+//! 关系级源区间为可选占位（当前只消费行号）。
+
+use std::collections::BTreeMap;
+
+use crate::dto::{DiagnosticKind, ElementKind, GateTier};
+
+/// 聚合后的完整模型（多文件合并，声明序保留）。
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Model {
+    /// 元素（文件序 + 声明序）
+    pub elements: Vec<Element>,
+    /// 关系（文件序 + 声明序）
+    pub relations: Vec<Relation>,
+}
+
+impl Model {
+    /// 空模型（模型目录缺席 / 空目录的合法起点）。
+    pub fn empty() -> Self {
+        Self {
+            elements: Vec::new(),
+            relations: Vec::new(),
+        }
+    }
+
+    /// 按 FQN 取元素引用（线性扫描——模型规模按元素数百计；投影、`gate` 写回
+    /// 定位与检索薄条目共用，禁第二份查找实现）。
+    pub fn element(&self, fqn: &str) -> Option<&Element> {
+        self.elements.iter().find(|element| element.fqn == fqn)
+    }
+}
+
+/// 单个架构元素。
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Element {
+    /// 完整限定名（层级由 FQN 最长前缀推导）
+    pub fqn: String,
+    /// 元素种类
+    pub kind: ElementKind,
+    /// gate 档位（缺省 `off`）
+    pub gate: GateTier,
+    /// 覆盖路径（原文，不归一）
+    pub path: Vec<String>,
+    /// 显式文档路径（原文，不归一）
+    pub docs: Vec<String>,
+    /// 一行摘要
+    pub summary: Option<String>,
+    /// 自由元数据表（字符串 → 字符串，未知键忽略）
+    pub metadata: BTreeMap<String, String>,
+    /// 声明所在文件（repo 相对、`/` 分隔；由聚合层回填）
+    pub file: String,
+    /// 声明所在行（1 起始；0 = 位置未知）
+    pub line: u32,
+}
+
+/// 单条关系（`from -> to`）。
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Relation {
+    /// 起点元素 FQN
+    pub from: String,
+    /// 终点元素 FQN
+    pub to: String,
+    /// 关系说明
+    pub description: Option<String>,
+    /// 声明所在文件（repo 相对、`/` 分隔）
+    pub file: String,
+    /// 声明所在行（`from` 键行，1 起始；0 = 位置未知）
+    pub line: u32,
+    /// 声明源区间（占位：当前只消费行号，不消费列区间）
+    pub span: Option<SourceSpan>,
+}
+
+/// 源文本字节区间（进程内，不进线面、无 serde）。
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct SourceSpan {
+    /// 起始字节偏移
+    pub start: usize,
+    /// 结束字节偏移
+    pub end: usize,
+}
+
+impl From<std::ops::Range<usize>> for SourceSpan {
+    fn from(range: std::ops::Range<usize>) -> Self {
+        Self {
+            start: range.start,
+            end: range.end,
+        }
+    }
+}
+
+/// 结构化诊断（`line == 0` 表示位置未知——serde 自定义错误无 span 时的表达）。
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct Diagnostic {
+    /// 诊断种类（封闭九值）
+    pub kind: DiagnosticKind,
+    /// 原文文案（parser 面零加工，含行 / 列 / 片段 / caret）
+    pub message: String,
+    /// 所在文件（repo 相对、`/` 分隔）
+    pub file: String,
+    /// 所在行（1 起始；0 = 位置未知）
+    pub line: u32,
+    /// 所在列（1 起始，按 char 计；未知即 `None`）
+    pub column: Option<u32>,
+}
+
+/// 解析产物：模型 + 诊断（单次加载单次诊断，不做首个错误短路）。
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ParseOutcome {
+    /// 聚合模型（有诊断时可能只含可解析部分）
+    pub model: Model,
+    /// 诊断清单（空即健康）
+    pub diagnostics: Vec<Diagnostic>,
+}
diff --git a/crates/core/archi/src/model_test.rs b/crates/core/archi/src/model_test.rs
new file mode 100644
index 000000000000..d1d4c0dd31cc
--- /dev/null
+++ b/crates/core/archi/src/model_test.rs
@@ -0,0 +1,236 @@
+//! `model` 的单元测试：`Model::element` 按 FQN 取元素的全字段契约、精确匹配
+//! （前缀 / 大小写 / 特殊字符一律不命中）与派生 `PartialEq` / `Eq` 语义。
+//!
+//! 零 mock：纯数据结构字面量直构，无 IO / 无 async / 无环境依赖。
+
+use std::collections::BTreeMap;
+
+use crate::dto::{ElementKind, GateTier};
+use crate::model::{Element, Model, Relation, SourceSpan};
+
+/// 元素构造器：缺省 `package` / `off` / 空 path / 空 docs / 无摘要 / 空 metadata。
+fn element(fqn: &str) -> Element {
+    Element {
+        fqn: fqn.to_owned(),
+        kind: ElementKind::Module,
+        gate: GateTier::Off,
+        path: Vec::new(),
+        docs: Vec::new(),
+        summary: None,
+        metadata: BTreeMap::new(),
+        file: "openspec/architecture/models/01-core.toml".to_owned(),
+        line: 1,
+    }
+}
+
+/// 三元素模型（`App` / `App.Auth` / `App.Auth.Token`），中间元素带全字段。
+fn three_elements() -> Model {
+    let mut auth = element("App.Auth");
+    auth.kind = ElementKind::Domain;
+    auth.gate = GateTier::Strict;
+    auth.path = vec!["./src/auth/".to_owned(), "./src/token/".to_owned()];
+    auth.docs = vec!["./src/auth/README.md".to_owned()];
+    auth.summary = Some("认证域".to_owned());
+    auth.metadata = BTreeMap::from([
+        ("owner".to_owned(), "core".to_owned()),
+        ("tier".to_owned(), "1".to_owned()),
+    ]);
+    auth.line = 7;
+    Model {
+        elements: vec![element("App"), auth, element("App.Auth.Token")],
+        relations: Vec::new(),
+    }
+}
+
+// ---------------------------------------------------------------------------
+// 正向：全字段相等 + 命中与声明序无关
+// ---------------------------------------------------------------------------
+
+/// 正向：三元素模型查 `App.Auth` → `Some`，九个字段逐字段等于构造值。
+#[test]
+fn element按fqn取元素且九字段逐项相等() {
+    let model = three_elements();
+    let found = model.element("App.Auth").expect("App.Auth 应命中");
+    assert_eq!(found.fqn, "App.Auth");
+    assert_eq!(found.kind, ElementKind::Domain);
+    assert_eq!(found.gate, GateTier::Strict);
+    assert_eq!(
+        found.path,
+        vec!["./src/auth/".to_owned(), "./src/token/".to_owned()],
+        "path 逐项保留（不归一、不折叠）"
+    );
+    assert_eq!(found.docs, vec!["./src/auth/README.md".to_owned()]);
+    assert_eq!(found.summary.as_deref(), Some("认证域"));
+    assert_eq!(found.metadata.len(), 2, "metadata 多键逐项保留");
+    assert_eq!(
+        found.metadata.get("owner").map(String::as_str),
+        Some("core")
+    );
+    assert_eq!(
+        found.file, "openspec/architecture/models/01-core.toml",
+        "声明文件逐字"
+    );
+    assert_eq!(found.line, 7, "声明行逐字");
+}
+
+/// 正向：命中与声明序无关——首个 / 中间 / 末个元素均命中。
+#[test]
+fn element命中与声明序无关_首中末三位置() {
+    let model = three_elements();
+    for (index, fqn) in ["App", "App.Auth", "App.Auth.Token"]
+        .into_iter()
+        .enumerate()
+    {
+        let found = model
+            .element(fqn)
+            .unwrap_or_else(|| panic!("第 {index} 位置的 {fqn} 应命中"));
+        assert_eq!(found.fqn, fqn, "命中的元素 FQN 逐字");
+    }
+}
+
+// ---------------------------------------------------------------------------
+// 异常 / 边界：精确匹配面
+// ---------------------------------------------------------------------------
+
+/// 异常：空模型任意 FQN → `None`，不 panic。
+#[test]
+fn element空模型任意fqn返回none() {
+    let model = Model::empty();
+    assert!(model.elements.is_empty());
+    for fqn in ["", "App", "App.Auth"] {
+        assert!(
+            model.element(fqn).is_none(),
+            "空模型不应命中 {fqn:?}（不 panic）"
+        );
+    }
+}
+
+/// 边界：FQN 精确匹配——空串 / 前缀 / 超长路径 / 大小写不同均 `None`。
+#[test]
+fn element仅精确匹配_前缀与超长与大小写均不命中() {
+    let model = three_elements();
+    // 注：「App」在 fixture 中本身就是元素（顶层），故前缀样本取「App.Aut」——
+    // 精确匹配语义以「非完整 FQN 不命中」为判据
+    let misses = [
+        "",
+        "App.Aut",
+        "App.Auth.",
+        "App.Auth.Token.Extra",
+        "app.auth",
+        "App.Auth ",
+        " App.Auth",
+    ];
+    for fqn in misses {
+        assert!(
+            model.element(fqn).is_none(),
+            "{fqn:?} 不应命中（精确匹配，不做前缀 / 大小写 / 空白归一）"
+        );
+    }
+    // 对照臂：精确串仍命中
+    assert!(model.element("App.Auth").is_some(), "精确串仍命中");
+}
+
+/// 边界：`str` 特殊形态——超长（>1000 chars） / 含 `\n` / 含 `\0` / emoji → `None`
+/// 且不 panic。
+#[test]
+fn element特殊字符fqn均不命中且不panic() {
+    let model = three_elements();
+    let long = "A".repeat(1200);
+    let exotic = [
+        long.clone(),
+        "App\n.Auth".to_owned(),
+        "App.Auth\0".to_owned(),
+        "App.🚀Auth".to_owned(),
+        "🚀".to_owned(),
+    ];
+    for fqn in &exotic {
+        assert!(model.element(fqn).is_none(), "特殊字符 FQN 不命中: {fqn:?}");
+    }
+    // 同时确认特殊字符元素本身可被精确命中（查找语义不排斥特殊字符）
+    let mut special = element("App.🚀Auth");
+    special.summary = Some("emoji 元素".to_owned());
+    let model = Model {
+        elements: vec![special],
+        relations: Vec::new(),
+    };
+    assert!(
+        model.element("App.🚀Auth").is_some(),
+        "特殊字符 FQN 精确命中"
+    );
+}
+
+/// 边界：500 元素模型查末个元素 → `Some`（线性扫描不因规模改变语义）。
+#[test]
+fn element五百元素模型命中末个元素() {
+    let elements: Vec<Element> = (0..500)
+        .map(|index| element(&format!("App.Mod{index:03}")))
+        .collect();
+    let model = Model {
+        elements,
+        relations: Vec::new(),
+    };
+    let found = model.element("App.Mod499").expect("末个元素应命中");
+    assert_eq!(found.fqn, "App.Mod499");
+    assert!(model.element("App.Mod500").is_none(), "末个之后不命中");
+}
+
+// ---------------------------------------------------------------------------
+// 派生语义（`PartialEq` / `Eq`）
+// ---------------------------------------------------------------------------
+
+/// 边界：同内容两 `Model` 相等；仅 `file` 或 `line` 不同即不等；`metadata: {}`
+/// 与缺省同值相等；`Relation.span == None` 占位可比较。
+#[test]
+fn 派生相等语义_文件行参与比较与空表同值() {
+    // 同内容相等
+    assert_eq!(three_elements(), three_elements(), "同内容两模型相等");
+
+    // 仅 file 不同即不等
+    let mut moved = three_elements();
+    moved.elements[1].file = "openspec/architecture/models/02-auth.toml".to_owned();
+    assert_ne!(moved, three_elements(), "仅 file 不同即不等");
+
+    // 仅 line 不同即不等
+    let mut shifted = three_elements();
+    shifted.elements[1].line = 8;
+    assert_ne!(shifted, three_elements(), "仅 line 不同即不等");
+
+    // metadata: {} 与缺省同值相等
+    let mut empty_metadata = element("App");
+    empty_metadata.metadata = BTreeMap::new();
+    assert_eq!(empty_metadata, element("App"), "空 metadata 与缺省同值");
+
+    // Relation.span == None 占位可比较
+    let without_span = Relation {
+        from: "App.Auth".to_owned(),
+        to: "App".to_owned(),
+        description: None,
+        file: "openspec/architecture/models/01-core.toml".to_owned(),
+        line: 12,
+        span: None,
+    };
+    assert_eq!(
+        without_span,
+        Relation {
+            from: "App.Auth".to_owned(),
+            to: "App".to_owned(),
+            description: None,
+            file: "openspec/architecture/models/01-core.toml".to_owned(),
+            line: 12,
+            span: None,
+        },
+        "span 占位 None 可比较相等"
+    );
+    assert_ne!(
+        without_span,
+        Relation {
+            from: "App.Auth".to_owned(),
+            to: "App".to_owned(),
+            description: None,
+            file: "openspec/architecture/models/01-core.toml".to_owned(),
+            line: 12,
+            span: Some(SourceSpan { start: 10, end: 20 }),
+        },
+        "span 在场与缺席不等"
+    );
+}
diff --git a/crates/core/archi/src/parse/mod.rs b/crates/core/archi/src/parse/mod.rs
new file mode 100644
index 000000000000..411275346ad4
--- /dev/null
+++ b/crates/core/archi/src/parse/mod.rs
@@ -0,0 +1,117 @@
+//! 多文件聚合：`<架构域>/models/*.toml` 按文件名字典序读取并合并为一个
+//! [`Model`]，声明位置（`modelFile` / `modelLine`）由解析器 span 回填。
+//!
+//! 聚合层职责（格式无关）：目录遍历、字典序、跨文件重复 FQN 检出、文件相对
+//! 路径回填、读盘失败落结构化诊断。单文件解析经 [`SourceParser`] 抽象——换格式
+//! 只动 `parse/` 内的实现文件。
+
+use std::collections::BTreeMap;
+use std::fs;
+use std::path::{Path, PathBuf};
+
+use foundation::layout::archi_models_dir;
+
+use crate::dto::DiagnosticKind;
+use crate::model::{Diagnostic, Model, ParseOutcome};
+
+pub mod toml;
+
+pub use toml::TomlParser;
+
+#[cfg(test)]
+mod mod_test;
+
+#[cfg(test)]
+mod toml_test;
+
+/// 单文件解析契约（关联函数，无接收者）：产出诊断不带文件身份（`file` 留空），
+/// 由聚合层回填该文件的 repo 相对路径。
+pub trait SourceParser {
+    /// 解析一段源文本为该格式的模型 + 诊断。
+    fn parse(source: &str) -> ParseOutcome;
+}
+
+/// 模型源文件扩展名（唯一收面判据）。
+const MODEL_FILE_SUFFIX: &str = ".toml";
+
+/// 聚合入口：模型目录下全部 `.toml` 按**文件名**字典序解析 → 合并（元素 / 关系
+/// 按文件序 + 各自声明序）→ 跨文件重复 FQN 检出 → 文件相对路径回填。
+///
+/// 模型目录缺席 / 空目录 → 空模型零诊断（冷启动合法起点，不报错）；单文件读取
+/// 失败 → `syntaxError` 诊断（读取面 MUST NOT 静默丢文件）。
+pub fn parse_dir(root: &Path) -> ParseOutcome {
+    let dir = archi_models_dir(root);
+    let mut files: Vec<(String, PathBuf)> = Vec::new();
+    let Ok(reader) = fs::read_dir(&dir) else {
+        return ParseOutcome {
+            model: Model::empty(),
+            diagnostics: Vec::new(),
+        };
+    };
+    for entry in reader.flatten() {
+        let path = entry.path();
+        if !path.is_file() {
+            continue;
+        }
+        let Some(name) = path.file_name().and_then(|name| name.to_str()) else {
+            continue;
+        };
+        if !name.ends_with(MODEL_FILE_SUFFIX) {
+            continue;
+        }
+        files.push((name.to_owned(), path));
+    }
+    files.sort_by(|left, right| left.0.cmp(&right.0));
+
+    let mut model = Model::empty();
+    let mut diagnostics: Vec<Diagnostic> = Vec::new();
+    let mut seen: BTreeMap<String, ()> = BTreeMap::new();
+    for (name, path) in files {
+        let file = relative_path(root, &path).unwrap_or(name);
+        let source = match fs::read_to_string(&path) {
+            Ok(source) => source,
+            Err(error) => {
+                diagnostics.push(Diagnostic {
+                    kind: DiagnosticKind::SyntaxError,
+                    message: format!("模型文件读取失败：{error}"),
+                    file,
+                    line: 0,
+                    column: None,
+                });
+                continue;
+            }
+        };
+        let outcome = TomlParser::parse(&source);
+        for mut diagnostic in outcome.diagnostics {
+            diagnostic.file = file.clone();
+            diagnostics.push(diagnostic);
+        }
+        for mut element in outcome.model.elements {
+            element.file = file.clone();
+            if seen.contains_key(&element.fqn) {
+                diagnostics.push(Diagnostic {
+                    kind: DiagnosticKind::DuplicateElement,
+                    message: format!("跨文件重复声明元素：{}", element.fqn),
+                    file: element.file,
+                    line: element.line,
+                    column: None,
+                });
+                continue;
+            }
+            seen.insert(element.fqn.clone(), ());
+            model.elements.push(element);
+        }
+        for mut relation in outcome.model.relations {
+            relation.file = file.clone();
+            model.relations.push(relation);
+        }
+    }
+    ParseOutcome { model, diagnostics }
+}
+
+/// 绝对路径 → repo 相对路径（`/` 分隔）单点：解析聚合层与文档关联层共用同一
+/// 取法（不在两处各写一份）。不在 root 之下即 `None`。
+pub(crate) fn relative_path(root: &Path, path: &Path) -> Option<String> {
+    let relative = path.strip_prefix(root).ok()?;
+    Some(relative.to_string_lossy().replace('\\', "/"))
+}
