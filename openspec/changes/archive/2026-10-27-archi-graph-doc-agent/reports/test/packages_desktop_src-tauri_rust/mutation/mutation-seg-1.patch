+#[test]
+fn 聚合序按字节字典序而非数字序() {
+    let temp = TempDir::new("byte-order");
+    for (name, fqn) in [
+        ("a.toml", "App.Aaa"),
+        ("B.toml", "App.Bbb"),
+        ("10.toml", "App.Ten"),
+        ("2.toml", "App.Two"),
