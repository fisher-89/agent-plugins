+/// 正向：7 份命中 md 逐文件含其勾选工具名、且不含未勾选工具名。
+#[test]
+fn archi工具引用与注入矩阵逐文件一致() {
+    for (name, module, search) in ARCHI_PROMPT_MATRIX {
+        let text = prompt_text(name);
+        assert_eq!(
+            text.contains("archi_module"),
