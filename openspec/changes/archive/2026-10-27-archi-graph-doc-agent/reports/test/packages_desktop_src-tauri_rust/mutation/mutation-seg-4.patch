+/// archi 来源注入底座（两布尔位按需；`tools` 不收窄 = 七通用工具全量）。
+fn archi_injections(module: bool, search: bool) -> agent::SessionInjections {
+    agent::SessionInjections {
+        preamble: None,
+        tools: None,
+        toolset: Some(SessionToolset::Archi { module, search }),
+    }
+}
