+/// 指定档位的 Continue open 底座（按档窗长 / 按档解析用例的轮级入口）。
+fn open_continue_at_level(session_id: &str, level: ModelLevel) -> SessionOpen {
+    SessionOpen {
+        ctx: SessionCtx {
+            model_level: level,
+            ..open_continue(session_id).ctx
+        },
+        ..open_continue(session_id)
+    }
+}
