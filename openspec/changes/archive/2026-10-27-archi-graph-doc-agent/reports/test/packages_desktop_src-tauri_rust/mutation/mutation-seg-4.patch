+/// 主仓 root 临时目录装置（可含真实配置文件）。
+fn workspace_root(tag: &str) -> tempfile::TempDir {
+    tempfile::Builder::new()
+        .prefix(&format!("sdk-runner-root-{tag}-"))
+        .tempdir()
+        .expect("创建临时目录失败")
+}
