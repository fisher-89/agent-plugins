+/// 端点指向本机 discard 端口（恒拒连，无网络触达真实 provider）。
+fn complete_config() -> EngineConfig {
+    EngineConfig {
+        protocol: Protocol::Openai,
+        api_key: "sk-test".to_owned(),
+        base_url: "http://127.0.0.1:9/v1".to_owned(),
