+/// 真实临时 workspace 库句柄装置（tempfile + open_workspace，不 mock）。
+fn temp_store(tag: &str) -> (tempfile::TempDir, Arc<Store>) {
+    let dir = tempfile::Builder::new()
+        .prefix(&format!("sdk-runner-explore-{tag}-"))
+        .tempdir()
+        .expect("创建临时目录失败");
+    let db_path = dir.path().join("ws.redb");
