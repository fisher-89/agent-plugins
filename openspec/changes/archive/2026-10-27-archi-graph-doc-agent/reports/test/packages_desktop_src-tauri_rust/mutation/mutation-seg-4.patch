+/// 健康模型（`App` / `App.Auth` 两元素，`App.Auth` 带 gate 与 summary）。
+const ARCHI_CORE: &str = concat!(
+    "# 核心包\n",
+    "[element.\"App\"]\n",
+    "kind = \"package\"\n",
+    "\n",
+    "[element.\"App.Auth\"]\n",
