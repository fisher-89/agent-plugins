+/// 边界（AC-7 branch 零触碰）：remove 后 `git branch` 列表仍含 `change/<name>`
+///（`worktree remove --force` 不动分支——归档链 branch 保留语义的 vcs 半边）。
+#[test]
+fn process_archive_vcs_remove_worktree后分支留存() {
+    let port = ProcessArchiveVcs::new();
