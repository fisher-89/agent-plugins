+fi
+"
+        ),
+        None => String::new(),
+    };
+    let body = format!(
+        "#!/bin/sh
+cf=\"{cf}\"
+n=$(cat \"$cf\" 2>/dev/null || printf '0')
+n=$((n+1))
+printf '%s' \"$n\" > \"$cf\"
+{success}count=0
+case \"$n\" in
+{arms}esac
+i=0
+while [ \"$i\" -lt \"$count\" ]; do
+  printf '   Compiling crate%d v0.1.0\n' \"$i\"
+  i=$((i+1))
+done
+printf 'error: failed to rename archive file: /t/liba.rlib: os error 32\n'
+exit 1
+",
+        cf = counter_path.display(),
+        success = success,
+        arms = arms,
+    );
+    ws.shim(name, &body)
