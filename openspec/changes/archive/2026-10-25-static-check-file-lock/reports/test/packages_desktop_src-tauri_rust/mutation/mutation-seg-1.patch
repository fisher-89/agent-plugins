+/// `   Compiling crate{i} v0.1.0` + 锁文本并 `exit 1`；超出清单的尝试输出 0 行。
+/// `succeed_from = Some(k)` 时第 k 次起转绿（`SUCCESS-OUT` / `SUCCESS-ERR` +
+/// `exit 0`）。尝试次数由计数文件自身表达（沿用既有 `attempt_count` 装置）。
+fn counting_shim(
+    ws: &ShimWs,
+    name: &str,
+    counter: &str,
+    counts: &[u32],
+    succeed_from: Option<u32>,
