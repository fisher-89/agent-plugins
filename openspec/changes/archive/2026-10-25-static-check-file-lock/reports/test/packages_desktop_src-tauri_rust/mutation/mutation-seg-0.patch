+/// 工件文本归一（CRLF / 去尾随空白——shim 拷贝可能引入平台行尾差异）。
+fn artifact_normalized() -> String {
+    SPEC_OUTPUT
+        .lines()
+        .map(str::trim_end)
+        .collect::<Vec<_>>()
+        .join("\n")
+        + "\n"
+}
