+        .map(|index| covered_report(&format!("suite{index}"), "rust"))
+        .collect();
+    reports.push(report_with(
+        "missing",
+        "vite-plus",
+        1,
+        counts(1, 0, 1, 0),
+        Vec::new(),
+        None,
+        vec![failed_case("x > y", "boom")],
+        None,
+    ));
