+/// reason 长度门（自包含：上限常量 + 当前值 + 超出量）。
+fn ensure_reason_len(reason: &str) -> Result<(), String> {
+    let chars = reason.chars().count();
+    if chars > MAX_REASON_CHARS {
+        return Err(format!(
+            "字段 reason 超长：上限 {MAX_REASON_CHARS} 字符，当前 {chars} 字符，超出 {}",
+            chars - MAX_REASON_CHARS
+        ));
+    }
