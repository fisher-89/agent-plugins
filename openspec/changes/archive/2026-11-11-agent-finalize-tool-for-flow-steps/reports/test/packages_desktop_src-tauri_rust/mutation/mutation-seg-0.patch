+/// sdk 实例 fixture（可指定 provider_id 与默认标记）。
+fn seed_sdk_instance(stores: &WorkspaceStores, name: &str, provider_id: Option<i64>) -> i64 {
+    let id = stores
+        .global()
+        .upsert_agent_instance(AgentInstanceRecord::new(
+            name.to_owned(),
+            AgentEngineKind::Sdk,
+            provider_id,
+        ))
+        .expect("落 sdk 实例 fixture")
