+                        .filter_map(|block| match block {
+                            agent::AgentBlock::ToolResult {
+                                id,
+                                content,
+                                is_error,
+                            } => Some((id.clone(), content.clone(), *is_error)),
+                            _ => None,
+                        })
+                        .collect::<Vec<_>>(),
