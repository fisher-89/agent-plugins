+//! 用途：按**产品真实执行链**重跑 test-execution / mutation-test 并落盘权威报告
+//! （`report.json` / `summary.json` / 段报告 / 归并块），避免手工重实现聚合语义。
+//!
+//! 形态选 `examples/`：它不是 lib test 模块，因此不会被 `nextest` 纳入——
+//! 若做成 `#[cfg(test)] mod`，重跑链自身会作为一条用例出现，导致计数偏移。
+//!
+//! 用法：`cargo run --example regen_reports -- testexec` / `mutation`
+
+use foundation::cancel::CancelFlag;
+use foundation::layout::ReportSlot;
+use orchestration::port::{ArchiveVcsPort, MutationRunner, TestExecutionRunner, ToolStepOutput};
+
+const ROOT: &str = "D:/Projects/.worktrees/wps-claude-plugin/agent-finalize-tool-for-flow-steps";
+const CHANGE: &str = "agent-finalize-tool-for-flow-steps";
+
+fn runtime() -> tokio::runtime::Runtime {
+    tokio::runtime::Builder::new_multi_thread()
+        .enable_all()
+        .build()
+        .expect("tokio runtime")
+}
+
+fn main() {
+    let stage = std::env::args().nth(1).unwrap_or_default();
+    let root = ROOT.to_owned();
+    let path = std::path::Path::new(&root);
+
+    match stage.as_str() {
+        "testexec" => {
+            // 复用门以 summary.json 新鲜度判定：删旧件使本次为真实执行（产物自证权威）。
+            let reports = foundation::layout::change_test_reports(path, CHANGE);
+            let _ = std::fs::remove_file(reports.join("summary.json"));
+            let outcome = runtime().block_on(checks_runtime::ProcessTestExecution::new().run(
+                &root,
+                CHANGE,
+                ReportSlot::Test,
+                CancelFlag::never(),
+                None,
+            ));
+            match outcome {
+                Ok(ToolStepOutput::TestExecution(o)) => println!(
+                    "TESTEXEC conclusion={:?} total={} passed={} failed={}",
+                    o.conclusion, o.total, o.passed, o.failed
+                ),
+                other => println!("TESTEXEC {other:?}"),
+            }
+        }
+        "mutation" => {
+            let vcs = vcs_runtime::ProcessArchiveVcs::new();
+            let files = vcs.change_edit_set(path, "HEAD").expect("edit set");
+            let patch = vcs.change_edit_patch(path, "HEAD").expect("edit patch");
+            println!("EDIT_SET {} files", files.len());
+            let outcome = runtime().block_on(checks_runtime::ProcessMutation::new().run(
+                &root,
+                CHANGE,
+                &files,
+                &patch,
+                CancelFlag::never(),
+                None,
+            ));
+            match outcome {
+                Ok(ToolStepOutput::MutationTest(o)) => println!(
+                    "MUTATION conclusion={:?} score={} threshold={} counts={:?} skip={:?} fault={:?}",
+                    o.conclusion, o.score, o.threshold, o.counts, o.skip, o.fault
+                ),
+                other => println!("MUTATION {other:?}"),
+            }
+        }
+        other => panic!("未知阶段 {other}（testexec / mutation）"),
+    }
+}
