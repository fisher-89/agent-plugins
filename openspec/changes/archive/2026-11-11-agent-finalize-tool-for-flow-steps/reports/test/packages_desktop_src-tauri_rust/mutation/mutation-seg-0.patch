+                .collect::<Option<Vec<String>>>()
+                .ok_or_else(|| "字段 options 含非字符串元素：期望字符串数组".to_owned())?;
+            if options.is_empty() {
+                return Err("字段 options 为空数组：期望至少一个选项".to_owned());
+            }
+            Ok(DecisionAction::Ask { question, options })
