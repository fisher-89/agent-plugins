index 000000000000..9c9b14398bf9
--- /dev/null
+++ b/crates/core/workflow/src/model/checklist.rs
@@ -0,0 +1,79 @@
+//! 静态清单表解析器（ID 契约面）：evaluator prompt 的 `## 静态清单` 段三列表
+//!（`ID | 检查项 | 判断依据`）是 checklist 的 ID 与权威人读文案唯一来源。
+//!
+//! 三条规则（缺一即错，三条均有实测反例）：
+//! 1. 只扫 `## 静态清单` 起、下一个 `## ` 标题止的段落——全文扫描会吃到子表
+//!    （`### T8 格式检查详细项` 的 `T8-U1` / `T8-G1` 等子项）；
+//! 2. 行首匹配 `| <ID> |`（`[A-Z]+[0-9]+`，两侧空格约束）才收——无边界匹配会把
+//!    `T8-U1` 切成 `T8` / `U1` / `G1` 三个假 ID；
+//! 3. 按出现序去重——正文重复引用不产生重复项。
+//!
+//! 零 `regex` 依赖（行首前缀 + 手写字符类判定足够，避免给本 crate 引新依赖）。
+
+/// 静态清单表一行：ID 与第二列「检查项」权威正文。
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ChecklistEntry {
+    /// 表首列 ID（形如 `C1` / `CA8`，`[A-Z]+[0-9]+`）
+    pub id: String,
+    /// 表第二列「检查项」正文（落账 `ChecklistItem.item` 的唯一来源）
+    pub item: String,
+}
+
+/// 清单段标题（段落边界的起止判定单点）。
+const SECTION_TITLE: &str = "## 静态清单";
+
+/// 从 prompt 文本解析静态清单 `(id, 检查项)` 二元组（出现序去重）。
+pub fn checklist_entries(prompt: &str) -> Vec<ChecklistEntry> {
+    let mut entries: Vec<ChecklistEntry> = Vec::new();
+    let mut in_section = false;
+    for line in prompt.lines() {
+        let line = line.trim_end_matches('\r');
+        if line.trim() == SECTION_TITLE {
+            in_section = true;
+            continue;
+        }
+        if !in_section {
+            continue;
+        }
+        // 段落边界：下一个二级标题即止（`###` 子标题不终止段落，其行形态由
+        // 表首列 ID 判定挡住）
+        if line.starts_with("## ") {
+            break;
+        }
+        let Some(entry) = parse_row(line) else {
+            continue;
+        };
+        if entries.iter().any(|existing| existing.id == entry.id) {
+            continue;
+        }
+        entries.push(entry);
+    }
+    entries
+}
+
+/// 表行解析：`| <ID> | <检查项> | …` → 入口（形态不符即 `None`）。
+fn parse_row(line: &str) -> Option<ChecklistEntry> {
+    let rest = line.strip_prefix("| ")?;
+    let letters: String = rest.chars().take_while(char::is_ascii_uppercase).collect();
+    if letters.is_empty() {
+        return None;
+    }
+    let after_letters = &rest[letters.len()..];
+    let digits: String = after_letters
+        .chars()
+        .take_while(char::is_ascii_digit)
+        .collect();
+    if digits.is_empty() {
+        return None;
+    }
+    let columns = after_letters[digits.len()..].strip_prefix(" |")?;
+    // 第二列：到下一个 `|` 之前（第三列「判断依据」不在本解析面）
+    let item = columns.split('|').next()?.trim();
+    if item.is_empty() {
+        return None;
+    }
+    Some(ChecklistEntry {
+        id: format!("{letters}{digits}"),
+        item: item.to_owned(),
+    })
+}
diff --git a/crates/core/workflow/src/model/checklist_test.rs b/crates/core/workflow/src/model/checklist_test.rs
new file mode 100644
index 000000000000..3a39e988a721
--- /dev/null
+++ b/crates/core/workflow/src/model/checklist_test.rs
@@ -0,0 +1,305 @@
+//! `checklist.rs`（静态清单表解析器）的单元测试：三条解析规则的正向 / 边界 /
+//! 反例面——段落边界（只扫 `## 静态清单` 起的段落）、行首 `| <ID> |` 形态约束
+//!（两侧空格 + `[A-Z]+[0-9]+`）、出现序去重，以及第二列「检查项」权威正文取值。
+//!
+//! 纯 `&str` 扫描的纯函数，全部输入为测试体内内存字符串字面量；零文件 IO、
+//! 零网络、零子进程、零环境变量，故不设 Mock。
+
+use crate::model::checklist::{checklist_entries, ChecklistEntry};
+
+/// ID 序列投影（用例判据面：集合 / 顺序断言的主读数）。
+fn ids(prompt: &str) -> Vec<String> {
+    checklist_entries(prompt)
+        .into_iter()
+        .map(|entry| entry.id)
+        .collect()
+}
+
+/// 三列清单表段（`## 静态清单` 标题 + 表头 + 分隔行 + 逐行表项）。
+fn section(rows: &[(&str, &str, &str)]) -> String {
+    let mut text = String::from("## 静态清单\n\n| ID | 检查项 | 判断依据 |\n|---|---|---|\n");
+    for (id, item, basis) in rows {
+        text.push_str(&format!("| {id} | {item} | {basis} |\n"));
+    }
+    text
+}
+
+// ---------------------------------------------------------------------------
+// 正向：三列解析与第二列权威正文
+// ---------------------------------------------------------------------------
+
+#[test]
+fn 正向三列解析_id按出现序且item取第二列() {
+    let prompt = section(&[
+        ("A1", "检查项甲", "判断依据甲"),
+        ("A2", "检查项乙", "判断依据乙"),
+        ("A3", "检查项丙", "判断依据丙"),
+    ]);
+    let entries = checklist_entries(&prompt);
+    assert_eq!(entries.len(), 3, "三行表项逐行收入，实际: {entries:?}");
+    assert_eq!(
+        ids(&prompt),
+        vec!["A1".to_owned(), "A2".to_owned(), "A3".to_owned()],
+        "ID 按出现序"
+    );
+    assert_eq!(
+        entries[0].item, "检查项甲",
+        "第二列逐字（不含首尾空格、不含第三列）"
+    );
+    assert_eq!(entries[2].item, "检查项丙", "第三行第二列逐字");
+}
+
+#[test]
+fn 第二列权威正文_第三列不参与且含中文标点时逐字保真() {
+    let prompt = section(&[(
+        "C1",
+        "变更代码中无安全漏洞",
+        "检查：SQL注入、XSS…（全角括号）",
+    )]);
+    let entries = checklist_entries(&prompt);
+    assert_eq!(entries.len(), 1);
+    assert_eq!(
+        entries[0].item, "变更代码中无安全漏洞",
+        "第三列（判断依据）不进入 item"
+    );
+    assert!(
+        !entries[0].item.contains("SQL"),
+        "第三列内容零外溢: {:?}",
+        entries[0].item
+    );
+
+    // 第二列内嵌空格 / 全角括号 / 中文标点逐字保真，前后多余空格被 trim
+    let prompt = section(&[("C1", "  含 空格 与（全角）：逐字  ", "依据")]);
+    assert_eq!(
+        checklist_entries(&prompt)[0].item,
+        "含 空格 与（全角）：逐字",
+        "仅 trim 首尾空格，正文内空格保真"
+    );
+}
+
+// ---------------------------------------------------------------------------
+// 边界：段落边界（规则 ①）
+// ---------------------------------------------------------------------------
+
+#[test]
+fn 段落边界_标题前与下一个二级标题后均不收() {
+    let prompt = format!(
+        "## 前置附录\n\n| Z9 | 段外项 | 依据 |\n\n{}\n## 附录\n\n| Y1 | 段后项 | 依据 |\n",
+        section(&[("A1", "段内项", "依据")])
+    );
+    let got = ids(&prompt);
+    assert_eq!(got, vec!["A1".to_owned()], "仅静态清单段内被收集");
+    assert!(!got.contains(&"Z9".to_owned()), "标题前段落零命中");
+    assert!(!got.contains(&"Y1".to_owned()), "下一个二级标题后零命中");
+}
+
+#[test]
+fn 段落边界_三态表驱动() {
+    // 形态一：标题前的同名形态表项
+    let before = format!(
+        "## 概述\n\n| Z9 | 段外项 | 依据 |\n\n{}",
+        section(&[("A1", "段内项", "依据")])
+    );
+    assert_eq!(ids(&before), vec!["A1".to_owned()], "标题前表项不收");
+
+    // 形态二：段落之后（第二个二级标题起）的表项
+    let after = format!(
+        "{}\n## 附录\n\n| Y1 | 段后项 | 依据 |\n| Y2 | 段后项二 | 依据 |\n",
+        section(&[("A1", "段内项", "依据")])
+    );
+    assert_eq!(ids(&after), vec!["A1".to_owned()], "标题后表项不收");
+
+    // 形态三：`## 静态清单` 为最后一段（无后续 `## `）→ 正常收，不 panic
+    let tail = section(&[("B1", "末段项", "依据"), ("B2", "末段项二", "依据")]);
+    assert_eq!(
+        ids(&tail),
+        vec!["B1".to_owned(), "B2".to_owned()],
+        "段落无上界时照常收"
+    );
+}
+
+#[test]
+fn 三级子表零命中_仿测试设计评估器合成样本() {
+    let prompt = format!(
+        "{}\n### T8 格式检查详细项\n\n| ID | 子项 | 判定 |\n|---|---|---|\n\
+         | T8-U1 | 子项甲 | 判定甲 |\n| T8-G1 | 子项乙 | 判定乙 |\n| T8-U2 | 子项丙 | 判定丙 |\n",
+        section(&[("T1", "主清单甲", "依据甲"), ("T2", "主清单乙", "依据乙")])
+    );
+    let got = ids(&prompt);
+    assert_eq!(got.len(), 2, "`###` 子表零收入，实际: {got:?}");
+    assert_eq!(got, vec!["T1".to_owned(), "T2".to_owned()]);
+    for fake in ["T8-U1", "T8-G1", "T8-U2"] {
+        assert!(!got.contains(&fake.to_owned()), "子项 {fake} 零命中");
+    }
+    // 双保险反证：若放宽为无边界 `[A-Z]+[0-9]+` 全行扫描，子项会被切成假 ID
+    let loose_hits = prompt.lines().filter(|line| line.contains("T8-")).count();
+    assert_eq!(loose_hits, 3, "合成样本含三行子表（宽松扫描的假 ID 来源）");
+}
+
+// ---------------------------------------------------------------------------
+// 边界：ID 形态（规则 ②）
+// ---------------------------------------------------------------------------
+
+#[test]
+fn id形态边界_七拒二收() {
+    let rejected = [
+        "| t1 | 小写 | 依据 |",
+        "| T1a | 尾随字母 | 依据 |",
+        "| 1T | 首字符数字 | 依据 |",
+        "| T | 无数字 | 依据 |",
+        "| T1| 右无空格 | 依据 |",
+        "|\tT1 \t| 制表符 | 依据 |",
+        "> | T1 | 非行首 | 依据 |",
+    ];
+    for line in rejected {
+        let prompt = format!("## 静态清单\n{line}\n");
+        assert!(
+            checklist_entries(&prompt).is_empty(),
+            "形态 {line:?} 必须不收，实际: {:?}",
+            ids(&prompt)
+        );
+    }
+
+    let prompt = "## 静态清单\n| AB12 | 多字母前缀 | 依据 |\n| T1 | 单字母 | 依据 |\n";
+    assert_eq!(
+        ids(prompt),
+        vec!["AB12".to_owned(), "T1".to_owned()],
+        "多字母前缀与单字母两种合法形态均收"
+    );
+}
+
+#[test]
+fn 表头与分隔行与空行不收() {
+    let prompt = "## 静态清单\n\n| ID | 检查项 | 判断依据 |\n|---|---|---|\n\n说明性段落文字\n";
+    assert!(
+        checklist_entries(prompt).is_empty(),
+        "表头 / 分隔行 / 空行 / 说明段均不收，实际: {:?}",
+        ids(prompt)
+    );
+}
+
+// ---------------------------------------------------------------------------
+// 异常：出现序去重（规则 ③）
+// ---------------------------------------------------------------------------
+
+#[test]
+fn 出现序去重_同id两次收首现且保序() {
+    let prompt = section(&[
+        ("C1", "正文A", "依据"),
+        ("C2", "正文B", "依据"),
+        ("C1", "正文A", "依据"),
+    ]);
+    let entries = checklist_entries(&prompt);
+    assert_eq!(entries.len(), 2, "同 ID 去重，实际: {entries:?}");
+    assert_eq!(
+        entries.iter().map(|e| e.id.as_str()).collect::<Vec<_>>(),
+        vec!["C1", "C2"],
+        "首现位置保序"
+    );
+
+    // 同 ID 两次但第二列文本不同 → 保留首现正文（去重按 ID，不按整行）
+    let prompt = section(&[
+        ("C1", "首现正文", "依据甲"),
+        ("C2", "另一项", "依据乙"),
+        ("C1", "后现正文", "依据丙"),
+    ]);
+    assert_eq!(
+        checklist_entries(&prompt)[0].item,
+        "首现正文",
+        "去重键是 ID，首现正文权威"
+    );
+}
+
+// ---------------------------------------------------------------------------
+// 边界：空与缺席 / 换行与特殊字符 / 规模
+// ---------------------------------------------------------------------------
+
+#[test]
+fn 空输入与缺席四形态() {
+    assert!(checklist_entries("").is_empty(), "空串 → 零项（不 panic）");
+    let no_section = "这是一段很长的说明文本\n".repeat(100);
+    assert!(
+        checklist_entries(&no_section).is_empty(),
+        "无 `## 静态清单` 标题 → 零项"
+    );
+    let title_only = "## 静态清单\n\n说明段落没有表行\n";
+    assert!(
+        checklist_entries(title_only).is_empty(),
+        "标题在场但段内零表行 → 零项"
+    );
+    let title_last = "## 静态清单\n| A1 | 末段项 | 依据 |";
+    assert_eq!(
+        ids(title_last),
+        vec!["A1".to_owned()],
+        "标题为末段且无后续 `## ` → 正常收"
+    );
+}
+
+#[test]
+fn 换行与特殊字符四形态() {
+    // 形态一：CRLF 行尾 → 与 LF 形态逐字段相等（`\r` 不进 item）
+    let lf = section(&[("C1", "检查项甲", "依据甲"), ("C2", "检查项乙", "依据乙")]);
+    let crlf = lf.replace('\n', "\r\n");
+    assert_eq!(
+        checklist_entries(&crlf),
+        checklist_entries(&lf),
+        "CRLF 与 LF 结果逐字段相等"
+    );
+    assert!(
+        checklist_entries(&crlf)
+            .iter()
+            .all(|entry| !entry.item.contains('\r')),
+        "`\\r` 不污染 item"
+    );
+
+    // 形态二：判断依据列含 `\0` 与 emoji → 不 panic，item 不受污染
+    let special = section(&[("C1", "检查项甲", "依据\0含空字节🚀")]);
+    let entries = checklist_entries(&special);
+    assert_eq!(entries.len(), 1);
+    assert_eq!(entries[0].item, "检查项甲", "第三列特殊字符零外溢");
+
+    // 形态三：100k 字符超长 prompt（前段填充 + 段内 1000 行表）→ 恰 1000 项
+    let mut huge = "填充".repeat(50_000);
+    huge.push('\n');
+    huge.push_str("## 静态清单\n");
+    for index in 0..1000 {
+        huge.push_str(&format!("| A{index} | 检查项 {index} | 依据 |\n"));
+    }
+    assert!(
+        huge.chars().count() > 100_000,
+        "前置：prompt 超长（实际 {} 字符）",
+        huge.chars().count()
+    );
+    assert_eq!(
+        checklist_entries(&huge).len(),
+        1000,
+        "超长 prompt 不 panic 且逐行收入"
+    );
+
+    // 形态四：emoji 出现在 ID 前的填充文本 → 段外文本零影响
+    let emoji_noise = format!("🚀🎉 无关段落\n\n{}", section(&[("A1", "检查项", "依据")]));
+    assert_eq!(ids(&emoji_noise), vec!["A1".to_owned()]);
+}
+
+#[test]
+fn 幂等与确定性_两次调用逐字段相等() {
+    let prompt = section(&[("R1", "项一", "依据一"), ("R2", "项二", "依据二")]);
+    let first: Vec<ChecklistEntry> = checklist_entries(&prompt);
+    let second = checklist_entries(&prompt);
+    assert_eq!(first, second, "零内部状态：两次调用逐字段相等");
+
+    // 「段落内 ID 集 == 结果 ID 集」：无静默丢项
+    let expected: Vec<String> = prompt
+        .lines()
+        .filter_map(|line| {
+            let rest = line.strip_prefix("| ")?;
+            let id: String = rest
+                .chars()
+                .take_while(|c| c.is_ascii_uppercase() || c.is_ascii_digit())
+                .collect();
+            (id.starts_with(|c: char| c.is_ascii_uppercase()) && id.chars().any(char::is_numeric))
+                .then_some(id)
+        })
+        .collect();
+    assert_eq!(ids(&prompt), expected, "解析结果覆盖段落内全部合法 ID");
+}
diff --git a/crates/core/workflow/src/model/domain.rs b/crates/core/workflow/src/model/domain.rs
index bb0462f08945..dd407be49748 100644
--- a/crates/core/workflow/src/model/domain.rs
+++ b/crates/core/workflow/src/model/domain.rs
@@ -29,3 +29,14 @@ pub struct ChecklistItem {
     pub pass: bool,
     pub evidence: String,
 }
+
+/// verdict 推导全局单点：checklist 全 pass → pass，否则 fail（空 checklist →
+/// pass，与插件 `resolveVerdict` 的 every 语义一致）。落账路径（`phase_log`）
+/// 与编排侧 `finish_step` 校验器共用本实现——MUST NOT 出现第二份。
+pub fn derive_verdict(checklist: &[ChecklistItem]) -> Verdict {
+    if checklist.iter().all(|item| item.pass) {
+        Verdict::Pass
+    } else {
+        Verdict::Fail
+    }
+}
diff --git a/crates/core/workflow/src/model/domain_test.rs b/crates/core/workflow/src/model/domain_test.rs
new file mode 100644
index 000000000000..6e8da4beb1ec
--- /dev/null
+++ b/crates/core/workflow/src/model/domain_test.rs
@@ -0,0 +1,187 @@
+//! `domain.rs` 的 `derive_verdict`（verdict 推导单点）单元测试：三态归约、
+//! 单元素 / 大列表边界、「只依赖 pass 位」的推导面，以及单点性源码自证。
+//!
+//! 布尔归约纯函数，输入为内存 `ChecklistItem` 构造；零进程边界依赖（零文件 /
+//! 网络 / DB / 子进程 / 环境变量），故不设 Mock。
+
+use crate::model::domain::{derive_verdict, ChecklistItem, Verdict};
+
+/// 单项 fixture（`item` / `evidence` 为旁证面，只有 `pass` 参与推导）。
+fn item(pass: bool) -> ChecklistItem {
+    ChecklistItem {
+        item: "检查项".to_owned(),
+        pass,
+        evidence: "依据".to_owned(),
+    }
+}
+
+// ---------------------------------------------------------------------------
+// 正向：三态
+// ---------------------------------------------------------------------------
+
+#[test]
+fn 三态归约_全pass过含fail败空表过() {
+    // 全 pass（2 项）→ Pass
+    assert_eq!(
+        derive_verdict(&[item(true), item(true)]),
+        Verdict::Pass,
+        "全 pass → Pass"
+    );
+    // 含 1 项 fail → Fail
+    assert_eq!(
+        derive_verdict(&[item(true), item(false)]),
+        Verdict::Fail,
+        "含任一 fail → Fail"
+    );
+    // 空表 → Pass（与既有 every 语义一致：空表即通过）
+    assert_eq!(derive_verdict(&[]), Verdict::Pass, "空表 → Pass");
+}
+
+// ---------------------------------------------------------------------------
+// 边界：单元素 / 末项 / 大列表
+// ---------------------------------------------------------------------------
+
+#[test]
+fn 单元素边界_两臂各一例() {
+    assert_eq!(
+        derive_verdict(&[item(true)]),
+        Verdict::Pass,
+        "单元素 pass → Pass"
+    );
+    assert_eq!(
+        derive_verdict(&[item(false)]),
+        Verdict::Fail,
+        "单元素 fail → Fail"
+    );
+}
+
+#[test]
+fn 末项决定结论_大列表不因多数通过而放行() {
+    let mut mostly_pass: Vec<ChecklistItem> = (0..99).map(|_| item(true)).collect();
+    mostly_pass.push(item(false));
+    assert_eq!(
+        derive_verdict(&mostly_pass),
+        Verdict::Fail,
+        "99 pass + 末项 fail → Fail（多数通过不构成通过）"
+    );
+
+    let thousand: Vec<ChecklistItem> = (0..1000).map(|_| item(true)).collect();
+    assert_eq!(derive_verdict(&thousand), Verdict::Pass, "1000 项不 panic");
+}
+
+// ---------------------------------------------------------------------------
+// 边界：只依赖 pass 位
+// ---------------------------------------------------------------------------
+
+#[test]
+fn 只依赖pass位_文本面零影响() {
+    let shapes = [
+        ChecklistItem {
+            item: String::new(),
+            pass: false,
+            evidence: String::new(),
+        },
+        ChecklistItem {
+            item: "🚀含 emoji".to_owned(),
+            pass: false,
+            evidence: String::new(),
+        },
+        ChecklistItem {
+            item: "含\n换行".to_owned(),
+            pass: false,
+            evidence: String::new(),
+        },
+        ChecklistItem {
+            item: "长".repeat(5000),
+            pass: false,
+            evidence: String::new(),
+        },
+    ];
+    for (index, shape) in shapes.into_iter().enumerate() {
+        assert_eq!(
+            derive_verdict(&[shape]),
+            Verdict::Fail,
+            "形态 {index}：item / evidence 内容不参与推导（只看 pass 位）"
+        );
+    }
+
+    // 对照臂：同文本形态但 pass = true → Pass（判据力自证）
+    let passing = ChecklistItem {
+        item: "长".repeat(5000),
+        pass: true,
+        evidence: String::new(),
+    };
+    assert_eq!(derive_verdict(&[passing]), Verdict::Pass);
+}
+
+// ---------------------------------------------------------------------------
+// 异常：单点性（源码自证）
+// ---------------------------------------------------------------------------
+
+#[test]
+fn 单点性_派生实现恰一份且落账侧零第二份实现体() {
+    fn collect(relative: &str) -> Vec<std::path::PathBuf> {
+        let mut found = Vec::new();
+        let root = std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join(relative);
+        let mut stack = vec![root];
+        while let Some(dir) = stack.pop() {
+            let Ok(entries) = std::fs::read_dir(&dir) else {
+                continue;
+            };
+            for entry in entries.flatten() {
+                let path = entry.path();
+                if path.is_dir() {
+                    stack.push(path);
+                } else if path.extension().is_some_and(|ext| ext == "rs") {
+                    found.push(path);
+                }
+            }
+        }
+        found
+    }
+
+    let mut definition_sites: Vec<String> = Vec::new();
+    for path in collect("src") {
+        // 测试文件本体不计入产品定义面（其内为断言用字面量，非实现）
+        let display = path.to_string_lossy().replace('\\', "/");
+        if display.ends_with("_test.rs") {
+            continue;
+        }
+        let text = std::fs::read_to_string(&path).expect("读取产品源文件");
+        if text.contains("fn derive_verdict") {
+            definition_sites.push(display);
+        }
+    }
+    assert_eq!(
+        definition_sites.len(),
+        1,
+        "`fn derive_verdict` 恰一处定义，实际: {definition_sites:?}"
+    );
+    assert!(
+        definition_sites[0].ends_with("model/domain.rs"),
+        "唯一定义位于 model/domain.rs，实际: {}",
+        definition_sites[0]
+    );
+
+    // 落账侧只出现 use 行与调用处：零第二份实现体（无 `fn derive_verdict` 定义）
+    let phase_log = std::fs::read_to_string(
+        std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("src/write/phase_log.rs"),
+    )
+    .expect("读取 phase_log.rs");
+    assert!(
+        !phase_log.contains("fn derive_verdict"),
+        "phase_log.rs 内不得残留私有实现"
+    );
+    assert!(
+        phase_log.contains("use crate::model::derive_verdict")
+            || phase_log.contains("derive_verdict, "),
+        "phase_log.rs 经 model 导入推导单点，实际导入面缺失"
+    );
+    assert_eq!(
+        phase_log
+            .matches("derive_verdict(&input.checklist)")
+            .count(),
+        1,
+        "phase_log.rs 恰一处调用"
+    );
+}
