+/// 异常：畸形 `source_ref` → 恒 `default()`，不抛装配错误、不回退全量 archi 工具。
+#[test]
+fn 畸形source_ref恒default() {
+    for source_ref in [
+        "",
+        "add-feature/implement/executor",
+        "add-feature/implement/1",
+        "add-feature/implement/executor/x",
+        "add-feature/implement/executor/1/extra",
+        "///",
+    ] {
