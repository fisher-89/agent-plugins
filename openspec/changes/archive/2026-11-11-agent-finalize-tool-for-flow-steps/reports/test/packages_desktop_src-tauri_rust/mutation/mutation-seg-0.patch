+/// 保留为不可反序列化载荷（`finish_payload` 由此返 `None`——「未收口」成因面）。
+fn finish_notice_payload(text: &str) -> serde_json::Value {
+    let Ok(value) = serde_json::from_str::<serde_json::Value>(text) else {
+        return serde_json::Value::Null;
