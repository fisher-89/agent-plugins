+#[test]
+fn 端口空批与单份新鲜两边界() {
+    let temp = api_fixture("artifact-writer-boundary");
+    let before = relative_snapshot(temp.path());
+
+    let outcome = ArchiArtifactWriter
+        .write(temp.path(), &[])
+        .expect("空批应 Ok");
