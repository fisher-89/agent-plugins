+// ---------------------------------------------------------------------------
+
+/// 模块头正文（`//!` 段）：去 `//!` 前缀与行首尾空白后逐行拼接——中文散文在源码里按
+/// 显示宽度折行，「只写三类生成物」一类短语会被行尾切断，故判据落在**去前缀后的连续
+/// 正文**上，而不是原始行。
+fn module_head(source: &str) -> String {
+    source
+        .lines()
+        .take_while(|line| line.trim_start().starts_with("//!"))
+        .map(|line| line.trim_start().trim_start_matches("//!").trim())
+        .collect::<Vec<_>>()
+        .join("")
+}
