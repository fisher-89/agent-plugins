+    assert_eq!(error, message, "错误串原文（零包装、零默认值）");
+    assert!(
+        !error.contains("ApiError"),
+        "错误面是 `String` 而非 `ApiError`（端口不持判定域类型）：{error}"
+    );
+    assert_eq!(
+        stub.calls().len(),
