+        "01-generate.toml",
+        concat!(
+            "[element.\"Gamma\"]\n",
+            "kind = \"package\"\n",
+            "\n",
+            "[element.\"Gamma.Auth\"]\n",
+            "kind = \"module\"\n",
+            "path = [\"./src/auth/\"]\n",
+        ),
+    );
+    dir
+}
