+/// `archi_generate` 的挂载项（静态表真值，零替身）。
+fn generate_mount() -> &'static ToolMount {
+    registry()
+        .iter()
+        .find(|mount| mount.definition.name == ARCHI_GENERATE_TOOL)
+        .unwrap_or_else(|| panic!("{ARCHI_GENERATE_TOOL} 应在挂载清单内"))
