+/// 分隔头计数（输出记录回查面：按 `===== attempt ` 子串计数）。
+fn attempt_headers(ws: &TempWs, change: &str, exec_id: &str) -> usize {
+    String::from_utf8_lossy(&read_output(ws, change, exec_id))
+        .matches("===== attempt ")
+        .count()
+}
