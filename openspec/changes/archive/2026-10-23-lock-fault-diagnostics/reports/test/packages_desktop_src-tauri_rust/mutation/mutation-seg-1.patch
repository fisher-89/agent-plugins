+    assert_eq!(
+        output.matches("===== attempt ").count(),
+        2,
+        "自愈面 2 段分隔头: {output}"
+    );
+    assert!(
+        output.contains("===== attempt 1/5 · exit=1 · transient=os error 32 ====="),
+        "首段携命中签名: {output}"
