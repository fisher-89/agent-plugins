+#[tokio::test]
+async fn 三plan混合_环境错误在中间继续跑完且计数不泄漏() {
+    let _window = path_window();
+    let ws = ChainWs::new("fault-env-three-plan").three_plan_mixed();
+    let spec_src = ws.root().join("preset-results.txt");
