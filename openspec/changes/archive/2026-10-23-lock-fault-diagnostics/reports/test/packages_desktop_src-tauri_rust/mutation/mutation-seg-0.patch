+/// 边界：单次双空——`attempts = 1` + 双空输出 → 返回空 `Vec`（零字节，不产生
+/// 空段头）。
+#[test]
+fn 单次双空输出返回零字节() {
+    assert!(attempts_log(&single(b"", b"", 0)).is_empty(), "双空输出零字节");
+}
