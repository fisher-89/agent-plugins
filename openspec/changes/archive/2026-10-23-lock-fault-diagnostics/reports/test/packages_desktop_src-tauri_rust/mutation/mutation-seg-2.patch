+    assert_eq!(report.retried.len(), 2, "末次不入 retried");
+    for (index, trace) in report.retried.iter().enumerate() {
+        assert_eq!(trace.exit_code, 1, "第 {} 次尝试非零退出", index + 1);
+        assert_eq!(
+            trace.transient.as_deref(),
+            Some("os error 32"),
+            "第 {} 次尝试命中签名原文",
+            index + 1
+        );
