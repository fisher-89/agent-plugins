-#[cfg(windows)]
-fn interpreter() -> OsString {
-    match crate::resolve_shell() {
-        crate::ShellBase::GitBash(path) => path.into_os_string(),
-        _ => panic!("run_test 需要 Git for Windows bash（resolve_shell 未探测到 GitBash）"),
-    }
-}
