-/// 路径归一（bash `pwd -W` 的 `C:/x` 与 `pwd` 的 `/c/x` 与宿主 cwd 同形比较）。
-fn normalize_path(raw: &str) -> String {
-    let lowered = raw.trim().replace('\\', "/").to_lowercase();
-    let trimmed = lowered
-        .strip_prefix("/c/")
-        .or_else(|| lowered.strip_prefix("c:/"))
-        .map(str::to_owned)
-        .unwrap_or(lowered);
-    trimmed.trim_end_matches('/').to_owned()
-}
