+        RetryPolicy::none().total_budget,
+        Duration::from_secs(1500),
+        "单次策略取同类常量（不消费）"
+    );
+    assert_eq!(CANCEL_POLL_INTERVAL, Duration::from_millis(200));
+    assert_eq!(FINISH_GRACE, Duration::from_secs(2));
+}
