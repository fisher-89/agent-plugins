+        ("名".repeat(600), u32::MAX),
+        ("a\nb\u{0}c🎉".to_owned(), 1),
+    ] {
+        let edge = LockHolder { name: name.clone(), pid };
+        assert_eq!(edge.name, name, "进程名逐字保留");
+        assert_eq!(edge.pid, pid, "pid 逐值保留");
+    }
