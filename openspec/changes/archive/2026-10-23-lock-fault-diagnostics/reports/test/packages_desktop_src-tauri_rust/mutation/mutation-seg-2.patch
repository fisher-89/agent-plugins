+        timeout: Duration::from_secs(1),
+        cancel: CancelFlag::never(),
+        retry: RetryPolicy::none(),
+    };
+    assert!(none_cwd.clone().cwd.is_none(), "cwd = None 形态保留");
+
+    let debug = format!("{options:?}");
