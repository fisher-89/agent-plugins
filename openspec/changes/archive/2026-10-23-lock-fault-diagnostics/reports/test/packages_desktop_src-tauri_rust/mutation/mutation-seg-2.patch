+#[cfg(windows)]
+#[test]
+fn 归因文本含占用进程与被锁文件() {
+    let ws = ProbeWs::new("attribution-named");
+    let path = ws.file("liba.rlib", "body");
+    let holder = hold_with_share(&path, SHARE_READ_ONLY);
+
+    let diagnostics = format!(
