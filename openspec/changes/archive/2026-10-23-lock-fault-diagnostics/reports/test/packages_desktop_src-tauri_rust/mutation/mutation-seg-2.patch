+    assert_eq!(report.stdout, b"SUCCESS-OUT", "末次 stdout 不含历史尝试字节");
+    assert_eq!(report.stderr, b"SUCCESS-ERR", "末次 stderr 不含历史尝试字节");
+    assert_eq!(attempt_count(&ws, "count.txt"), 3, "shim 恰拉起 3 次");
+}
