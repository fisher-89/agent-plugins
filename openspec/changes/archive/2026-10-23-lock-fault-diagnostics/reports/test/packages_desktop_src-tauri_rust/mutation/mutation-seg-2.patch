+    let empty_bin = ws.path().join("empty-bin");
+    std::fs::create_dir_all(&empty_bin).expect("创建空 PATH 目录");
+    let original = std::env::var_os("PATH");
+    std::env::set_var("PATH", &empty_bin);
+
+    let holders = lock_holders(std::slice::from_ref(&path));
