+#[test]
+fn rust侧零本地位置表且类型词汇同源() {
+    let source = include_str!("rust.rs");
+    assert!(
+        !source.contains("enum Position"),
+        "`extract/rust.rs` 零本地位置表（D43：唯一落点在 `extract/mod.rs`）"
+    );
+    assert!(
