+    let start = source.find("emit::render_target(").expect("分派调用在案");
+    let call = &source[start..];
+    let end = call.find(')').expect("调用收尾");
+    let call = &call[..end];
+    for (index, argument) in ["&target", "contract", "schema_value", "&meta"]
+        .iter()
