+        foundation::layout::archi_decisions_rel_dir(),
+        api.clone(),
+    ] {
+        assert!(
+            relative.starts_with(&foundation::layout::archi_rel_dir()),
+            "{relative} 应以架构域相对根为前缀（同源派生）"
