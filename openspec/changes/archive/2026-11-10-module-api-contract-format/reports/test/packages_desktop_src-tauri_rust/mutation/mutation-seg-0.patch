+/// 链模型 + 若干同父兄弟模块（共用祖先链声明；兄弟各带 `path`）。
+fn chain_with_siblings(fqn: &str, element_root: &str, siblings: &[(&str, &str)]) -> String {
+    let mut model = declared_chain_model(fqn, element_root);
+    for (sibling, sibling_root) in siblings {
