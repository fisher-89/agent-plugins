+             \"x-common\": {{\"degraded\": true}}}}, \
+             \"Rejected\": {{\"type\": \"object\", \"x-common\": {{\"degraded\": true}}}}, \
+             \"Plain\": {{\"type\": \"object\"}}}}\n```\n"
+        ),
+    );
+    temp.write("src/marked/lib.rs", "pub fn f() {}\n");
