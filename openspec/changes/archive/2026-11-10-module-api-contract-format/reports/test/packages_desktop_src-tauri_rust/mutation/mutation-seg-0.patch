+        "# {fqn}\n\n## 操作\n\n### file_stem\n\n```json api-op\n\
+         {{\"params\": [{{\"name\": \"timestamp\", \"schema\": {{\"type\": \"string\"}}}}], \
+         \"returns\": {{\"type\": \"integer\"}}}}\n```\n"
+    )
+}
