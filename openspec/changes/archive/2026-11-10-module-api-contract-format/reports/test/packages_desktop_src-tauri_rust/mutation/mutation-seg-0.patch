+    // 第二形态：同一契约去掉两条标记 → degraded = 0（键仍输出 0，不省略）
+    temp.write_contract(
+        fqn,
+        &format!(
+            "# {fqn}\n\n```json api-types\n{{\"Degraded\": {{\"type\": \"object\"}}, \
+             \"Rejected\": {{\"type\": \"object\"}}, \"Plain\": {{\"type\": \"object\"}}}}\n```\n"
