+             \"Class\": {{\"x-class\": true}}, \
+             \"Variant\": {{\"oneOf\": [{{\"$ref\": \"#/$defs/Alpha\"}}]}}, \
+             \"Choice\": {{\"enum\": [\"a\", \"b\"]}}, \
+             \"Scalar\": {{\"type\": \"integer\"}}, \
+             \"Object\": {{\"type\": \"object\", \"properties\": {{}}}}, \
+             \"Both\": {{\"x-class\": true, \"oneOf\": [{{\"$ref\": \"#/$defs/Alpha\"}}]}}, \
