+                + text.matches("kind_of(target)").count()
+                + text.matches("kind_of(definition)").count()
+                + text.matches("kind_of(nested)").count(),
+            "{file} 内 `kind_of` 只以单点引用形态出现（零本地副本）"
+        );
+        assert!(
+            !text.contains("Value::Null => \"null\""),
+            "{file} 零第二份词表"
+        );
+    }
+}
