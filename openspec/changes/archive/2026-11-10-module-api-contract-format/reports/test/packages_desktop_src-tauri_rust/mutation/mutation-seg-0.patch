+            ("package", "off", "[]".to_owned(), String::new())
+        } else {
+            ("domain", "off", "[]".to_owned(), String::new())
+        };
+        model.push_str(&format!(
+            "[element.\"{prefix}\"]\nkind = \"{kind}\"\ngate = \"{gate}\"\n{api_line}path = {path}\n\n"
+        ));
+    }
+    model
+}
