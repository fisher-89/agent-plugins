+    // 落点②：`$defs` 条目第一层 `properties` 的值（`interface_block` 的方法分流）
+    let field_function = render_types(
+        r#"{"Hooks": {"type": "object", "properties": {"call": {"x-function": {"params": [{"name": "a", "schema": {"type": "string"}}], "returns": {"type": "string"}}}}}}"#,
+    );
