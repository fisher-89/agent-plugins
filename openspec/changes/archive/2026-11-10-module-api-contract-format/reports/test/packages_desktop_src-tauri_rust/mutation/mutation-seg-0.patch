+[package]
+name = "archi-api-gen"
+version = "0.1.0"
+edition = "2021"
+
+# 模块 API 契约生成器（CLI 唯一写盘面）：`generate` 写四类生成物 / `--check` 读盘比对
+# 零写入 / `bootstrap` 只出 stdout。判定（契约解析 / `$defs` 规则 / 十条判据 / 渲染出
+# 字符串）全部在 `crates/core/archi`，本 crate 零判定逻辑——它存在的唯一理由是
+# 「生成物要写盘」与「工具需要 CLI 入口」。
+#
+# 零依赖面：零 Tauri / 零 store / 零 config / 零 orchestration / 零 workflow / 零
+# infra crate / 零壳 / 零子进程（无 `std::process`）；只经 `cargo run -p archi-api-gen`
+# 驱动，不被 app 依赖（避免 tauri build 拖带工具 bin）。
+[dependencies]
+archi = { workspace = true }
+foundation = { workspace = true }
+serde_json = { workspace = true }
diff --git a/crates/tools/archi-api-gen/src/main.rs b/crates/tools/archi-api-gen/src/main.rs
new file mode 100644
index 000000000000..aeebb54423f3
--- /dev/null
+++ b/crates/tools/archi-api-gen/src/main.rs
@@ -0,0 +1,301 @@
+use std::collections::BTreeSet;
+use std::fs;
+use std::path::{Path, PathBuf};
+use std::process::ExitCode;
+
+use archi::api::paths;
+use archi::api::{self, GeneratedFile};
+
+/// CLI 子命令（封闭四值；未知参数归 `Usage`）。
+#[derive(Debug, Clone, PartialEq, Eq)]
+enum Command {
+    /// 写四类生成物（幂等）
+    Generate,
+    /// 生成到内存后与磁盘比对，零写入
+    Check,
+    /// 输出候选草稿到 stdout
+    Bootstrap(String),
+    /// 打印用法并退出 2
+    Usage,
+}
+
+/// 进程退出码（`generate` / `--check` 无差异 → 0；有差异或失败 → 1；用法错 → 2）。
+///
+/// 零子进程：本文件只读 argv 并调库，MUST NOT 派生任何外部进程（无 `Command`、无 shell）。
+fn main() -> ExitCode {
+    let args: Vec<String> = std::env::args().skip(1).collect();
+    let root = repository_root();
+    match run(parse_args(&args), &root) {
+        Ok(code) => ExitCode::from(code as u8),
+        Err(message) => {
+            eprintln!("{message}");
+            ExitCode::FAILURE
+        }
+    }
+}
+
+/// argv → 子命令（`cargo run -p archi-api-gen -- --check` 的第一个 `--` 由 cargo 剥掉）。
+fn parse_args(args: &[String]) -> Command {
+    match args {
+        [first] if first == "generate" => Command::Generate,
+        [first] if first == "--check" || first == "check" => Command::Check,
+        [first, element] if first == "bootstrap" => Command::Bootstrap(element.clone()),
+        _ => Command::Usage,
+    }
+}
+
+/// 子命令实现体（离 `main` 便于 tempdir 驱动；返回退出码）。
+pub(crate) fn run(command: Command, root: &Path) -> Result<i32, String> {
+    match command {
+        Command::Generate => {
+            let files = collect(root)?;
+            for file in &files {
+                write(root, file)?;
+            }
+            println!("{} 份生成物已写入", files.len());
+            Ok(0)
+        }
+        Command::Check => {
+            let expected = collect(root)?;
+            match differences(root, &expected) {
+                Report {
+                    mismatched,
+                    orphaned,
+                    missing,
+                } if mismatched.is_empty() && orphaned.is_empty() && missing.is_empty() => Ok(0),
+                report => {
+                    println!("{}", report.to_json());
+                    Ok(1)
+                }
+            }
+        }
+        Command::Bootstrap(element) => {
+            let text = api::bootstrap(root, &element).map_err(|error| error.message())?;
+            println!("{text}");
+            Ok(0)
+        }
+        Command::Usage => {
+            println!(
+                "用法：archi-api-gen <子命令>\n\
+                 \x20 generate            写四类生成物（schema.json / INDEX.toml / .i.rs / .i.ts）\n\
+                 \x20 --check             读盘比对，零写入；有差异即非零退出并列清单\n\
+                 \x20 bootstrap <元素>    输出契约草稿到 stdout（不写盘）"
+            );
+            Ok(2)
+        }
+    }
+}
+
+/// 观察根锚定：从当前工作目录向上取**最近的、含架构域的祖先**（契约与模型都住在
+/// 架构域里，故这是唯一有意义的锚）；一个都不命中 → 退化为当前目录。
+///
+/// 不做行内路径字面量：判据本身经 [`foundation::layout`] 派生（脚本可从
+/// `packages/desktop` 起手调用，无需在脚本里写 `cd ../..`）。
+fn repository_root() -> PathBuf {
+    let current = std::env::current_dir().unwrap_or_else(|_| PathBuf::from("."));
+    let mut candidate = current.as_path();
+    loop {
+        if foundation::layout::archi_dir(candidate).is_dir() {
+            return candidate.to_path_buf();
+        }
+        match candidate.parent() {
+            Some(parent) => candidate = parent,
+            None => return current,
+        }
+    }
+}
+
+/// 应生成物清单（元素表来自当前 root 的模型）。
+fn collect(root: &Path) -> Result<Vec<GeneratedFile>, String> {
+    let elements = model_elements(root)?;
+    let snapshot = api::load_contracts(root, &elements).map_err(|error| error.message())?;
+    api::render_all(root, &snapshot).map_err(|error| error.message())
+}
+
+/// 单份生成物写盘（父目录经 [`foundation::layout`] 派生的契约目录，或按目标路径自身
+/// 的父目录创建——两者都已在 `archi` 侧算好，本层零拼装）。
+///
+/// **第二层拦截（限根）**：`archi::api::paths` 已做形态校验（D33），本层再以
+/// `starts_with(root)` 复核目标确实落在观察根之下——写盘是本工具唯一的危险动作
+/// （建目录 + 写文件可触达任意路径），两层判据的交叉验证是 `docs::resolved_within`
+/// 的既有先例（判据 + join 后复核，任一层失效另一层仍拦得住）。
+fn write(root: &Path, file: &GeneratedFile) -> Result<(), String> {
+    if !file.path.starts_with(root) {
+        return Err(format!(
+            "生成物目标越出观察根（{} 不在 {} 之下）——拒绝写盘",
+            file.path.display(),
+            root.display()
+        ));
+    }
+    if let Some(parent) = file.path.parent() {
+        fs::create_dir_all(parent)
+            .map_err(|error| format!("目录创建失败（{}）：{error}", parent.display()))?;
+    }
+    fs::write(&file.path, &file.content)
+        .map_err(|error| format!("写入失败（{}）：{error}", file.path.display()))
+}
+
+/// 磁盘 vs 应生成的三类偏差。
+struct Report {
+    /// 内容不符（文件在盘但字节不同）
+    mismatched: Vec<String>,
+    /// 应删未删（盘上存在但不在应生成集，且文件名匹配生成物命名规则）
+    orphaned: Vec<String>,
+    /// 应生成未生成
+    missing: Vec<String>,
+}
+
+impl Report {
+    /// `--check` 的 JSON 差异清单（stdout 单行，便于脚本解析）。
+    fn to_json(&self) -> String {
+        serde_json::json!({
+            "mismatched": self.mismatched,
+            "orphaned": self.orphaned,
+            "missing": self.missing,
+        })
+        .to_string()
+    }
+}
+
+/// 比对（零写入）。
+fn differences(root: &Path, expected: &[GeneratedFile]) -> Report {
+    let mut mismatched: Vec<String> = Vec::new();
+    let mut missing: Vec<String> = Vec::new();
+    let mut expected_paths: BTreeSet<PathBuf> = BTreeSet::new();
+    for file in expected {
+        expected_paths.insert(file.path.clone());
+        match fs::read_to_string(&file.path) {
+            Ok(actual) => {
+                if actual != file.content {
+                    mismatched.push(archi::display(root, &file.path));
+                }
+            }
+            Err(_) => missing.push(archi::display(root, &file.path)),
+        }
+    }
+    let mut orphaned: Vec<String> = Vec::new();
+    for path in generated_files_on_disk(root) {
+        if expected_paths.contains(&path) {
+            continue;
+        }
+        orphaned.push(archi::display(root, &path));
+    }
+    Report {
+        mismatched,
+        orphaned,
+        missing,
+    }
+}
+
+/// 盘上现有的三类生成物（D21 的「应删未删」取自这里）：
+///
+/// 1. 契约目录内 `*.schema.json` 与 `INDEX.toml`（递归）；
+/// 2. **元素根同级**的 `*.i.rs` / `*.i.ts`——元素根可在仓库任意深度
+///    （`crates/infra/archi` → `crates/infra/archi.i.rs`、`views/welcome-view.tsx` →
+///    `views/welcome-view.tsx.i.ts`），故 MUST 全树递归找，只看仓库顶层会漏掉
+///    `crates/**`、`src/**` 这些真实落点；
+/// 3. 与 (2) 同一条命名判据，出现在契约目录之外的任何位置也算（生成物的**命名**
+///    即身份，与落点无关）。
+///
+/// 递归跳过构建产物目录（`target` / `node_modules` / `dist` / `build` / `.git`）：
+/// 它们不是生成物的合法落点，遍历它们只增加成本且会误报无关同名文件。
+fn generated_files_on_disk(root: &Path) -> Vec<PathBuf> {
+    let mut found: Vec<PathBuf> = Vec::new();
+    let api_dir = paths::directory(root);
+    let index = paths::index_path(root);
+    walk(&api_dir, &mut |path| {
+        let Some(name) = path.file_name().and_then(|name| name.to_str()) else {
+            return false;
+        };
+        if name.ends_with(".schema.json") || path == index {
+            found.push(path.to_path_buf());
+        }
+        false
+    });
+    walk_modules(root, Path::new(""), 0, &mut found);
+    found.sort();
+    found.dedup();
+    found
+}
+
+/// 生成物命名判据（`*.i.rs` / `*.i.ts`）：命名即身份，与落点深度无关。
+fn is_generated_module_file(path: &Path) -> bool {
+    path.file_name()
+        .and_then(|name| name.to_str())
+        .is_some_and(|name| name.ends_with(".i.rs") || name.ends_with(".i.ts"))
+}
+
+/// 全树找元素根同级的生成物（递归、符号链接不跟随、构建产物目录剪枝、深度上限防环）。
+fn walk_modules(dir: &Path, relative: &Path, depth: usize, found: &mut Vec<PathBuf>) {
+    if depth > MAX_MODULE_WALK_DEPTH {
+        return;
+    }
+    let Ok(reader) = fs::read_dir(dir) else {
+        return;
+    };
+    for entry in reader.flatten() {
+        let path = entry.path();
+        let Ok(metadata) = fs::symlink_metadata(&path) else {
+            continue;
+        };
+        if metadata.is_symlink() {
+            continue;
+        }
+        let child = relative.join(entry.file_name());
+        if metadata.is_dir() {
+            let name = child
+                .file_name()
+                .and_then(|name| name.to_str())
+                .unwrap_or("");
+            if SKIPPED_DIRECTORIES.contains(&name) {
+                continue;
+            }
+            walk_modules(&path, &child, depth + 1, found);
+            continue;
+        }
+        if is_generated_module_file(&path) {
+            found.push(path);
+        }
+    }
+}
+
+/// 目录递归（符号链接不跟随；回调返回 `true` 即提前结束）。
+fn walk(directory: &Path, visit: &mut impl FnMut(&Path) -> bool) {
+    let Ok(reader) = fs::read_dir(directory) else {
+        return;
+    };
+    for entry in reader.flatten() {
+        let path = entry.path();
+        let Ok(metadata) = fs::symlink_metadata(&path) else {
+            continue;
+        };
+        if metadata.is_symlink() {
+            continue;
+        }
+        if metadata.is_dir() {
+            walk(&path, visit);
+            continue;
+        }
+        if visit(&path) {
+            return;
+        }
+    }
+}
+
+/// 递归遍历的跳过目录（构建产物 / 依赖 / 版本库元数据——生成物不落其中）。
+const SKIPPED_DIRECTORIES: [&str; 5] = ["target", "node_modules", "dist", "build", ".git"];
+
+/// 递归深度上限（防环；仓库内元素根最深也在十级以内）。
+const MAX_MODULE_WALK_DEPTH: usize = 24;
+
+/// 当前 root 的模型元素表（生成器的输入面；模型目录缺席 → 空表）。
+fn model_elements(root: &Path) -> Result<Vec<archi::dto::ArchiElement>, String> {
+    archi::dto::graph_view(root)
+        .map(|graph| graph.elements)
+        .map_err(|error| {
+            format!("模型读取失败（生成器的输入面）：{error}；先修好模型再重跑 generate")
+        })
+}
+
+#[cfg(test)]
+mod main_test;
diff --git a/crates/tools/archi-api-gen/src/main_test.rs b/crates/tools/archi-api-gen/src/main_test.rs
new file mode 100644
index 000000000000..327895944bfc
--- /dev/null
+++ b/crates/tools/archi-api-gen/src/main_test.rs
@@ -0,0 +1,1276 @@
+use std::fs;
+use std::path::{Path, PathBuf};
+use std::sync::atomic::{AtomicU64, Ordering};
+
+use super::{parse_args, run, Command};
+
+// ---------------------------------------------------------------------------
+// 真实临时目录（无 dev-dependency，故用 std 自建）
+// ---------------------------------------------------------------------------
+
+static COUNTER: AtomicU64 = AtomicU64::new(0);
+
+struct TempDir(PathBuf);
+
+impl TempDir {
+    fn new(tag: &str) -> Self {
+        let unique = COUNTER.fetch_add(1, Ordering::Relaxed);
+        let dir = std::env::temp_dir().join(format!(
+            "archi-api-gen-test-{}-{}-{}",
+            std::process::id(),
+            unique,
+            tag
+        ));
+        let _ = fs::remove_dir_all(&dir);
+        fs::create_dir_all(&dir).expect("创建临时目录失败");
+        TempDir(dir)
+    }
+
+    fn root(&self) -> &Path {
+        &self.0
+    }
+
+    fn write(&self, relative: &str, content: &str) {
+        let path = self.0.join(relative);
+        if let Some(parent) = path.parent() {
+            fs::create_dir_all(parent).expect("创建父目录失败");
+        }
+        fs::write(&path, content).expect("写文件失败");
+    }
+
+    fn read(&self, relative: &str) -> Option<String> {
+        fs::read_to_string(self.0.join(relative)).ok()
+    }
+
+    fn exists(&self, relative: &str) -> bool {
+        self.0.join(relative).exists()
+    }
+
+    /// 全量字节快照（零写入对拍）。
+    fn snapshot(&self) -> Vec<(String, Vec<u8>)> {
+        fn walk(base: &Path, dir: &Path, out: &mut Vec<(String, Vec<u8>)>) {
+            let Ok(read) = fs::read_dir(dir) else {
+                return;
+            };
+            for entry in read.flatten() {
+                let path = entry.path();
+                if path.is_dir() {
+                    walk(base, &path, out);
+                    continue;
+                }
+                let relative = path
+                    .strip_prefix(base)
+                    .expect("相对路径")
+                    .to_string_lossy()
+                    .replace('\\', "/");
+                out.push((relative, fs::read(&path).expect("读文件失败")));
+            }
+        }
+        let mut entries = Vec::new();
+        walk(&self.0, &self.0, &mut entries);
+        entries.sort();
+        entries
+    }
+}
+
+impl Drop for TempDir {
+    fn drop(&mut self) {
+        let _ = fs::remove_dir_all(&self.0);
+    }
+}
+
+// ---------------------------------------------------------------------------
+// 夹具：模型 + 入口 + 契约
+// ---------------------------------------------------------------------------
+
+/// 后端 crate 形态元素的 FQN（试点）。
+const CRATE_FQN: &str = "App.Backend.Core.Archi";
+
+/// 前端单文件形态元素的 FQN。
+const TS_FQN: &str = "App.Frontend.Views.Welcome";
+
+/// 契约 md 内容（1 op + 1 类型；H1 = `fqn`）。
+fn contract_markdown(fqn: &str) -> String {
+    format!(
+        "# {fqn}\n\n## 职能\n\n正文。\n\n## 操作\n\n### file_stem\n\n```json api-op\n\
+         {{\"params\": [{{\"name\": \"timestamp\", \"schema\": {{\"type\": \"string\"}}}}], \
+         \"returns\": {{\"type\": \"string\"}}}}\n```\n\n## 类型\n\n```json api-types\n\
+         {{\"LocalArchiCheck\": {{\"type\": \"object\", \"properties\": {{}}}}}}\n```\n"
+    )
+}
+
+/// 落一套可生成的后端 crate 元素（模型 + `src/lib.rs` + 契约）。
+fn stage_crate(temp: &TempDir) {
+    temp.write(
+        ".dev-team/architecture/models/01-test.toml",
+        "[element.\"App\"]\nkind = \"package\"\ngate = \"off\"\npath = []\n\n\
+         [element.\"App.Backend\"]\nkind = \"domain\"\ngate = \"off\"\npath = []\n\n\
+         [element.\"App.Backend.Core\"]\nkind = \"domain\"\ngate = \"off\"\npath = []\n\n\
+         [element.\"App.Backend.Core.Archi\"]\nkind = \"module\"\ngate = \"off\"\n\
+         path = [\"crates/core/archi/\"]\n",
+    );
+    temp.write(
+        "crates/core/archi/src/lib.rs",
+        "pub fn file_stem(timestamp: &str) -> String { String::new() }\n",
+    );
+    temp.write(
+        ".dev-team/architecture/api/Core/App.Backend.Core.Archi.md",
+        &contract_markdown(CRATE_FQN),
+    );
+}
+
+/// 落一套前端元素（模型 + 入口 + 契约）。
+///
+/// 入口文件落在 `<root>/index.ts`（目录形态）而非 `<root>` 本身：`paths::entry_form` 的
+/// 四分支按「盘上命中哪个入口文件」判形态，前端元素的 `<root>` 若自带 `.tsx` 后缀，四
+/// 分支的候选串（`<root>.ts` 等）结构上不可能命中——D41 因此规定「拿不到入口 ⇒ 该契约
+/// 不产 `.i.*`」。本装置取可命中的目录形态，使 `.i.ts` 落点仍为
+/// `views/welcome-view.tsx.i.ts`（`<root>` 同级、`<root>` 逐字不变）。
+fn stage_ts(temp: &TempDir) {
+    temp.write(
+        ".dev-team/architecture/models/02-test.toml",
+        "[element.\"App\"]\nkind = \"package\"\ngate = \"off\"\npath = []\n\n\
+         [element.\"App.Frontend\"]\nkind = \"domain\"\ngate = \"off\"\npath = []\n\n\
+         [element.\"App.Frontend.Views\"]\nkind = \"domain\"\ngate = \"off\"\npath = []\n\n\
+         [element.\"App.Frontend.Views.Welcome\"]\nkind = \"module\"\ngate = \"off\"\n\
+         path = [\"views/welcome-view.tsx\"]\n",
+    );
+    temp.write(
