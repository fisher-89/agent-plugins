+/// 异常（gate b，AC-3）：`api-types` 键 `T` 而 `schema["$defs"]` 无 `T` → `Err` 且
+/// 逐名点出；反方向（`$defs` 超集）→ `Ok`（规则是 ⊆，单向）。
+#[test]
+fn verify的gate_b类型缺定义() {
+    let with_types = parse(
+        &format!(
+            "# {FQN}\n\n```json api-types\n{{\"T\": {{\"type\": \"object\"}}, \
+             \"U\": {{\"type\": \"object\"}}}}\n```\n"
