+++ b/crates/core/archi/tests/corpus/drift/api-mismatch/models/01-app.toml
@@ -0,0 +1,15 @@
+# 契约判据语料：`apiSignatureMismatch` 非空金样（AC-8 新增）。
+#
+# 契约声明 `file_stem` 返回 `integer`，代码实现返回 `String` → 归一后不等 →
+# `apiSignatureMismatch` 一条；契约面 MUST NOT 进 `status` 推导（既有 `errors` /
+# `warnings` / `suppressed` / `observations` 全空，`status = clean`）。
+#
+# `App` 为容器元素（`path = []`）——容器天然无入口，故不进 `apiEntryMissing`。
+[element."App"]
+kind = "package"
+gate = "off"
+
+[element."App.Mod"]
+kind = "module"
+gate = "warn"
+path = ["./src/mod/"]
diff --git a/crates/core/archi/tests/corpus/drift/api-mismatch/repo/src/mod/mod.rs b/crates/core/archi/tests/corpus/drift/api-mismatch/repo/src/mod/mod.rs
new file mode 100644
index 000000000000..f8e729f35135
--- /dev/null
+++ b/crates/core/archi/tests/corpus/drift/api-mismatch/repo/src/mod/mod.rs
@@ -0,0 +1,6 @@
+pub fn file_stem(timestamp: &str) -> String {
+    timestamp
+        .chars()
+        .filter(|character| character.is_ascii_digit())
+        .collect()
+}
