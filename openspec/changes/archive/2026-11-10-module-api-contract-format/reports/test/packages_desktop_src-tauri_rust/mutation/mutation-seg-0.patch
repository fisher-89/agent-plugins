+    // 行为面：四类 Rust 类型归一后落到 `schema_type` 的同一批逻辑变体
+    let source_text =
+        "pub fn f(a: &str, b: i64, c: bool, d: Vec<u8>) -> Option<String> {\n    None\n}\n";
+    let symbols = extract(source_text);
+    let symbol = find(&symbols, "f");
