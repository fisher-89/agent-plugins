+        }
+
+        // ② 签名自证串带完整类型（不是裸 `^pub fn render\(` 计数）
+        assert!(
+            source.contains(
+                "pub fn render(contract: &Contract, schema: &Value, meta: &ApiMeta, target: &EmitTarget) -> String"
+            ),
+            "`{path}` 的签名自证串带完整类型（钉住「四参 + `target` 末位 + 返回 `String`」）"
