+    let entry = "crates/infra/archi/src/lib.rs";
+    let entry_dir = entry
+        .rsplit_once('/')
+        .map(|(parent, _)| parent)
+        .expect("入口目录");
+    let correct = lexical_normalize(&format!(
+        "{entry_dir}/{}",
