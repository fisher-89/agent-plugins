+            "[element.\"App.Core.E{index:02}\"]\nkind = \"module\"\ngate = \"warn\"\npath = [\"src/e{index:02}/\"]\n\n"
+        ));
+        write(
+            temp.path(),
+            &format!("src/e{index:02}/src/lib.rs"),
