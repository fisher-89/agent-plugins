+#[test]
+fn has_error_tier只看档位() {
+    assert!(
+        has_error_tier(&[finding_of(ArchiApiFindingKind::DocNotFound, Some("App.A"))]),
+        "error 档一条即真"
+    );
+    assert!(
+        !has_error_tier(&[
+            finding_of(ArchiApiFindingKind::DocMissing, Some("App.A")),
+            finding_of(ArchiApiFindingKind::ApiDocMissing, Some("App.B")),
