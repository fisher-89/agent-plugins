+#[test]
+fn extract产名import_type照产() {
+    assert_eq!(
+        names_of("src/a.ts", "import type { A } from 'x';\n"),
+        vec![("x".to_owned(), true, names(&["A"]))],
+        "type-only 照产名"
+    );
+}
+
+/// 正向：`export { A } from` / `export { A as B } from` / `export type { A } from` →
