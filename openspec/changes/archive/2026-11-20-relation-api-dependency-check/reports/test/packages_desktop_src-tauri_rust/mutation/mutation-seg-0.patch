+    assert_eq!(
+        names_of("src/a.ts", "import { A } from 'x';\nimport X from 'x';\n",)
+            .iter()
+            .map(|fact| (fact.0.as_str(), fact.2.clone()))
+            .collect::<Vec<(&str, Vec<String>)>>(),
