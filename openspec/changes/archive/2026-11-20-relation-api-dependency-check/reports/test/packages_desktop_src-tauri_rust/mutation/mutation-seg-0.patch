+#[test]
+fn extract产名export_from取local() {
+    assert_eq!(
+        names_of("src/index.ts", "export { A } from 'x';\n"),
+        vec![("x".to_owned(), false, names(&["A"]))],
+        "re-export 与 import 同取法"
+    );
+    assert_eq!(
+        names_of("src/index.ts", "export { A as B } from 'x';\n"),
+        vec![("x".to_owned(), false, names(&["A"]))],
