+/// 正向：全匹配 / 少一项 / 多一项 / 两侧各有差四形态逐值（两桶同序字典序）。
+#[test]
+fn api_buckets四形态() {
+    assert_eq!(
+        api_buckets(&strings(&["A", "B"]), &strings(&["B", "A"])),
+        (Vec::new(), Vec::new()),
+        "全匹配 ⇒ 两桶皆空"
+    );
+    assert_eq!(
+        api_buckets(&strings(&["A", "B"]), &strings(&["A"])),
+        (Vec::new(), strings(&["B"])),
+        "声明多一项 ⇒ declared ∖ used"
+    );
+    assert_eq!(
+        api_buckets(&strings(&["A"]), &strings(&["A", "C"])),
+        (strings(&["C"]), Vec::new()),
+        "事实多一项 ⇒ used ∖ declared"
+    );
+    assert_eq!(
+        api_buckets(&strings(&["A", "B"]), &strings(&["B", "D"])),
+        (strings(&["D"]), strings(&["A"])),
+        "两侧各有差 ⇒ 两桶各自字典序"
+    );
+}
