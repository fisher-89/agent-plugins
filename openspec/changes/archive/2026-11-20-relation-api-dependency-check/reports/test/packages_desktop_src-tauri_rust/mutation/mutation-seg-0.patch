+                ),
+                Some(span),
+            ));
+            continue;
+        }
+        if name.contains("::") {
+            diagnostics.push(diagnostic(
+                format!("关系 {from} → {to} 的 apis 项 \"{name}\" 含 `::`：只写名字，不写限定路径"),
+                Some(span),
+            ));
+            continue;
+        }
+        if !seen.insert(name) {
+            diagnostics.push(diagnostic(
+                format!("关系 {from} → {to} 的 apis 项 \"{name}\" 重复：不重复（不做静默去重）"),
+                Some(span),
+            ));
+            continue;
+        }
     }
+    diagnostics
 }
 
