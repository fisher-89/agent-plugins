+/// 边构造器（`specifier` / `type_only` / `inline_ignore` 取固定值，只用名字面）。
+fn edge(from: &str, to: &str, file: &str, line: u32, names: &[&str]) -> DependencyEdge {
+    DependencyEdge {
+        from: from.to_owned(),
+        to: to.to_owned(),
+        file: file.to_owned(),
+        line,
+        specifier: "./x".to_owned(),
+        type_only: false,
+        inline_ignore: None,
+        names: names.iter().map(|name| (*name).to_owned()).collect(),
+    }
+}
