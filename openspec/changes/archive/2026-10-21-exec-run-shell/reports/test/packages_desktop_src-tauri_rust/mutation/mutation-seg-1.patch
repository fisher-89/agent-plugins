+        let ws = SpawnWs::new("merge-big");
+        let window = SpawnWindow::enter("stryker-merge-big");
+        window.install_npx();
+        window.set_out(&format!("{stdout_line}\n"));
+        window.set_err(&format!("{stderr_line}\n"));
