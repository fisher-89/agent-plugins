+/// 缺省形态零漂移（异常，回归）：未调两条 builder 的既有 open / 配置校验用例
+/// 零改动全绿（字段面扩张不改变既有行为）——本用例只锚「缺省仍可分发」。
+#[test]
+fn 未调ask两条builder时门面默认形态零漂移() {
+    let facade = EngineFacade::new();
+    assert!(
+        facade
+            .runner_for(EngineKind::Sdk, EngineConfig::empty())
+            .is_ok(),
+        "缺省形态仍可分发（ask 字段扩张不改既有构造）"
+    );
+}
