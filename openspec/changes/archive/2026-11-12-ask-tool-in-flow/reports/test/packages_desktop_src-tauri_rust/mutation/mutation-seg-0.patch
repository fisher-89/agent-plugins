+    let own = source_of("src/sdk/mount.rs");
+    let code_only = own
+        .lines()
+        .filter(|line| {
+            let trimmed = line.trim_start();
+            !(trimmed.starts_with("///") || trimmed.starts_with("//"))
+        })
+        .collect::<Vec<_>>()
+        .join("\n");
+
+    for forbidden in [
+        "ask.is_some() &&",
+        "&& injections.ask",
+        "&& injections.finish",
