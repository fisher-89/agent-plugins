+
+    let properties = schema["properties"].as_object().expect("properties 对象");
+    let mut keys: Vec<&str> = properties.keys().map(String::as_str).collect();
+    keys.sort_unstable();
+    assert_eq!(keys, vec!["options", "question"], "属性键集恰两键");
