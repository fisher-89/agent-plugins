+        );
+    }
+    assert!(
+        code_only.contains("if let Some(mode) = injections.ask"),
+        "ask 分支只读 injections.ask"
+    );
+    assert!(
+        code_only.contains("if let Some(spec) = injections.finish"),
+        "finish 分支只读 injections.finish"
+    );
+}
