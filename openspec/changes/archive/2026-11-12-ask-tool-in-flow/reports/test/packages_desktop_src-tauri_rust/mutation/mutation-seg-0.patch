+
+    // None 形态：Flow 档无 port → is_error 防御臂（不悬挂）
+    let env_none = DualEnv::new("ask-port-shape-None");
+    let stores_none = env_none.stores();
+    let stub_none = crate::ask_scripted_provider::AskScriptedProvider::new(
+        "compose-flow-none",
