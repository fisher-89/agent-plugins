+        "日志不是数据：dev 数据根零写入"
+    );
+}
+
+#[test]
+fn append_ignored_env_io失败静默不阻断prod启动() {
+    let dir = tmp("ignored-io");
+    let home = dir.path();
+    fs::write(home.join(PROD_DIR), b"occupied").expect("创建占位文件失败");
+
+    append_ignored_env(home); // 不 panic、返回 ()
+    assert!(
+        home.join(PROD_DIR).is_file(),
