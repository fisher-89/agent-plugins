specification {
    element system
    element person
    element container
}

system AuthService {
    description "Authentication service"
    tags "security", "core", "critical"
}

system NotificationService {
    description "Email and push notifications"
    tags "core", "async"
}

person Admin {
    description "System administrator"
    tags "internal", "admin"
}

person Customer {
    description "Registered customer"
    tags "external"
}

container ApiGateway {
    description "API gateway layer"
    tags "infrastructure", "critical"
}
