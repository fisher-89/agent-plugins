+    let one = dto::graph_diagnostics_error(&[diagnostic(DiagnosticKind::Cycle, "01-a.toml", 7)]);
+    assert!(one.contains("模型结构错（共 1 条）："), "条数 1：{one}");
+    assert!(one.contains("cycle @ 01-a.toml:7"), "位置形态：{one}");
+
+    let sample = [
