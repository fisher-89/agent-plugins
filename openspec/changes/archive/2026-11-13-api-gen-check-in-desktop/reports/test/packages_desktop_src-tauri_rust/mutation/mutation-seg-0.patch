+         \"returns\": {{\"type\": \"integer\"}}}}\n```\n\n## 类型\n\n```json api-types\n\
+         {{\"LocalCheck\": {{\"type\": \"object\", \"properties\": {{}}}}}}\n```\n"
+    )
+}
