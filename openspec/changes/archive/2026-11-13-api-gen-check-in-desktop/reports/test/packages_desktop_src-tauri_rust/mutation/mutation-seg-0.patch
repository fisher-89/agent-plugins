+    assert!(!header.contains("六命令"), "文件头零旧口径「六命令」");
+}
+
+/// 边界（边界 / str 映射）：`root` 超长（>1000 chars）/ 含空格 / 非 ASCII / emoji → 落
+/// `Result` 内不 panic（空串形态已由 root 校验行覆盖）。
+#[test]
+fn api命令root字符串边界() {
+    let cases: [String; 4] = [
+        std::env::temp_dir()
+            .join("x".repeat(1100))
+            .to_string_lossy()
+            .into_owned(),
+        std::env::temp_dir()
+            .join("archi cmd with space")
+            .to_string_lossy()
+            .into_owned(),
+        std::env::temp_dir()
+            .join("架构-命令-根")
+            .to_string_lossy()
+            .into_owned(),
+        std::env::temp_dir()
+            .join("archi-cmd-🎯")
+            .to_string_lossy()
+            .into_owned(),
+    ];
+    for root in cases {
+        assert!(
+            archi_api_check(root.clone()).is_err(),
+            "不存在的 root 应 Err（形态边界不 panic）：{root}"
+        );
+        assert!(
+            archi_api_generate(root.clone()).is_err(),
+            "不存在的 root 应 Err（形态边界不 panic）：{root}"
+        );
+    }
 }
