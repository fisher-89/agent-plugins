+    let after = archi_api_check(temp.root()).expect("复检应 Ok");
+    assert!(after.mismatched.is_empty(), "复检零不符");
+    assert!(after.orphaned.is_empty(), "复检零孤儿");
+    assert!(after.missing.is_empty(), "复检零缺失");
