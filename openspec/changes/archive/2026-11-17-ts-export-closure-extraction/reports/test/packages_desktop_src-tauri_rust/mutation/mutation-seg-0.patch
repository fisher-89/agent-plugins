+#[test]
+fn 闭包辅助保持私有() {
+    let source = include_str!("mod.rs");
+    for private in [
+        "pub struct Closure",
+        "pub fn collect",
+        "pub fn reexport_ok",
+        "pub fn export_target",
+        "pub fn visited_key",
+        "pub fn dedupe",
