+    );
+    let block = source
+        .split_once("enum ExportedItem<'a, 'b> {")
+        .expect("`ExportedItem` 定义在案")
+        .1
+        .split_once("\n}")
+        .expect("枚举收口")
+        .0;
+    let variants: Vec<&str> = block
+        .lines()
+        .map(str::trim)
+        .filter(|line| !line.is_empty() && !line.starts_with("//"))
+        .map(|line| {
+            line.split('(')
+                .next()
+                .unwrap_or(line)
+                .trim_end_matches(',')
+                .trim()
+        })
+        .collect();
+    assert_eq!(
+        variants,
+        vec!["Declaration", "Named", "Star", "None"],
+        "四变体封闭（MUST NOT 扩第五态）"
+    );
+}
