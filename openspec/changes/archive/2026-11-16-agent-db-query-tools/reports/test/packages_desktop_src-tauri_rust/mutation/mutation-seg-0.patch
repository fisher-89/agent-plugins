+
+// ---------------------------------------------------------------------------
+// 装置：内存库 + 人工可核算语料（每格断言可手工对拍）
+// ---------------------------------------------------------------------------
+
+fn workspace_db() -> Database<'static> {
+    native_db::Builder::new()
+        .create_in_memory(workspace_models())
+        .expect("建 workspace 内存库")
+}
+
+fn global_db() -> Database<'static> {
+    native_db::Builder::new()
+        .create_in_memory(global_models())
+        .expect("建全局内存库")
+}
+
+struct PhaseRow {
