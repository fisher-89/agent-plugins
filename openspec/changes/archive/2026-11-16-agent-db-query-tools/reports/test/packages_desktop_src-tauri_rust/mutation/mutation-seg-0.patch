+        let events = drive_loop_turn(&model, turn).await;
+
+        let results = tool_results_of(&events);
+        assert_eq!(results.len(), 1, "恰一条工具结果");
+        assert_eq!(results[0].0, call, "同 id 回灌");
+        assert!(results[0].2, "执行体 Err → is_error");
