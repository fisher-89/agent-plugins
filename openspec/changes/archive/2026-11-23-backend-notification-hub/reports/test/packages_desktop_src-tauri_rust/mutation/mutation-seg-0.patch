+#[test]
+fn 通知表登记行维度为user且计数与写入量一致() {
+    let entry = crate::envelope::entry("notification").expect("注册表应含 notification 行");
+    assert_eq!(entry.dimension, DbDimension::User, "收件箱是 user 维度");
+
+    let env = Env::new("notification-registry");
