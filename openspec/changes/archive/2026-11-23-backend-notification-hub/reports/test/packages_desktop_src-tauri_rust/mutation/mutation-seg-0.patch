+/// 异常（旁路降级）：替身内部吞掉 `deliver` / `retire` → run 终态、落包面与
+/// 返回值零变化（旁路不改业务；`walk_run` 签名与既有返回值语义零变）。
+#[tokio::test]
+async fn walk_run旁路降级时终态与落包面零变化() {
+    let timeline = Arc::new(Mutex::new(Vec::new()));
