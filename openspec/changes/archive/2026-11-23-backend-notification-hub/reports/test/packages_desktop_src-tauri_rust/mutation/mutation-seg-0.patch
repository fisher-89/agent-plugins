+// ---------------------------------------------------------------------------
+// 往返保真
+// ---------------------------------------------------------------------------
+
+#[test]
+fn from_to往返与载荷逐字段相等() {
+    for notification in [
+        event("run:r1:confirm:dev-design"),
+        feedback("uuid-3"),
+        Notification {
