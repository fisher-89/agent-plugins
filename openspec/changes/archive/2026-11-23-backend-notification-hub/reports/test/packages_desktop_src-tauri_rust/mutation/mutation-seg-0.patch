+    let models = global.list_models().expect("清单应成功");
+    let names: Vec<&str> = models.iter().map(|model| model.name.as_str()).collect();
+    assert_eq!(
+        names,
+        vec![
+            "workspace",
+            "agent_provider",
+            "agent_instance",
+            "notification"
