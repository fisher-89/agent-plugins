+    assert_eq!(
+        first_mismatch_index(&names, &ELEMENT_FIELD_NAMES),
+        None,
+        "块内字段面 `{names:?}` 与常量 `{ELEMENT_FIELD_NAMES:?}` 逐位相等"
+    );
+    assert_eq!(
+        names,
+        ELEMENT_FIELD_NAMES.to_vec(),
+        "同序同集（逐位 assert_eq）"
+    );
+    assert_eq!(names.len(), 8, "块内恰八字段（与常量类型元数互证）");
+}
+
+/// 正向：常量恰八项——`[&str; 8]` 的类型元数是编译期锚，运行期断言与源码块计数互证。
