+const RAW_ELEMENT_FIELD_TYPES: [&str; 8] = [
+    "ElementKind",
+    "GateTier",
+    "ApiStatus",
+    "Option<String>",
+    "Vec<",
+    "Option<String>",
+    "Option<String>",
