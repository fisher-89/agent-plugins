+/// 元素对集合（`(from, to)`，按序）。
+fn pairs(entries: &[super::ArchiDriftEntry]) -> Vec<(String, String)> {
+    entries
+        .iter()
+        .filter_map(|entry| match (&entry.from, &entry.to) {
+            (Some(from), Some(to)) => Some((from.clone(), to.clone())),
+            _ => None,
+        })
+        .collect()
+}
