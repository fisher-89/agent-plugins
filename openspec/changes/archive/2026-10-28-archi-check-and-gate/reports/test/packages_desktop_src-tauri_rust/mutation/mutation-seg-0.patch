diff --git a/crates/core/archi/src/scan/exclude.rs b/crates/core/archi/src/scan/exclude.rs
new file mode 100644
index 000000000000..d3216d694a0b
--- /dev/null
+++ b/crates/core/archi/src/scan/exclude.rs
@@ -0,0 +1,105 @@
+//! 排除矩阵：默认七条约定（展开为具体 glob）+ 架构域配置 `exclude` 追加。
+//!
+//! **与工作区 `tests[].excludes` 零耦合**：那是测试执行 scope（可因 e2e 慢而
+//! 排除、因 fixture 需要而包含），与架构扫描范围正交——混用会让调测试范围意外
+//! 改变架构判定面。本文件的排除面 MUST NOT 读取任何工作区配置。
+//!
+//! glob 引擎为 `globset`（无花括号交替方言），故默认约定逐条展开为具体 glob；
+//! `excluded[].rule` 记**命中的具体形态**（spec 场景逐字要求
+//! `rule: "**/*.test.ts"`）。
+
+use globset::{Glob, GlobSet, GlobSetBuilder};
+
+/// 默认排除约定（七条约定 → 13 条具体 glob；逐条标注对应约定）：
+///
+/// 1. `**/*.test.ts` / `**/*.test.tsx` / `**/*.test.js` / `**/*.test.jsx`
+///    —— `**/*.test.{ts,tsx,js,jsx}`（花括号方言，globset 不支持，展开四值）
+/// 2. `**/*.spec.ts` / `**/*.spec.tsx` / `**/*.spec.js` / `**/*.spec.jsx`
+///    —— `**/*.spec.{ts,tsx,js,jsx}`（同上）
+/// 3. `**/__tests__/**` —— 测试目录
+/// 4. `**/*_test.rs` —— Rust 单元测试文件（`src/**` 内联惯例）
+/// 5. `**/tests/**` —— 集成测试目录
+/// 6. `**/fixtures/**` —— 测试装置
+/// 7. `**/__mocks__/**` —— mock 目录
+///
+/// **排除的语义理由**：测试文件天然跨元素引用被测代码，纳入扫描会让每个
+/// `foo.test.ts` 对 `foo.ts` 产生一条「未声明依赖」——那不是架构问题，是测试的
+/// 固有形状。
+pub const DEFAULT_EXCLUDE_RULES: &[&str] = &[
+    // 1. `**/*.test.{ts,tsx,js,jsx}`
+    "**/*.test.ts",
+    "**/*.test.tsx",
+    "**/*.test.js",
+    "**/*.test.jsx",
+    // 2. `**/*.spec.{ts,tsx,js,jsx}`
+    "**/*.spec.ts",
+    "**/*.spec.tsx",
+    "**/*.spec.js",
+    "**/*.spec.jsx",
+    // 3. 测试目录
+    "**/__tests__/**",
+    // 4. Rust 单元测试文件
+    "**/*_test.rs",
+    // 5. 集成测试目录
+    "**/tests/**",
+    // 6. 测试装置
+    "**/fixtures/**",
+    // 7. mock 目录
+    "**/__mocks__/**",
+];
+
+/// 编译一次复用的排除矩阵：默认规则在前、配置追加在后（**追加不替换**）；规则
+/// 原文表与 `GlobSet` 命中下标一一对齐（最小下标优先 = 默认规则优先，确定性）。
+///
+/// 非 `Clone`：编译产物只构建一次（`scan` 入口单点）。
+pub struct ExcludeSet {
+    set: GlobSet,
+    /// 规则原文（下标与 `GlobSet` 编译序对齐）
+    rules: Vec<String>,
+}
+
+impl ExcludeSet {
+    /// 构建排除矩阵：默认约定 + 配置追加。
+    ///
+    /// 配置条目的合法性判据（两条显式 `Err`——配置是声明，拼错必须停给用户）：
+    /// - 无通配符（`*` / `?` / `[`）→ `Err`（目录请写 `src/legacy/**`）；
+    /// - `Glob::new` 失败 → `Err`（附非法条目）。
+    pub fn build(extra: &[String]) -> Result<ExcludeSet, String> {
+        let mut rules: Vec<String> = DEFAULT_EXCLUDE_RULES
+            .iter()
+            .map(|rule| (*rule).to_owned())
+            .collect();
+        for entry in extra {
+            let trimmed = entry.trim();
+            if trimmed.is_empty() {
+                return Err("架构域配置 exclude 含空白条目（文件级 glob 不得为空）".to_owned());
+            }
+            if !trimmed.contains('*') && !trimmed.contains('?') && !trimmed.contains('[') {
+                return Err(format!(
+                    "架构域配置 exclude 条目不是文件级 glob：\"{trimmed}\"（无通配符；目录请写 \
+                     \"{trimmed}/**\" 形态）"
+                ));
+            }
+            rules.push(trimmed.to_owned());
+        }
+        let mut builder = GlobSetBuilder::new();
+        for rule in &rules {
+            let glob = Glob::new(rule)
+                .map_err(|error| format!("架构域排除规则非法：\"{rule}\"（{error}）"))?;
+            builder.add(glob);
+        }
+        let set = builder
+            .build()
+            .map_err(|error| format!("架构域排除规则编译失败：{error}"))?;
+        Ok(ExcludeSet { set, rules })
+    }
+
+    /// 命中判定：返回**命中的规则原文**（最小下标优先 = 默认约定优先，确定性）。
+    pub fn matched(&self, rel_path: &str) -> Option<String> {
+        self.set
+            .matches(rel_path)
+            .into_iter()
+            .min()
+            .map(|index| self.rules[index].clone())
+    }
+}
diff --git a/crates/core/archi/src/scan/exclude_test.rs b/crates/core/archi/src/scan/exclude_test.rs
new file mode 100644
index 000000000000..c8ad61f5b7bf
--- /dev/null
+++ b/crates/core/archi/src/scan/exclude_test.rs
@@ -0,0 +1,289 @@
+//! `scan::exclude` 的单元测试：默认七条约定展开后的逐条命中、配置追加
+//! （非替换）、非法条目的显式 `Err`、命中下标的最小值确定性，以及大小写 /
+//! 分隔符形态的判定面。
+//!
+//! 零 mock：真实 `globset` 编译与匹配（排除语义即被测对象）；零 IO（夹具全是
+//! 路径字面量）。
+
+use globset::Glob;
+
+use super::exclude::{ExcludeSet, DEFAULT_EXCLUDE_RULES};
+
+/// 空配置集（默认规则集的基线夹具）。
+fn default_set() -> ExcludeSet {
+    ExcludeSet::build(&[]).expect("默认排除矩阵必须可编译")
+}
+
+/// 字符串切片 → 配置条目向量（`build` 的入参形态）。
+fn entries(items: &[&str]) -> Vec<String> {
+    items.iter().map(|item| (*item).to_owned()).collect()
+}
+
+// ---------------------------------------------------------------------------
+// 正向：默认七条约定逐条命中
+// ---------------------------------------------------------------------------
+
+/// 正向（AC-1）：七条约定各取一条代表路径 → 恒命中，且七条命中的规则原文互不
+/// 相同（证明是七条不同约定而非同一条兜底）。
+#[test]
+fn 默认七条约定逐条命中且规则互异() {
+    let set = default_set();
+    let probes = [
+        "src/a.test.ts",
+        "src/a.spec.tsx",
+        "src/__tests__/a.ts",
+        "crates/x/src/a_test.rs",
+        "tests/a.ts",
+        "fixtures/a.ts",
+        "__mocks__/a.ts",
+    ];
+    let mut rules: Vec<String> = Vec::new();
+    for probe in probes {
+        let rule = set
+            .matched(probe)
+            .unwrap_or_else(|| panic!("默认排除约定应命中 {probe}"));
+        rules.push(rule);
+    }
+    assert_eq!(rules.len(), 7, "七条探针各一条命中记录");
+
+    // 两条 `*.test.*` / `*.spec.*` 命中不同扩展名形态，故规则原文全量去重后
+    // 至少覆盖 6 类（7 条探针中 `*.test.ts` 与 `*.spec.tsx` 分属两条约定；
+    // `__tests__` / `_test.rs` / `tests` / `fixtures` / `__mocks__` 各一条）。
+    let mut distinct = rules.clone();
+    distinct.sort();
+    distinct.dedup();
+    assert_eq!(
+        distinct.len(),
+        rules.len(),
+        "七条探针的命中规则应互不相同：{rules:?}"
+    );
+}
+
+/// 边界（D8）：默认规则常量是**展开后的具体 glob**——条数与源码一致、每条含
+/// 通配符、逐条可编译、且不含 `globset` 不支持的花括号交替方言。
+#[test]
+fn 默认规则常量为展开后的具体glob() {
+    assert_eq!(
+        DEFAULT_EXCLUDE_RULES.len(),
+        13,
+        "七条约定展开为 4 + 4 + 1 + 1 + 1 + 1 + 1 = 13 条具体 glob"
+    );
+    for rule in DEFAULT_EXCLUDE_RULES {
+        assert!(
+            rule.contains('*') || rule.contains('?') || rule.contains('['),
+            "默认规则应为 glob 形态：{rule}"
+        );
+        assert!(
+            !rule.contains('{') && !rule.contains('}'),
+            "globset 无花括号交替方言，默认规则 MUST NOT 使用：{rule}"
+        );
+        Glob::new(rule).unwrap_or_else(|error| panic!("默认规则 {rule} 不可编译：{error}"));
+    }
+}
+
+/// 边界：`*.test.{ts,tsx,js,jsx}` 与 `*.spec.{ts,tsx,js,jsx}` 八扩展名各自命中
+/// （防花括号展开漏项）。
+#[test]
+fn 扩展名变体全覆盖() {
+    let set = default_set();
+    for extension in ["ts", "tsx", "js", "jsx"] {
+        let test_probe = format!("src/auth/a.test.{extension}");
+        let spec_probe = format!("src/auth/a.spec.{extension}");
+        assert_eq!(
+            set.matched(&test_probe),
+            Some(format!("**/*.test.{extension}")),
+            "{test_probe} 应命中对应扩展名的 test 规则"
+        );
+        assert_eq!(
+            set.matched(&spec_probe),
+            Some(format!("**/*.spec.{extension}")),
+            "{spec_probe} 应命中对应扩展名的 spec 规则"
+        );
+    }
+}
+
+// ---------------------------------------------------------------------------
+// 正向：未命中
+// ---------------------------------------------------------------------------
+
+/// 正向：普通源文件（无配置追加）恒不命中。
+#[test]
+fn 普通源文件不命中() {
+    let set = default_set();
+    for probe in ["src/auth/token.ts", "src/auth/token.tsx", "src/legacy/x.rs"] {
+        assert_eq!(set.matched(probe), None, "{probe} 不应命中默认排除规则");
+    }
+}
+
+// ---------------------------------------------------------------------------
+// 正向 / 边界：配置追加不替换
+// ---------------------------------------------------------------------------
+
+/// 正向（AC-1）：`build(&["src/legacy/**"])` → 配置条目命中的 `rule` 是配置原文，
+/// 同时默认规则的命中面不变（追加，非替换）。
+#[test]
+fn 配置追加不替换默认约定() {
+    let set = ExcludeSet::build(&entries(&["src/legacy/**"])).expect("合法配置条目应可编译");
+    assert_eq!(
+        set.matched("src/legacy/old.ts"),
+        Some("src/legacy/**".to_owned()),
+        "配置目录内的文件命中配置规则原文"
+    );
+    assert_eq!(
+        set.matched("src/a.test.ts"),
+        Some("**/*.test.ts".to_owned()),
+        "默认规则在配置追加后仍逐条生效"
+    );
+}
+
+/// 边界：空配置与默认集逐条行为相同（7 命中 + 未命中集合相等）。
+#[test]
+fn 空配置与默认集等价() {
+    let implicit = default_set();
+    let explicit = ExcludeSet::build(&entries(&[])).expect("空配置合法");
+    let probes = [
+        "src/a.test.ts",
+        "src/a.spec.tsx",
+        "src/__tests__/a.ts",
+        "crates/x/src/a_test.rs",
+        "tests/a.ts",
+        "fixtures/a.ts",
+        "__mocks__/a.ts",
+        "src/auth/token.ts",
+        "src/auth/token.tsx",
+        "src/legacy/x.rs",
+    ];
+    for probe in probes {
+        assert_eq!(
+            implicit.matched(probe),
+            explicit.matched(probe),
+            "{probe} 在空配置与默认集下结果应相同"
+        );
+    }
+}
+
+/// 边界：一条路径同时命中默认规则与配置规则 → 恒取**下标最小**那条（默认规则
+/// 在前），两次调用结果相等（不随内部序漂移）。
+#[test]
+fn 最小下标优先且两次结果相等() {
+    let set = ExcludeSet::build(&entries(&["**/*.test.ts"])).expect("同形配置条目合法");
+    let first = set.matched("src/a.test.ts");
+    let second = set.matched("src/a.test.ts");
+    assert_eq!(first, second, "同一输入两次命中结果必须相等（确定性）");
+    assert_eq!(
+        first,
+        Some("**/*.test.ts".to_owned()),
+        "默认规则下标在前，命中值应为首个同名规则"
+    );
+}
+
+// ---------------------------------------------------------------------------
+// 异常：非法配置条目
+// ---------------------------------------------------------------------------
+
+/// 异常：`Glob::new` 失败的配置条目 → `Err`，文案含该条目原文。
+#[test]
+fn 配置非法glob显式报错() {
+    let error = ExcludeSet::build(&entries(&["src/[legacy"]))
+        .err()
+        .expect("非法 glob 必须 Err");
+    assert!(
+        error.contains("src/[legacy"),
+        "错误文案应含非法条目原文：{error}"
+    );
+}
+
+/// 异常：目录形态 / 空白条目（无通配符）→ 全 `Err`（目录须写 `src/legacy/**`）。
+#[test]
+fn 配置无通配符条目显式报错() {
+    for entry in ["src/legacy", "", "src/"] {
+        let error = ExcludeSet::build(&entries(&[entry]))
+            .err()
+            .unwrap_or_else(|| panic!("无通配符条目 {entry:?} 必须 Err"));
+        assert!(!error.is_empty(), "错误文案非空");
+    }
+}
+
+// ---------------------------------------------------------------------------
+// 边界：超长 / 特殊字符 / 超大配置
+// ---------------------------------------------------------------------------
+
+/// 边界：超长条目（>1000 chars）与含 emoji 的条目——只断言「不 panic + 返回型
+/// 可判」（`Ok` / `Err` 皆合法，取决于 glob 语法）。
+#[test]
+fn 超长与特殊字符条目不panic() {
+    let long = format!("{}*.ts", "a".repeat(1200));
+    let outcome = ExcludeSet::build(&entries(&[long.as_str()]));
+    match outcome {
+        Ok(set) => assert!(
+            set.matched("src/a.ts")
+                .as_deref()
+                .is_none_or(|rule| !rule.is_empty()),
+            "超长条目若编译成功，命中面仍是合法规则原文"
+        ),
+        Err(error) => assert!(!error.is_empty(), "超长条目失败面文案非空"),
+    }
+
+    let error = ExcludeSet::build(&entries(&["src/🎯/[x"]))
+        .err()
+        .expect("含 emoji 的非法条目必须 Err");
+    assert!(!error.is_empty(), "非法条目文案非空");
+}
+
+/// 边界：100 条合法配置 glob → `Ok`；建一次后在 1000 次 `matched()` 中结果稳定
+/// （编译复用，不是每次重编译）。
+#[test]
+fn 超大配置列表并批量复用() {
+    let extra: Vec<String> = (0..100)
+        .map(|index| format!("src/generated{index}/**"))
+        .collect();
+    let set = ExcludeSet::build(&extra).expect("100 条合法 glob 应可编译");
+    let expected = Some("src/generated42/**".to_owned());
+    for _ in 0..1000 {
+        assert_eq!(
+            set.matched("src/generated42/x.ts"),
+            expected,
+            "同一编译产物在批量查询中结果稳定"
+        );
+    }
+}
+
+// ---------------------------------------------------------------------------
+// 边界：路径形态与大小写
+// ---------------------------------------------------------------------------
+
+/// 边界：`./` 前缀与绝对形态的路径与正斜杠形态同结果（设计未归一者以「不 panic +
+/// 结果可判」表达：反斜杠形态只断言可调用）。
+#[test]
+fn 路径形态归一() {
+    let set = default_set();
+    let canonical = set.matched("src/a.test.ts");
+    assert_eq!(canonical, Some("**/*.test.ts".to_owned()), "基线形态");
+    assert_eq!(
+        set.matched("./src/a.test.ts"),
+        canonical,
+        "剥 `./` 前缀后结果相同"
+    );
+    assert_eq!(
+        set.matched("/src/a.test.ts"),
+        canonical,
+        "绝对形态与仓相对形态同结果"
+    );
+    // 反斜杠形态：设计未强制归一，只断言不 panic 且返回型可判。
+    let windows_form = set.matched("src\\a.test.ts");
+    assert!(
+        windows_form.as_deref().is_none_or(|rule| !rule.is_empty()),
+        "反斜杠形态必须可判（不 panic），命中的规则原文非空"
+    );
+}
+
+/// 边界：不做大小写归一——`src/A.Test.TS` 恒 `None`。
+#[test]
+fn 大小写敏感() {
+    let set = default_set();
+    assert_eq!(
+        set.matched("src/A.Test.TS"),
+        None,
+        "词面精确匹配，无大小写归一"
+    );
+}
