+    let mut decided = entry("implement", 1, Verdict::Fail, t(5));
+    decided.decision_session_id = Some("sess-decision-1".to_owned());
+    fake.push(decided);
+
+    // 决策 backtrack 落账（backtrack_to 标记条目为最新）→ 路由直取目标
+    fake.push(backtrack_entry(
