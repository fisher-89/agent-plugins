+/// MUST NOT 含安全软件排除指引 / 占用者 / 被锁文件 / 重试次数措辞。
+pub(crate) fn argv_degrade_note(budget: usize, expanded_len: usize, files: usize) -> String {
+    format!(
+        "展开 {expanded_len} 字符超平台预算 {budget} 字符，已降级为框架自发现（{files} 个测试文件）"
+    )
+}
