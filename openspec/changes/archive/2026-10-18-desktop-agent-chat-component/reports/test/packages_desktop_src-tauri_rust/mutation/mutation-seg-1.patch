+    let transcript = env.query.transcript("ses-s").expect("transcript 应成功");
+    let seqs: Vec<u64> = transcript.iter().map(|event| event.seq).collect();
+    assert_eq!(
+        seqs,
+        vec![0, 2, 7],
+        "seq 升序全量重放（write-through 原子落盘）"
+    );
+}
