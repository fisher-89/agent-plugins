+    seed_sdk_default_instance(&app); // 组合根缺省解析可走通（发起链路半边）
+
+    let summary = change_flow_start_with(
+        app.handle().clone(),
+        discarding_channel(),
+        root.clone(),
+        CHANGE.to_owned(),
+        false,
