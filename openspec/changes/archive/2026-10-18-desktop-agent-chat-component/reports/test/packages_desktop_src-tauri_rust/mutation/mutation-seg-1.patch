+    };
+    assert!(outcome.passed, "shim 退出 0 → passed");
+    assert_eq!(
+        outcome.diagnostics.lines().collect::<Vec<_>>(),
+        ["static-out", "static-err"],
+        "诊断 = 2>&1 交错 stdout"
