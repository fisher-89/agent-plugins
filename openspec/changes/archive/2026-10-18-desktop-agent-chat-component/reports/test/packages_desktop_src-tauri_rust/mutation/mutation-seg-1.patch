+    assert_eq!(record["numTurns"], serde_json::json!(2));
+    assert_eq!(record["costUsd"], serde_json::json!(0.25));
+    assert_eq!(record["durationMs"], serde_json::json!(5_000));
+    assert_eq!(record["error"], serde_json::Value::Null);
