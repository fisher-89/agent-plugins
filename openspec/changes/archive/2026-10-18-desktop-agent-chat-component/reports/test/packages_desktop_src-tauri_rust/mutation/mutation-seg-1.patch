+#[test]
+fn append_sealed密封追加后transcript按seq升序全量重放() {
+    let env = Env::new("append");
+    env.sink
+        .create_session(&new_row("ses-s", "debug", None))
+        .expect("create_session 应成功");
+
+    for seq in [0u64, 2, 7] {
