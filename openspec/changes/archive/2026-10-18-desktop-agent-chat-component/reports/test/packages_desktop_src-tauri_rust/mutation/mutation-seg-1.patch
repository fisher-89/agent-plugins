+#[tokio::test]
+async fn 组合根装配_staticcheck步默认recorded落单一log并回填引用() {
+    use orchestration::port::{ToolCommand, ToolStepOutput, ToolStepPort, ToolStepRequest};
+    use orchestration::steps::LocalToolSteps;
