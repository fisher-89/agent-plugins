+    .await
+    .expect("worktree 在场发起应成功");
+
+    assert_eq!(
+        summary.status,
+        super::ChangeRunStatus::Running,
+        "提前 resolve summary running"
+    );
+
+    // 等待后台收敛（phase-start 落库先于 executor 失败）
+    let control = app.state::<Arc<ChangeFlowControl>>();
+    wait_for("run 终态除名", || {
+        control.snapshot(&root, CHANGE).is_none()
+    });
