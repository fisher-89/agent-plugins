+        .collect();
+    files.sort();
+    assert_eq!(files.len(), 1, "恰一个 workspace 库文件，实际: {files:?}");
+    assert_eq!(
+        files[0],
+        format!(
+            "{}.redb",
+            foundation::identity::workspace_identity_segment(&root)
+        ),
+        "库文件名 = workspace root 身份段派生（非 worktree 路径派生）"
+    );
