+async fn watch前向事件与末拍record后返回ok() {
+    let env = Env::new("watch-forward");
+    let app = app_with_stores(&env);
+    let session_id = "ses-watch-1".to_owned();
+    let streams = streams_of(&app);
+    streams.begin(&session_id);
