+            root.clone(),
+            CHANGE.to_owned(),
+            proceed,
+            sync_specs,
+        )
+        .expect_err("无挂起等待方应 Err");
+        assert_eq!(err, "当前无等待中的 phase 确认");
+        guard.finish(super::ChangeRunStatus::Stopped, None);
+    }
+}
