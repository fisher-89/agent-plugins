+    // id 边界 -1 / i64::MAX：miss → 既有「agent 不存在」Err（id=0 为新建语义）
+    for id in [-1_i64, i64::MAX] {
+        let mut args = fixture_agent("边界更新", AgentEngineKind::Sdk, Some(provider.id));
+        args.id = id;
+        let err = store
+            .upsert_agent_instance(args)
