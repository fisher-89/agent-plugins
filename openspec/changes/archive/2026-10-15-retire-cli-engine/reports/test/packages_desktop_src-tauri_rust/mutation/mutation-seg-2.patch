+    let state = app.state::<WorkspaceStores>();
+    let provider = save_new_provider(&state, "拒面端点", "sk-live-1234567890").expect("新建应成功");
+
+    // engine: Cli 新建 → Err（store 单点校验透传不吞不改写；除 StoreError::Db
