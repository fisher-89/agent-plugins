+/// fixture 命令集合（真实 `collect_commands!`）。
+fn fixture_commands() -> Commands<tauri::Wry> {
+    tauri_specta::collect_commands![
+        fixture_ping,
+        fixture_bigints,
+        fixture_channel,
+        fixture_renamed,
+    ]
+}
+
+/// 收集 fixture 的 `(functions, accessor_names, types)` 三元组。
+fn collect_fixture(
+    commands: Commands<tauri::Wry>,
+) -> (
+    Vec<Function>,
+    BTreeMap<Cow<'static, str>, Cow<'static, str>>,
+    Types,
+) {
+    let mut types = Types::default();
+    let collected = (commands.1)(&mut types);
+    (collected.functions, collected.accessor_names, types)
+}
+
+/// 构造 `BuilderConfiguration`（`#[non_exhaustive]` ⇒ `Default` + 字段赋值）。
+fn config(
+    functions: Vec<Function>,
+    accessor_names: BTreeMap<Cow<'static, str>, Cow<'static, str>>,
+    types: Types,
+    casing: Casing,
+    cast_bigints: bool,
+) -> BuilderConfiguration {
+    let mut cfg = BuilderConfiguration::default();
+    cfg.commands = functions;
+    cfg.command_accessor_names = accessor_names;
+    cfg.types = types;
+    cfg.function_casing = casing;
+    cfg.dangerously_cast_bigints_to_number = cast_bigints;
+    cfg
+}
+
+/// 默认 fixture 配置（camelCase accessor / 大整数转 number）。
+fn fixture_config() -> BuilderConfiguration {
+    let (functions, accessor_names, types) = collect_fixture(fixture_commands());
+    config(functions, accessor_names, types, Casing::CamelCase, true)
+}
+
+/// 单命令 fixture 配置（`.refine(` 命中臂专用：不与默认 fixture 的三表断言互相干扰）。
+fn single_command_config(commands: Commands<tauri::Wry>) -> BuilderConfiguration {
+    let (functions, accessor_names, types) = collect_fixture(commands);
+    config(functions, accessor_names, types, Casing::CamelCase, true)
+}
+
+/// `Types` 内按 name 取具名类型。
+fn named<'a>(types: &'a Types, name: &str) -> &'a NamedDataType {
+    types
+        .into_unsorted_iter()
+        .find(|ndt| ndt.name.as_ref() == name)
+        .unwrap_or_else(|| panic!("缺具名类型 {name}"))
+}
+
+/// 具名 struct 的某字段 datatype（字段缺失即失败）。
+fn field_ty(types: &Types, type_name: &str, field: &str) -> DataType {
+    let ndt = named(types, type_name);
+    let ty = ndt.ty.as_ref().expect("具名类型应有 ty");
+    let DataType::Struct(strct) = ty else {
+        panic!("{type_name} 不是 struct");
+    };
+    let Fields::Named(fields) = &strct.fields else {
+        panic!("{type_name} 不是 named struct");
+    };
+    fields
+        .fields
+        .iter()
+        .find(|(name, _)| name.as_ref() == field)
+        .and_then(|(_, field)| field.ty.clone())
+        .unwrap_or_else(|| panic!("{type_name} 缺字段 {field}"))
+}
+
+/// 命令按 invoke 名（= `Function::name()`）取。
+fn command_by<'a>(cfg: &'a BuilderConfiguration, ipc_name: &str) -> &'a Function {
+    cfg.commands
+        .iter()
+        .find(|command| command.name() == ipc_name)
+        .unwrap_or_else(|| panic!("缺命令 {ipc_name}"))
+}
