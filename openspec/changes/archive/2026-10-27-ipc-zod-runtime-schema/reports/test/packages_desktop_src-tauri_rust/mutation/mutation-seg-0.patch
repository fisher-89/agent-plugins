+/// 数字类改写的期望值：`z.number()` 的 opaque 引用。
+fn z_number() -> DataType {
+    DataType::Reference(specta_zod::define("z.number()"))
+}
+
+/// 字符串类改写的期望值：`z.string()` 的 opaque 引用。
+fn z_string() -> DataType {
+    DataType::Reference(specta_zod::define("z.string()"))
+}
+
+/// `z.unknown()` 的 opaque 引用（合法白洞 / 降级哨兵共用形态）。
+fn z_unknown() -> DataType {
+    DataType::Reference(specta_zod::define("z.unknown()"))
+}
+
+/// 剥一层容器引用：`Vec<T>` 等出线为 `Inline { dt: List(..) }`，取出其 `List`。
+fn list_of(dt: &DataType) -> DataType {
+    match dt {
+        DataType::List(list) => DataType::List(list.clone()),
+        DataType::Reference(specta::datatype::Reference::Named(reference)) => {
+            match &reference.inner {
+                specta::datatype::NamedReferenceType::Inline { dt, .. } => list_of(dt),
+                other => panic!("容器引用形态非预期: {other:?}"),
+            }
+        }
+        other => panic!("非容器类型: {other:?}"),
+    }
+}
+
+/// 临时目录内的产物路径（父目录已建）。
+fn temp_product(dir: &Path, name: &str) -> std::path::PathBuf {
+    dir.join(name)
+}
