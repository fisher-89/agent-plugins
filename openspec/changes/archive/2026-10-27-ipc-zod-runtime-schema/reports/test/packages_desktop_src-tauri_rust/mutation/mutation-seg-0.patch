+#[test]
+fn map_types_相位选择在统一形态下恒等() {
+    // design R-11 的可验证形态：三表虽按方向标注 `Phase::Deserialize` / `Phase::Serialize`
+    // 并经 `select_phase_datatype` 取值，但统一形态下两个 Phase 得到等价 datatype（恒等变换）。
+    let mut cfg = fixture_config();
+    cfg.types.register_mut::<FixturePhased>();
+    cfg.types.register_mut::<FixtureDefaulted>();
+    let format = ZodFormat::new(&cfg);
+    let mapped = format.map_types(&cfg.types).expect("映射应成功");
+    let types = mapped.as_ref();
+
+    // 候选集与 `render_phase_dt` 的取数面一致：具名类型体 + 全部命令的形参与结果
+    let mut candidates: Vec<(String, DataType)> = Vec::new();
+    for ndt in types.into_unsorted_iter() {
+        if let Some(ty) = ndt.ty.as_ref() {
+            candidates.push((ndt.name.to_string(), ty.clone()));
+        }
+    }
+    for command in &cfg.commands {
+        for (name, dt) in command.args() {
+            candidates.push((format!("{}.{}", command.name(), name), dt.clone()));
+        }
+        if let Some(result) = command.result() {
+            candidates.push((format!("{}.result", command.name()), result.clone()));
+        }
+    }
+    assert!(
+        candidates.len() > 10,
+        "候选集应含具名类型体与命令形参，实际 {} 条",
+        candidates.len()
+    );
+
+    for (label, dt) in &candidates {
+        let deserialize = select_phase_datatype(dt, types, Phase::Deserialize);
+        let serialize = select_phase_datatype(dt, types, Phase::Serialize);
+        assert_eq!(
+            deserialize, serialize,
+            "{label}: 两个 Phase 取值应等价（相位选择在统一形态下不分裂）"
+        );
+        assert_eq!(
+            &deserialize, dt,
+            "{label}: 统一形态下相位选择恒等（零改写）"
+        );
+    }
+
+    // 相位差 fixture 确实在候选集里（否则该臂只覆盖无相位差类型）
+    assert!(
+        types
+            .into_unsorted_iter()
+            .any(|ndt| ndt.name.as_ref() == "FixturePhased"),
+        "相位差 fixture 应在映射后的具名类型集合内"
+    );
+}
