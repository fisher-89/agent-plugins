+        let path = temp_product(dir.path(), &format!("map-key-{label}.zod.ts"));
+
+        let err = ZodLanguage
+            .export(&cfg, &path)
+            .expect_err("数值型 map key 应出 .refine( → 生成期自检失败");
+        let text = err.to_string();
+        assert!(
+            text.contains("禁用片段"),
+            "{label} key: 错误面应点名生成期硬约束，实际: {text}"
+        );
+        assert!(
+            text.contains(".refine("),
+            "{label} key: 命中的禁用片段应为 .refine(，实际: {text}"
+        );
+        assert!(
+            !path.exists(),
+            "{label} key: 命中禁用片段时目标路径不产生文件（fail-closed）"
+        );
+    }
+}
