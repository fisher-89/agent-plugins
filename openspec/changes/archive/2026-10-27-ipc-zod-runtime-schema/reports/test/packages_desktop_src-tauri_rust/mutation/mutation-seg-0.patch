+#[test]
+fn export_保留result引用的fixture零result具名schema声明() {
+    let mut cfg = fixture_config();
+    cfg.types.register_mut::<FixtureHoldsResult>();
+    let dir = tempfile::Builder::new().tempdir().expect("建临时目录");
+    let path = temp_product(dir.path(), "retained_result.zod.ts");
+
+    // design D3 的前置条件是「无任何保留类型引用 Result」（本仓 46 命令的结果面全部
+    // 解包 Ok 臂）。前置不成立时，`Result` 的具名 schema 已被隐藏（ty 置 None），
+    // 产物因此不含可与 `bindings.ts` 类型面对位的 `ResultSchema` 声明——这一条是
+    // 隐藏逻辑本身的判据；残留的引用位是未声明标识符，归 AC-8 的自检桩
+    // （`bindings:zod-check` 的 `tsc --noEmit`，`TS2304`）拦截。
+    // test-design 口径（design R-1 / D16 现值）：此处**导出成功**，
+    // MUST NOT 期望生成期 `dangling_named_reference`。
+    ZodLanguage
+        .export(&cfg, &path)
+        .expect("隐藏 Result 后导出本身不应失败（悬挂标识符归 tsc 桩拦截）");
+    let text = std::fs::read_to_string(&path).expect("读取产物");
+
+    assert!(
+        !text.contains("export const ResultSchema"),
+        "Result 具名 schema 不渲染（不产出不等价 schema）"
+    );
+    assert!(
+        text.contains("export const FixtureHoldsResultSchema = z.strictObject({"),
+        "保留引用的 fixture 自身 schema 仍出线"
+    );
+    // 隐藏面不外溢：其余具名 DTO schema 照旧在场
+    assert!(text.contains("export const FixtureBigintsSchema = z.strictObject({"));
+}
