+#[test]
+fn map_type_顶层value引用两形态均改写为z_unknown() {
+    // 命令顶层参数面不经 `map_types`（走 `map_type`）：两条路径必须同口径，否则参数面
+    // 会漏出上游 `serde_json::Value` 的 enum union。`Value` 的两条引用形态（具名引用 /
+    // `#[specta(inline)]` 内联）都要覆盖——内联形态的值与具名引用不同，等值匹配覆盖不到。
+    let mut cfg = fixture_config();
+    cfg.types.register_mut::<FixtureInlineValue>();
+    let format = ZodFormat::new(&cfg);
+
+    let reference_form = field_ty(&cfg.types, "FixtureBigints", "payload");
+    let inline_form = field_ty(&cfg.types, "FixtureInlineValue", "payload");
+
+    let DataType::Reference(reference_form_ref) = &reference_form else {
+        panic!("Value 默认形态应为具名引用，实际 {reference_form:?}");
+    };
+    let specta::datatype::Reference::Named(named_reference) = reference_form_ref else {
+        panic!("Value 默认形态应为 NamedReference，实际 {reference_form_ref:?}");
+    };
+    assert!(
+        matches!(
+            &named_reference.inner,
+            specta::datatype::NamedReferenceType::Reference { .. }
+        ),
+        "默认字段形态为 `NamedReferenceType::Reference`"
+    );
+
+    let DataType::Reference(inline_form_ref) = &inline_form else {
+        panic!("#[specta(inline)] 形态应为具名引用，实际 {inline_form:?}");
+    };
+    let specta::datatype::Reference::Named(named_inline) = inline_form_ref else {
+        panic!("#[specta(inline)] 形态应为 NamedReference，实际 {inline_form_ref:?}");
+    };
+    assert!(
+        matches!(
+            &named_inline.inner,
+            specta::datatype::NamedReferenceType::Inline { .. }
+        ),
+        "`#[specta(inline)]` 字段形态为 `NamedReferenceType::Inline`"
+    );
+
+    // 等值匹配（`hidden_references`）只覆盖 `Reference` 形态：内联形态 inner 不同 ⇒ 值不等
+    let hidden = hidden_references(&cfg.types);
+    assert!(
+        hidden.contains(reference_form_ref),
+        "隐藏引用清单应等值命中 Reference 形态"
+    );
+    assert!(
+        !hidden.contains(inline_form_ref),
+        "隐藏引用清单的值不等匹配覆盖不到 Inline 形态（必须由 id 解析补上）"
+    );
+
+    // 两条形态经 `map_type` 均改写为 `z.unknown()`（同一套改写，不给参数面留 union）
+    for (label, dt) in [("Reference", &reference_form), ("Inline", &inline_form)] {
+        // 反证本臂非空断言：基线 serde 格式层单独跑不会把 Value 变成 z.unknown()，
+        // `z.unknown()` 只可能来自 `ZodFormat` 的 Value 改写（否则参数面漏出 enum union）
+        let baseline = specta_serde::Format
+            .map_type(&cfg.types, dt)
+            .expect("基线 serde 格式映射应成功");
+        assert_ne!(
+            baseline.as_ref(),
+            &z_unknown(),
+            "{label} 形态的 z.unknown() 改写来自 ZodFormat，基线 serde 格式不改写"
+        );
+
+        let mapped = format
+            .map_type(&cfg.types, dt)
+            .unwrap_or_else(|err| panic!("{label} 形态顶层映射失败: {err}"));
+        assert_eq!(
+            mapped.as_ref(),
+            &z_unknown(),
+            "{label} 形态的 Value 引用应改写为 z.unknown()"
+        );
+
+        // 幂等：改写结果再映射一次不二次包装
+        let again = format
+            .map_type(&cfg.types, mapped.as_ref())
+            .unwrap_or_else(|err| panic!("{label} 形态二次映射失败: {err}"));
+        assert_eq!(again.as_ref(), &z_unknown(), "{label} 形态二次映射应幂等");
+    }
+}
