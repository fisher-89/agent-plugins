+#[test]
+fn guard_forbidden_九类禁用片段一律失败且干净文本放行() {
+    for snippet in FORBIDDEN_SNIPPETS {
+        let dirty = format!("export const XSchema = z.string(){snippet}();");
+        assert!(
+            guard_forbidden(&dirty).is_err(),
+            "命中 {snippet} 时应失败（fail-closed）"
+        );
+    }
+    // 干净产物放行
+    let clean = "export const XSchema = z.strictObject({ get a() { return z.number(); } });";
+    assert!(guard_forbidden(clean).is_ok(), "干净文本应放行");
+    // 五类 zod 修饰与两类别名形态各自在册（防清单漏项）
+    for required in [
+        ".default(",
+        ".transform(",
+        ".catch(",
+        ".pipe(",
+        ".refine(",
+        "export type ",
+        "z.infer",
+    ] {
+        assert!(
+            FORBIDDEN_SNIPPETS.contains(&required),
+            "禁用清单缺 {required}"
+        );
+    }
+}
