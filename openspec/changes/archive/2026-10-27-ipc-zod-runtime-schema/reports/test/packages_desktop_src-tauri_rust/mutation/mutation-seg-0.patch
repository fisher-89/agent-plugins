+#[test]
+fn map_types_相位统一面零伴生类型且映射后仍可渲染() {
+    // `builder().disable_serde_phases()` 的等价形态：格式层只用**统一**的
+    // `specta_serde::Format`，不产生 `_Serialize` / `_Deserialize` 伴生类型。
+    let mut types = Types::default();
+    types.register_mut::<FixturePhased>();
+    types.register_mut::<FixtureDefaulted>();
+
+    // 空断言防线：同一 fixture 经 `PhasesFormat`（真正开相位）确实分裂出伴生类型，
+    // 否则下面「零伴生」的断言在无相位差的 fixture 上会恒真
+    let phased = PhasesFormat.map_types(&types).expect("相位格式映射应成功");
+    let split: Vec<String> = phased
+        .as_ref()
+        .into_unsorted_iter()
+        .map(|ndt| ndt.name.to_string())
+        .collect();
+    assert!(
+        split.iter().any(|name| name.ends_with("_Serialize")),
+        "fixture 应触发序列化相位分裂，实际 {split:?}"
+    );
+    assert!(
+        split.iter().any(|name| name.ends_with("_Deserialize")),
+        "fixture 应触发反序列化相位分裂，实际 {split:?}"
+    );
+
+    // 统一形态：同一 fixture 经 `ZodFormat`（`specta_serde::Format` + 本仓三处改写）
+    let cfg = config(Vec::new(), BTreeMap::new(), types, Casing::CamelCase, true);
+    let format = ZodFormat::new(&cfg);
+    let mapped = format.map_types(&cfg.types).expect("相位分裂面映射应成功");
+    let names: Vec<String> = mapped
+        .as_ref()
+        .into_unsorted_iter()
+        .map(|ndt| ndt.name.to_string())
+        .collect();
+
+    // 伴生类型零产生：每个 fixture 只出一条具名类型，且无 `_Serialize` / `_Deserialize` 后缀
+    assert!(
+        names.iter().all(|name| !name.ends_with("_Serialize")),
+        "统一映射零 _Serialize 伴生类型，实际 {names:?}"
+    );
+    assert!(
+        names.iter().all(|name| !name.ends_with("_Deserialize")),
+        "统一映射零 _Deserialize 伴生类型，实际 {names:?}"
+    );
+    assert_eq!(
+        names
+            .iter()
+            .filter(|name| name.starts_with("FixturePhased"))
+            .count(),
+        1,
+        "`skip_serializing_if` fixture 只出单条具名类型"
+    );
+    assert_eq!(
+        names
+            .iter()
+            .filter(|name| name.starts_with("FixtureDefaulted"))
+            .count(),
+        1,
+        "`serde(default)` fixture 只出单条具名类型"
+    );
+
+    // 映射期只做改写、不制造渲染期不可用的形态：每条 fixture 具名类型仍可被渲染
+    let exporter = specta_zod::Zod::new();
+    let mut rendered = 0;
+    for ndt in mapped.as_ref().into_unsorted_iter() {
+        if !(ndt.name.starts_with("FixturePhased") || ndt.name.starts_with("FixtureDefaulted")) {
+            continue;
+        }
+        if let Some(ty) = ndt.ty.as_ref() {
+            let text = specta_zod::primitives::inline(&exporter, mapped.as_ref(), ty)
+                .unwrap_or_else(|err| panic!("{} 渲染失败: {err}", ndt.name));
+            assert!(!text.is_empty(), "{} 渲染结果非空", ndt.name);
+            rendered += 1;
+        }
+    }
+    assert_eq!(rendered, 2, "两条相位差 fixture 具名类型均可渲染");
+}
