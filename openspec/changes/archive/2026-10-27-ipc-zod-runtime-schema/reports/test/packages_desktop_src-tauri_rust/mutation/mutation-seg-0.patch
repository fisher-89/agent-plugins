+#[test]
+fn render_command_tables_三表形态与键序camel_case逐字命中() {
+    let cfg = fixture_config();
+    let format = ZodFormat::new(&cfg);
+    let mapped = format.map_types(&cfg.types).expect("映射应成功");
+    let tables = render_command_tables(&format, &cfg, mapped.as_ref()).expect("三表渲染应成功");
+
+    // 三表以 `as const` 收尾、键为 getter（表构造零成本）
+    for table in ["argsSchemas", "resultSchemas", "channelArgs"] {
+        assert!(
+            tables.contains(&format!("export const {table} = {{")),
+            "缺 {table} 表头"
+        );
+    }
+    assert_eq!(
+        tables.matches("} as const;").count(),
+        3,
+        "三表均以 as const 收尾"
+    );
+    assert!(
+        tables.contains("get \"fixtureBigints\"() { return"),
+        "表项一律 getter，accessor 为 camelCase"
+    );
+
+    // 参数键名 lowerCamelCase（`since_seq` → `sinceSeq`）且键序 = Rust 形参序
+    let args = tables
+        .find("export const argsSchemas")
+        .map(|start| &tables[start..])
+        .expect("参数表在场");
+    let item_at = args.find("\"item\"").expect("缺 item 形参位");
+    let since_at = args.find("\"sinceSeq\"").expect("缺 sinceSeq 形参位");
+    let letter_at = args.find("\"letter\"").expect("缺 letter 形参位");
+    assert!(
+        item_at < since_at && since_at < letter_at,
+        "键序 = Rust 形参序"
+    );
+    assert!(!tables.contains("since_seq"), "不得出蛇形键名");
+    // 形参面渲染：具名 DTO 走 z.lazy 引用、大整数与 char 走改写后的 inline 表达式
+    assert!(tables.contains("\"item\": z.lazy(() => FixtureBigintsSchema),"));
+    assert!(tables.contains("\"sinceSeq\": z.number(),"));
+    assert!(tables.contains("\"letter\": z.string(),"));
+}
