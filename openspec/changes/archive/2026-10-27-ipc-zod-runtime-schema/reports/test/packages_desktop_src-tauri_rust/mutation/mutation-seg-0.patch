+#[test]
+fn channel_envelope_dt_channel形参得到信封类型且普通形参不命中() {
+    let cfg = fixture_config();
+    let channel_command = command_by(&cfg, "fixture_channel");
+    let args = channel_command.args();
+
+    let (_, channel_dt) = args
+        .iter()
+        .find(|(name, _)| name.as_ref() == "on_event")
+        .expect("缺 on_event 形参");
+    let envelope = channel_envelope_dt(channel_dt, &cfg.types).expect("Channel 形参应命中");
+    let DataType::Reference(reference) = envelope else {
+        panic!("信封应为具名引用，实际 {envelope:?}");
+    };
+    let specta::datatype::Reference::Named(named_reference) = reference else {
+        panic!("信封应为 NamedReference");
+    };
+    assert_eq!(
+        cfg.types.get(named_reference).map(|ndt| ndt.name.as_ref()),
+        Some("FixtureEvent"),
+        "信封类型为 Channel<T> 的 T"
+    );
+
+    let (_, root_dt) = args
+        .iter()
+        .find(|(name, _)| name.as_ref() == "root")
+        .expect("缺 root 形参");
+    assert!(
+        channel_envelope_dt(root_dt, &cfg.types).is_none(),
+        "普通形参不命中 Channel 判据"
+    );
+
+    // 降级清单的数据来源 = 逐命令 Channel 形参命中数（fixture 内恰 1 个）
+    let channel_args: Vec<_> = cfg
+        .commands
+        .iter()
+        .flat_map(|command| command.args())
+        .filter(|(_, dt)| channel_envelope_dt(dt, &cfg.types).is_some())
+        .collect();
+    assert_eq!(channel_args.len(), 1, "fixture 内恰 1 个 Channel 形参");
+    assert_eq!(channel_args[0].0.as_ref(), "on_event", "形参名逐字");
+}
