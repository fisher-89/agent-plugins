+//! `bindings/zod` 单测：格式映射（大整数 / `char` / `serde_json::Value` / `Result`
+//! 隐藏）→ 三表渲染（getter 化 / accessor 命名 / 降级哨兵 / Ok 臂解包）→ 生成期
+//! 自检与落盘（幂等 / fail-closed / io 错误面）。
+//!
+//! fixture 走**真实** specta 面：`#[derive(Type)]` 的具名类型 + `collect_commands!`
+//! 产出的 `Function` 清单与 `Types`（`Function` / `BuilderConfiguration` 均
+//! `#[non_exhaustive]`，只能由宏与 `Default` 取得——不为测试伪造这两者）。写盘目标
+//! 用 `tempfile::TempDir`（真实文件系统边界，零替身）。私有辅助经 `super::` 直接
+//! 断言，不新增导出。
+
+use std::borrow::Cow;
+use std::collections::BTreeMap;
+use std::path::Path;
+
+use serde::{Deserialize, Serialize};
+use specta::datatype::{DataType, Fields, Function, NamedDataType, Primitive};
+use specta::{Format, Type, Types};
+use specta_serde::{select_phase_datatype, Phase, PhasesFormat};
+use tauri_specta::{BuilderConfiguration, Casing, Commands, LanguageExt};
+
+use super::{
+    channel_envelope_dt, guard_forbidden, hidden_references, is_hidden_ndt, is_result_ndt,
+    is_value_ndt, render_command_tables, result_dt, ZodFormat, ZodLanguage, CHANNEL_REASON,
+    FILE_BANNER, FILE_PRELUDE, FORBIDDEN_SNIPPETS,
+};
+
+// ---------------------------------------------------------------------------
+// fixture 类型：三处改写 + 递归 + 相位分裂 + 保留 Result 引用
+// ---------------------------------------------------------------------------
+
+/// 大整数六型 + 小整数对照 + `char` + `serde_json::Value`（映射断言的最小载体）。
+#[derive(Debug, Clone, Serialize, Deserialize, Type)]
+struct FixtureBigints {
+    small: u32,
+    big_u64: u64,
+    big_i64: i64,
+    big_u128: u128,
+    big_i128: i128,
+    big_usize: usize,
+    big_isize: isize,
+    letter: char,
+    payload: serde_json::Value,
+}
+
+/// `Channel<T>` 的信封载荷（`channelArgs` 值 schema 的载体）。
+#[derive(Debug, Clone, Serialize, Deserialize, Type)]
+struct FixtureEvent {
+    kind: String,
+    seq: u64,
+}
+
+/// 递归类型（`children` 自引用）：映射期零展开、引用不塌。
+#[derive(Debug, Clone, Serialize, Deserialize, Type)]
+struct FixtureNode {
+    name: String,
+    children: Vec<FixtureNode>,
+}
+
+/// 相位分裂面（`skip_serializing_if` 触发 serde 相位差）。
+#[derive(Debug, Clone, Serialize, Deserialize, Type)]
+struct FixturePhased {
+    #[serde(skip_serializing_if = "Option::is_none")]
+    note: Option<String>,
+    value: u32,
+}
+
+/// 相位分裂的第二形态（`#[serde(default)]`：反序列化可缺、序列化恒在，同样有相位差）。
+#[derive(Debug, Clone, Serialize, Deserialize, Type)]
+struct FixtureDefaulted {
+    #[serde(default)]
+    count: u32,
+    label: String,
+}
+
+/// `serde_json::Value` 的**内联**引用形态（`#[specta(inline)]`）：`NamedReferenceType::Inline`
+/// 的 `inner` 与具名引用不同 ⇒ 值不等，`hidden_references` 的等值匹配覆盖不到，只能由
+/// `Types::get` 的 id 解析命中（顶层参数面的第二条同口径判据）。
+#[derive(Debug, Clone, Serialize, Deserialize, Type)]
+struct FixtureInlineValue {
+    #[specta(inline)]
+    payload: serde_json::Value,
+}
+
+/// 保留 `Result` 引用（不走命令结果面的 Ok 臂解包）：`Result` 的具名 schema 被隐藏
+/// （`ty` 置 `None`），引用位不改写 ⇒ 导出**成功**（design R-1 / D16 现值），产物里只留
+/// 一个未声明标识符——那只能由生成期 tsc 桩（AC-8 的 `TS2304`）拦截，MUST NOT 期望
+/// 生成期 `dangling_named_reference`（真正的悬挂错误面在「引用 `types` 中不存在的
+/// 具名类型」那条臂上）。
+#[derive(Debug, Clone, Serialize, Deserialize, Type)]
+struct FixtureHoldsResult {
+    outcome: Result<String, String>,
+}
+
+/// `HashMap<f64, _>` 形状的 key：`f64` 不实现 `Hash` / `Eq`，故以可哈希 newtype 承载
+/// 同一 key datatype——渲染期递归到 `f64` 即出 `z.string().regex(…).refine(…)`。
+#[derive(Debug, Clone, Copy, PartialEq, Serialize, Deserialize, Type)]
+struct FixtureFloatKey(f64);
+
+impl Eq for FixtureFloatKey {}
+
+impl std::hash::Hash for FixtureFloatKey {
+    fn hash<H: std::hash::Hasher>(&self, state: &mut H) {
+        // 按位哈希与派生的 `PartialEq` 在非 NaN 面一致；fixture 不入容器，
+        // 该实现只为满足 `HashMap` key 的 `Eq + Hash` 约束
+        std::hash::Hash::hash(&self.0.to_bits(), state);
+    }
+}
