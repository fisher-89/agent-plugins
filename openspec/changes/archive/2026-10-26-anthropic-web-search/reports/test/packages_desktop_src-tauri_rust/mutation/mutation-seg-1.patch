+/// 携块清单的 assistant 事件。
+fn assistant_blocks(seq: u64, blocks: Vec<AgentBlock>) -> AgentEvent {
+    event(
+        seq,
+        AgentEventKind::Message {
+            role: AgentMessageRole::Assistant,
+            blocks,
+            parent_tool_use_id: None,
+        },
+    )
+}
