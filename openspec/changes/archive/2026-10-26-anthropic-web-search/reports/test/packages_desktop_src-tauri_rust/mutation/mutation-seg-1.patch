+#[test]
+fn 退役cli臂不被开关改写_逐字退役文案且不静默回退sdk臂() {
+    // `Box<dyn AgentRunner>` 不实现 Debug（expect_err 不可用）：以 match 摘取
+    let error = match EngineFacade::new()
+        .with_web_search(true)
