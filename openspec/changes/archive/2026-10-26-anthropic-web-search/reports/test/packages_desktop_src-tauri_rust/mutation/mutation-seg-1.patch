+fn continuation_counts(events: &[AgentEventKind], subtype: &str) -> Vec<u64> {
+    notices_of(events)
+        .into_iter()
+        .filter(|(name, _)| *name == subtype)
+        .map(|(_, payload)| {
+            payload["continuations"]
+                .as_u64()
+                .unwrap_or_else(|| panic!("{subtype} payload 应携 continuations 计数"))
+        })
+        .collect()
