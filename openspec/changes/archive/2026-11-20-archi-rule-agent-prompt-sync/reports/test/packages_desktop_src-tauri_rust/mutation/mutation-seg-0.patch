+
+# path：叶元素必填；`./` 前缀、repo 相对；目录以 `/` 结尾、文件精确到扩展名；容器（package / domain）恒空
+# path = ["./src-tauri/crates/core/example/src/"]
+# path = ["./src-tauri/crates/core/example/src/lib.rs"]
