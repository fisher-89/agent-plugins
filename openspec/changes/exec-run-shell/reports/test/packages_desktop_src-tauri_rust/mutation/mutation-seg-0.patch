+    assert!(control.request_stop(ROOT, CHANGE_ID), "首次命中断言");
+    assert!(control.request_stop(ROOT, CHANGE_ID), "重复停止仍命中（幂等）");
+    assert!(guard.cancel_flag().is_set(), "重复 set 无副作用");
+}
