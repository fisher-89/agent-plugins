+        _root: &str,
+        _name: &str,
+        _slot: foundation::layout::ReportSlot,
+        cancel: CancelFlag,
+    ) -> BoxToolFuture {
+        self.received
+            .lock()
+            .expect("received 锁不可中毒")
+            .push(cancel.clone());
+        self.entered.store(true, Ordering::SeqCst);
+        Box::pin(async move {
+            loop {
+                if cancel.is_set() {
