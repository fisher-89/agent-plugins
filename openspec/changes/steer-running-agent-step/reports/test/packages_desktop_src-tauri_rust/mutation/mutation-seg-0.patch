+/// 新实现只关句柄（OS 自动释放锁）。
+#[test]
+fn 产物文件锁drop后立即可重取且文件常驻() {
+    {
+        let _guard = lock();
+    }
+    let path = lock_file_path();
+    assert!(path.is_file(), "Drop 后锁文件常驻（MUST NOT 删除）");
+    // 立即重取：锁已随句柄关闭释放，无需等待轮询
+    let _again = lock();
+}
