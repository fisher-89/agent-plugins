+/// 工具轮脚本底座：首轮读一个真实文件，次轮文本收口。
+fn steer_tool_round(dir: &Path) -> FakeModel {
+    write_file(&dir.join("a.txt"), "内容甲");
+    FakeModel::with_turns(vec![
+        vec![raw_tool_call(
+            "tu_s",
+            "read",
+            serde_json::json!({ "path": "a.txt" }),
+        )],
+        vec![raw_text("已看到补充说明")],
+    ])
+}
