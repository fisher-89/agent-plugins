+/// 实例不共享（边界）：两个 `SteerRegistry` 实例各建一 kernel → A 的
+/// `begin_turn` 后，B 实例上 `request` → `Err`（组合根注入的才是可送达的表）。
+#[tokio::test]
+async fn 注入实例不共享_异实例请求err() {
+    let (sink, _calls) = FakeSink::new();
