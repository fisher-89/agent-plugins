+    ]);
+    let (steer_tx, steer_rx) = mpsc::unbounded_channel::<agent::SteerMessage>();
+    let mut acks = Vec::new();
+    let mut first_batch = Vec::new();
+    for text in ["甲", "乙"] {
+        let (msg, ack_rx) = steer_msg(text);
