+/// 发起后 root 库内会话清单（断言落库半边的统一读取面）。
+fn sessions_in_root(stores: &WorkspaceStores, root: &str) -> Vec<::agent::SessionSummary> {
+    stores
+        .for_root(root)
+        .expect("for_root 应成功")
+        .list_sessions(None, None)
+        .expect("清单应成功")
+}
