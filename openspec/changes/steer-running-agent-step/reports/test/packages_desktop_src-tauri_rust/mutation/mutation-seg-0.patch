+
+/// 第二产物路径（同式定位：`CARGO_MANIFEST_DIR` 的上级 + 生成目录）。
+fn zod_generated_path() -> PathBuf {
+    PathBuf::from(env!("CARGO_MANIFEST_DIR"))
+        .parent()
+        .expect("CARGO_MANIFEST_DIR 应有父目录")
+        .join("src/types/generated/bindings.zod.ts")
+}
