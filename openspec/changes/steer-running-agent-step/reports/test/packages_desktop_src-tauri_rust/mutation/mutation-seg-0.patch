+        super::agent_answer(
+            app.state::<Arc<AskRegistry>>(),
+            root.clone(),
+            key.clone(),
+            "原键应答".to_owned(),
+        )
+        .expect("原串命中");
+        assert_eq!(rx.try_recv().expect("收到"), "原键应答", "正文逐字");
+    }
+}
