+/// `session_id` 边界（边界，参数化 4 形态）：特殊字符 / 超长串与注册表键**原样
+/// 比对**（不 trim、不截断），近邻键互不命中。
+#[test]
+fn agent_answer_session_id边界原样比对() {
+    let env = Env::new("agent-answer-session-key");
