+    // 带空白」的三类形态，证命令面不 trim 归一
+    let keys = [
+        "a\0b🚀".to_owned(),
+        "字".repeat(1200),
+        " 前后空格 ".to_owned(),
+    ];
+    for key in &keys {
+        let (tx, mut rx) = tokio::sync::oneshot::channel::<String>();
+        assert!(registry.register(key, tx), "按原串登记");
+        // 近邻键（多一个空格）不命中，随后原串命中
+        let near = format!("{key} ");
