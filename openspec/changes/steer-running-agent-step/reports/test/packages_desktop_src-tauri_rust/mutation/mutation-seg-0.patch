-/// zod 单表顶层键（单制表符缩进的 `get "<命令>"()` 形态；形参位缩进更深）。
-fn zod_table_keys(body: &str) -> Vec<String> {
-    body.lines()
-        .filter_map(|line| {
-            let rest = line.strip_prefix("\tget \"")?;
-            if rest.starts_with('\t') {
-                return None;
-            }
-            Some(rest.split('"').next()?.to_owned())
-        })
-        .collect()
-}
