+/// sdk 默认实例 fixture（非法 base_url：泵即时收敛，不落网络不进重试退避）。
+fn seed_fast_failing_default(stores: &WorkspaceStores, tag: &str) {
+    let provider = seed_provider(
+        stores,
+        &format!("{tag}供应"),
+        "sk-test",
+        "http://bad host/v1",
+        "m-high",
+    );
+    seed_sdk_default(stores, &format!("{tag}实例"), provider);
+}
