+        None,
+        None,
+        None,
+        None,
+    )
+    .await
+    .expect("提前 resolve");
+
+    // 停止置位（begin_turn 同步段已登记句柄；若后台泵已收敛除名则 miss 幂等
+    // 无副作用——命中/miss 两态均不报错，注册表置位语义由 kernel_test 锁定）
+    let registry = app.state::<Arc<StopRegistry>>();
+    let _ = registry.request_stop(&summary.session_id);
