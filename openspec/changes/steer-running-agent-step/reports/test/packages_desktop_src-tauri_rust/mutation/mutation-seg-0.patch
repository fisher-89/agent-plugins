+/// 第二产物权威快照：重导出（幂等确定性）后读取字节。
+fn zod_authoritative_snapshot() -> Vec<u8> {
+    export_bindings().expect("export_bindings 应成功");
+    fs::read(zod_generated_path()).expect("读取 zod 产物文件应成功")
+}
