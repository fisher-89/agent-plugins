-async fn drain_events(receiver: &mut mpsc::Receiver<AgentEventKind>) -> Vec<AgentEventKind> {
-    let mut events = Vec::new();
-    while let Some(event) = receiver.recv().await {
-        events.push(event);
-    }
-    events
-}
