+        .find_session(&running.session_id)
+        .expect("find_session 应成功")
+        .expect("New 建会话行");
+    assert_eq!(
+        session.config_snapshot.agent_instance_id,
+        Some(sdk_id),
+        "缺省路径同填 Some（同经 resolve 单点取实例）"
+    );
+    drop(running);
+}
