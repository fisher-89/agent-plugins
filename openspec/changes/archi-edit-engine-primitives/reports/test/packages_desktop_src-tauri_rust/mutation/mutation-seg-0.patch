+    let shrunk = "# 01 · 核心（100 元素 / 100 关系）\n[element.\"App\"]\n";
+    assert!(
+        backfill_header_counts(shrunk, 99, 99).contains("（99 元素 / 99 关系）"),
+        "位数减少"
+    );
