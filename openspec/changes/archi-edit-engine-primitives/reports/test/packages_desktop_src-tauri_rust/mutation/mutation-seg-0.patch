+#[test]
+fn 表头数字位数与换行边界() {
+    let grown = "# 01 · 核心（9 元素 / 9 关系）\n[element.\"App\"]\n";
+    assert!(
+        backfill_header_counts(grown, 10, 10).contains("（10 元素 / 10 关系）"),
