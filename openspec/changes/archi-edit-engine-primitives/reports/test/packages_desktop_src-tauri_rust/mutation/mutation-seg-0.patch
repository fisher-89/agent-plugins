+
+    let absent = temp.root().join("no-such.toml");
+    let failure = check_expect(&absent, "", Some("sha256:任意")).expect_err("文件缺席应 Err");
+    assert_eq!(failure.kind, EditErrorKind::ExpectMismatch);
