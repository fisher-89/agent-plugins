+/// 异常（参数化 3 命令）：唯一登记——三新名字在两清单与生成物中各恰 1 次
+///（无重复登记）；`read_exec_output` / `readExecOutput` 既有条目在册且
+/// 参数面逐字未变（既有条目零位移）。
+#[test]
+fn 登记面_唯一登记且既有条目零位移() {
+    let _lock = lock();
+    let content = String::from_utf8(authoritative_snapshot()).expect("产物为 UTF-8 文本");
