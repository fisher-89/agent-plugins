+/// 取 `Err` 臂（`Watcher` 零 `Debug`，故不用 `expect_err`）。
+fn expect_unavailable(result: Result<crate::Watcher, WatchError>, label: &str) -> WatchError {
+    match result {
+        Ok(_) => panic!("{label}: 应为 Err(ParentUnavailable)，实际 Ok"),
+        Err(error) => error,
+    }
