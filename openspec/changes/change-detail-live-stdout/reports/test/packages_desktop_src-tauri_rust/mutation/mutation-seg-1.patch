+    );
+    let log = String::from_utf8_lossy(
+        &exec::read_exec_output(ws.root(), CHANGE, &outcome.exec_id).expect("记录可回查"),
+    )
+    .into_owned();
+    assert!(
+        log.contains("=== plan app_node-test (node-test)") && log.contains("argv="),
+        "记录面仍留 plan 头与展开长度（可回查）: {log:?}"
+    );
