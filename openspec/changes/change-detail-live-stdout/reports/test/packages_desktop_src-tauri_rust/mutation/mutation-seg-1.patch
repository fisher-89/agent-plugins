+    );
+    let final_text =
+        String::from_utf8_lossy(&read_output(&ws, "demo-change", &exec_id)).into_owned();
+    assert!(
+        final_text.contains(first_text.trim_end()),
+        "后读 ⊇ 前读（前读 {first_text:?} / 后读 {final_text:?}）"
+    );
+    assert!(final_text.contains("STAGE-TWO"), "终态含第二行");
+}
