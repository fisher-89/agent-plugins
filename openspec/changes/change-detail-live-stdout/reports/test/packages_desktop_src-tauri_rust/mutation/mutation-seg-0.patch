+            debug.contains("on_output_ref"),
+            "Debug 面含 on_output_ref 字段: {debug}"
+        );
+        assert!(
+            !debug.contains("0x") || debug.contains("OutputRefSink(..)"),
+            "Debug 不泄漏闭包地址: {debug}"
