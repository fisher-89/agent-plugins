+    cloned.emit("exec-2");
+    assert_eq!(
+        seen.lock().expect("上抛记录锁不可中毒").len(),
+        2,
+        "clone 共享同一底层闭包（调用两次即两条）"
+    );
+    assert_eq!(
+        *seen.lock().expect("上抛记录锁不可中毒"),
+        vec!["exec-1".to_owned(), "exec-2".to_owned()],
+        "两条记录均抵达"
+    );
+}
