+/// 正向：`new(回调)` 后 `emit("exec-x")` → 回调收到原样串；`emit("")` 亦原样
+/// 投递（空串是合法 exec_id 形态的边界由消费方判定）。
+#[test]
+fn output_ref_sink_emit原样投递含空串() {
+    let (sink, seen) = output_ref_recorder();
+    sink.emit("exec-x");
+    sink.emit("");
+    assert_eq!(
+        *seen.lock().expect("上抛记录锁不可中毒"),
+        vec!["exec-x".to_owned(), String::new()],
+        "原样投递（零改写），空串亦投递"
+    );
+}
