+/// 脚本步节点的 `output_ref` / 状态快照（落包整包捕获面摘取）。
+fn script_step_refs(
+    nodes: &[RunNodeEntry],
+    step: RunStepKind,
+) -> Vec<(u32, Option<String>, RunStepStatus)> {
+    nodes
+        .iter()
+        .filter(|node| node.step == step)
+        .map(|node| (node.instance_no, node.output_ref.clone(), node.status))
+        .collect()
+}
