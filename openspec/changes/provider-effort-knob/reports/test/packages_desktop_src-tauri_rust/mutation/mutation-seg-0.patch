+// ---------------------------------------------------------------------------
+
+/// 携 effort 旁路载荷（与可选 `web_search` 开关）的轮参数（其余面同基线）。
+fn effort_turn(cwd: &Path, effort_params: Option<serde_json::Value>, web_search: bool) -> LoopTurn {
+    LoopTurn {
+        effort_params,
+        web_search,
+        ..loop_turn(cwd, AgentPermissionMode::BypassPermissions)
+    }
+}
