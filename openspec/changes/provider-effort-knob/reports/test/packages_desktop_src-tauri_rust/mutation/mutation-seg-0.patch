+    for invalid in [
+        serde_json::json!("max"),
+        serde_json::json!({ "high": "max" }),
+    ] {
+        let mut value = base.clone();
+        value
+            .as_object_mut()
+            .expect("object 形态")
+            .insert("efforts".to_owned(), invalid.clone());
+        assert!(
+            serde_json::from_value::<AgentProviderRecord>(value).is_err(),
+            "efforts = {invalid} 必须 Err（两档皆是必填子键，不静默补值）"
