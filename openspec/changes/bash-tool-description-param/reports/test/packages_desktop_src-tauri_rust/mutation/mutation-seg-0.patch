+        .as_object()
+        .expect("properties 对象");
+
+    let mut keys: Vec<&str> = properties.keys().map(String::as_str).collect();
+    keys.sort();
+    assert_eq!(
+        keys,
+        vec!["command", "intent", "timeout_ms"],
+        "无缺失、无多余属性"
+    );
+}
