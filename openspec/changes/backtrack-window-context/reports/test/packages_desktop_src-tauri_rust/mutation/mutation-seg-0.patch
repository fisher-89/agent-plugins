+    );
+    assert!(
+        prompt.contains(&reason),
+        "落库原因原文经链路逐字抵达决策 prompt"
+    );
+    assert!(
+        !prompt.contains(&windows[0].from_phase) && !prompt.contains(&windows[0].to_phase),
+        "零相位 id 泄漏（合成串整篇零命中）"
+    );
+}
