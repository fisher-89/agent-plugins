+    }
+    if ops {
+        source.push_str("\n### is_set\n\n```json api-op\n{\"params\": []}\n```\n");
+    }
+    if types {
+        source.push_str(
+            "\n```json api-types\n{\"LocalArchiCheck\": {\"type\": \"object\", \"properties\": {}}}\n```\n",
+        );
+    }
+    if reexports {
+        source.push_str("\n```json api-reexport\n{\"AgentInput\": \"App.Demo.Input\"}\n```\n");
+    }
+    source
