+        .expect("大输出结果工件落报告树");
+    assert_eq!(
+        artifact_text(&results),
+        format!("{long}\n"),
+        "1500 字符 stdout 全量落工件（不截断）"
+    );
+    let merged = String::from_utf8_lossy(&execution.output).replace("\r\n", "\n");
+    assert_eq!(
+        merged, "tail-error\n",
+        "stderr 尾段随 output 承载（stdout 已进工件）"
+    );
 }
