+/// 携第九参的保存直调（协议 / 开关显式；其余面与既有底座同款）。
+fn save_with_switch(
+    state: &tauri::State<'_, WorkspaceStores>,
+    id: Option<i64>,
+    name: &str,
+    protocol: AgentProviderProtocol,
+    api_key: &str,
+    web_search: bool,
+) -> Result<AgentProviderRecord, String> {
+    save_agent_provider(
+        state.clone(),
+        id,
+        name.to_owned(),
+        protocol,
+        "https://api.example.com/v1".to_owned(),
+        api_key.to_owned(),
+        fixture_tiers(),
+        None,
+        None,
+        web_search,
+    )
+}
