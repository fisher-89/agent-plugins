+#[test]
+fn project_choice_use与配对result收敛为恰一块且不进客户端工具面() {
+    let raw_use = use_raw("srvtoolu_1", WEB_SEARCH_TOOL_NAME, Some("今日汇率"));
+    let raw_result = three_sources("srvtoolu_1");
