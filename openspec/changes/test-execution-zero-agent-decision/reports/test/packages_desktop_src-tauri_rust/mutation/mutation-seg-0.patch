+        brief_segment.chars().count()
+    );
+    assert!(brief_segment.ends_with('…'), "折叠留省略号: {brief_segment}");
+    assert!(
+        refs_segment.contains("reports/m-00.json") && refs_segment.contains("reports/m-63.json"),
+        "64 条清单首末项全量在场（报告面原文）: {refs_segment}"
