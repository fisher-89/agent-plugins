+/// 异常（AC-8 异常面）：各 `Err` 响应（值域 / 必填 / 端点 / 落点 / 乐观锁 / 保护闸）不
+/// 出现 `reordered` 键。
+#[tokio::test]
+async fn 失败路径零reordered键() {
+    let dir = healthy("reorder-errors");
