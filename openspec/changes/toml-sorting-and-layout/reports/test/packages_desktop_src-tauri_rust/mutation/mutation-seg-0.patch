+/// 产品源码的一段函数体（`signature` 起至其后首个行首 `}`）。
+fn body_of<'a>(source: &'a str, signature: &str) -> &'a str {
+    let start = source
+        .find(signature)
+        .unwrap_or_else(|| panic!("{signature} 应在产品源码内"));
+    let rest = &source[start..];
+    let end = rest.find("\n}\n").unwrap_or(rest.len());
+    &rest[..end]
+}
