+/// 解析表条目：`FQN → 接口原文`（值就是 `.schema.json` 的 JSON 文本投影）。
+fn schema_table(entries: &[(&str, &str)]) -> BTreeMap<String, serde_json::Value> {
+    entries
+        .iter()
+        .map(|(fqn, source)| {
+            let value: serde_json::Value =
+                serde_json::from_str(source).expect("解析表夹具必须是合法 JSON");
+            ((*fqn).to_owned(), value)
+        })
+        .collect()
+}
