+/// 跨元素字段引用（`<相对前缀><目标叶段>.schema.json#/$defs/<名>`；前缀经 `paths` 单点求，
+/// 夹具 MUST NOT 手算 `../` 层数）。
+fn external_ref(target: &str, name: &str) -> String {
+    format!(
+        "{}{}.schema.json#/$defs/{name}",
+        crate::api::paths::ref_relative(FQN, target),
+        crate::api::paths::leaf_name(target)
+    )
+}
