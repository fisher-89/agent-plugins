+        let object = raw.as_object().expect("报告为对象");
+        for field in [
+            "version",
+            "timestamp",
+            "mode",
+            "root",
+            "change",
+            "base",
+            "modelHash",
+            "model",
+            "scan",
+            "errors",
+            "warnings",
+            "suppressed",
+            "observations",
+            "status",
+            "apiFindings",
+        ] {
+            assert!(object.contains_key(field), "{mode:?} 报告缺字段 {field}");
+        }
+    }
+}
