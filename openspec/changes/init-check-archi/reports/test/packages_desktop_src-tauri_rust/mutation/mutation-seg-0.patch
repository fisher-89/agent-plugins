+        let reference = outcome.report_ref.expect("落盘");
+        let report = read_report(&reference);
+        assert_eq!(report.version, 3, "{mode:?} 报告版本不变");
+        let raw: serde_json::Value =
+            serde_json::from_slice(&fs::read(&reference).expect("读报告原文"))
