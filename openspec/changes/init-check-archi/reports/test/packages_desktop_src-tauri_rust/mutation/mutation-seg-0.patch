+async fn drive_initialize_archi(
+    tag: &str,
+    archi_outcomes: Vec<ArchiCheckOutcome>,
+    fail_on: Option<&str>,
+) -> (
+    ChangeRunStatus,
+    RunFinishCommand,
+    Vec<ToolCommand>,
+    Vec<WorkerTurnRequest>,
+) {
+    let root = TempRoot::new(tag);
