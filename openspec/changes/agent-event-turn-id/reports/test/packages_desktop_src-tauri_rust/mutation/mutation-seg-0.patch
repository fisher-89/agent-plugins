+    assert_eq!(
+        first_ids,
+        [Some(first_turn_id)]
+            .into_iter()
+            .collect::<std::collections::BTreeSet<_>>()
+    );
+    assert_eq!(
+        second_ids,
+        [Some(second_turn_id)]
+            .into_iter()
+            .collect::<std::collections::BTreeSet<_>>()
+    );
+    assert_ne!(first_ids, second_ids, "两轮轮归属集合互异");
+}
