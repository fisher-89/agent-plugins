+            "线格式 turnId 逐字等于入参: {turn_id:?}"
+        );
+        let roundtrip: AgentEvent = serde_json::from_value(value).expect("反序列化成功");
+        assert_eq!(roundtrip, event, "往返逐字段相等: {turn_id:?}");
+    }
+}
