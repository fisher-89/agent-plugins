+fn zod_agent_event_variant_section(zod: &str) -> &str {
+    let start = zod
+        .find("export const AgentEventSchema = z.strictObject({")
+        .expect("zod 产物缺 AgentEventSchema 声明");
+    let end = zod[start..]
