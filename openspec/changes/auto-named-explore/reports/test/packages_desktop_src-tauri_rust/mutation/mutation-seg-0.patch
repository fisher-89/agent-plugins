+    };
+    assert_eq!(
+        tools,
+        &[
+            "read".to_owned(),
+            "grep".to_owned(),
+            "glob".to_owned(),
+            "ls".to_owned(),
+            "edit".to_owned(),
+            "bash".to_owned(),
+            EXPLORE_NOTE_TOOL.to_owned(),
+        ],
+        "注入经泵铸造与下发链端到端（AC-5）"
