+            .lines()
+            .find(|line| line.contains("后接触面") && line.contains("最后理由"))
+            .unwrap_or_else(|| panic!("{name} 的顺序句应在同一段内"));
+        assert!(
+            line.contains("先边界") || line.contains("先拓扑"),
