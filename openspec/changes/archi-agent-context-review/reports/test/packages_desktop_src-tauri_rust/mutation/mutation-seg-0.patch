+
+/// 坏输入 ③：`properties` 的 op 键与 `$defs` 键撞名（同名不成两用）。
+fn colliding_schema(fqn: &str) -> String {
+    json!({
+        "$id": format!("{fqn}.schema.json"),
+        "title": fqn,
+        "$defs": { "Token": { "type": "object", "properties": {} } },
+        "properties": {
