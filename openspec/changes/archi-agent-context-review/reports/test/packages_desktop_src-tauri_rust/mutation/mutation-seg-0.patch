+        .get("$defs")
+        .and_then(serde_json::Value::as_object)
+        .into_iter()
+        .flatten()
+    {
+        if crate::api::check::is_pure_ref_alias(definition) {
+            reexports.push(name.clone());
+        } else {
+            types.push(name.clone());
+        }
+    }
+    let abstract_note = interface_abstract(&ops, &types, &reexports);
+    ArchiInterfaceAsset {
+        path: display,
+        present: true,
+        bytes,
+        ops,
+        types,
+        reexports,
+        abstract_note,
+    }
+}
