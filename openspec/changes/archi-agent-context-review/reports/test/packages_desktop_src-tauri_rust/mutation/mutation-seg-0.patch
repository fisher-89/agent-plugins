+/// 坏输入 ①：文本层重复键（`serde_json` 会折叠成「后者胜」⇒ 必须在解析前抓）。
+fn duplicate_key_schema(fqn: &str) -> String {
+    format!(
+        "{{\n  \"$id\": \"{fqn}.schema.json\",\n  \"title\": \"{fqn}\",\n  \
+         \"$comment\": \"先写的一句\",\n  \"$comment\": \"后写的一句\",\n  \
+         \"$defs\": {{}},\n  \"properties\": {{}}\n}}\n"
+    )
