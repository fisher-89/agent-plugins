+            let resolved = absolute.canonicalize().ok()?;
+            let prefix = models.canonicalize().ok()?;
+            resolved.strip_prefix(&prefix).ok()?.to_path_buf()
+        }
+    };
+    let file_name = relative.file_name()?.to_str()?;
+    archi::schema_fqn(file_name).map(str::to_owned)
 }
