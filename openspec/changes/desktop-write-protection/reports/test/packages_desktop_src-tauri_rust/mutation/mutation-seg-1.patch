+    assert!(
+        masked.ends_with("\necho tail"),
+        "结束 marker 行之后内容保留，产物: {masked:?}"
+    );
+
+    let quoted = "echo \"a b\"";
+    assert_eq!(
+        shell::mask_heredocs(quoted),
+        quoted,
+        "变体 A 只掩 heredoc 体：引号与内容逐字符保留"
+    );
