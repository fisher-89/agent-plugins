+    let mut session = runner
+        .open_session(open_new())
+        .expect("注入 root 后 open 应成功");
+    session
+        .questions
+        .send(agent::TurnQuestion {
+            prompt: "root 注入一轮".to_owned(),
+        })
+        .await
+        .expect("问题送达");
+    let started = session.observations.recv().await.expect("RunStarted");
+    drop(session);
+    started
+}
