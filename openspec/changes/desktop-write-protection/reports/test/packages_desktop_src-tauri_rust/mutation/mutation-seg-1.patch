+        format!("sed -i s/a/b/ {config}"),
+        "git stash".to_owned(),
+    ];
+    for command in commands {
+        assert!(
+            loaded
+                .evaluate(
+                    "bash",
+                    &serde_json::json!({ "command": command }),
+                    dir.path()
+                )
+                .is_some(),
+            "等效写法各自命中（重定向 / 删除 / cp / inline / sed -i / bulk），命令: {command}"
+        );
