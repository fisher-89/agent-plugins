+
+    let blocked = [
+        format!("echo foo > {config}"),
+        format!("cat <<EOF > {config}\nrm -rf /\nEOF"),
+        format!("echo \"rm -rf /\" > {config}"),
+    ];
+    for command in &blocked {
+        assert!(
+            loaded
+                .evaluate(
+                    "bash",
+                    &serde_json::json!({ "command": command }),
+                    dir.path()
+                )
+                .is_some(),
+            "同一装置换成受保护目标即拦，命令: {command}"
+        );
