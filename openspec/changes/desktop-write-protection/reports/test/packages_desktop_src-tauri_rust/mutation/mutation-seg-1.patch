+        }),
+    );
+    let loaded = ProtectRules::load(Some(dir.path()));
+
+    let inline_first = loaded
+        .evaluate(
+            "bash",
+            &serde_json::json!({
+                "command": "node -e \"fs.writeFileSync('docs/a.md','')\" && git stash"
+            }),
