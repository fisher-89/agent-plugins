+#[test]
+fn 归一_剥windows前缀且分隔符转正斜杠() {
+    assert_eq!(
+        rules::normalize(r"\\?\D:\ws\openspec\config.json"),
+        "D:/ws/openspec/config.json",
+        r"剥 `\\?\` 前缀 + 反斜杠转 `/`"
+    );
