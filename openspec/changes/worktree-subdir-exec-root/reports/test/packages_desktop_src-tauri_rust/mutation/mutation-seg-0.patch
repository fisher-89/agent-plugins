+        error.contains("branch \"change/fix-bug\" 已存在"),
+        "撞前置⑥，实际: {error}"
+    );
+    assert_eq!(env.store.create_call_count(), 0, "零建档");
+
+    // 形态二：worktree 目录已存在（前置⑦）
+    let env = Env::new("d7-dir");
