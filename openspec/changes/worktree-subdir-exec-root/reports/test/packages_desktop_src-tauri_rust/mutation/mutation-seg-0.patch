+            "{}.redb",
+            foundation::identity::workspace_identity_segment(&root)
+        ),
+        "库文件名 = workspace root 身份段派生"
+    );
+    let runs = app
+        .state::<WorkspaceStores>()
+        .for_root(&root)
+        .expect("for_root 应成功")
+        .list_change_runs(CHANGE)
+        .expect("run 史清单应成功");
+    assert_eq!(runs.len(), 1, "相位半边落 workspace root 库");
+}
