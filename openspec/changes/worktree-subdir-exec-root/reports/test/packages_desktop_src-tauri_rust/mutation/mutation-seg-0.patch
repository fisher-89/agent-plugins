+/// `worktree_snapshot`（正向）：子目录 workspace 夹具传 host → index 条目含
+/// 域外条目（`ls-files -s` 不缩域）。
+#[test]
+fn worktree_snapshot_传host_含域外index条目() {
+    let _guard = lock_path();
+    let (_dir, root) = init_repo("snapshot-host");
+    let (_wt_dir, host) = worktree_slot("snapshot-host");
