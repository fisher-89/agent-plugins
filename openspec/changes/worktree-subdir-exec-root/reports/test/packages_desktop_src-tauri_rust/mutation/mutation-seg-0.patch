+/// D7 同仓同名拒绝（异常）：同仓第二个子目录 workspace 建同名 change → 撞前
+/// 置⑥（branch 已存在）或前置⑦（worktree 目录已存在），拒绝面零建档零新目
+/// 录。
+#[test]
+fn create_同仓同名子目录_撞前置六七拒绝且零建档() {
+    // 形态一：branch 已存在（前置⑥）
+    let env = Env::new("d7-branch");
+    env.vcs.set_rel("packages/desktop");
