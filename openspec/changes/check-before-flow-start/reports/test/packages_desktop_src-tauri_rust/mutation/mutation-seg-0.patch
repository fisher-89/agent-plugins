+async fn step_initialize_skipped_phase_log(
+    ctx: &StepContext<'_>,
+    trace: &mut EdgeTrace,
+    cursor: &PhaseCursor,
+) -> Result<(), Terminal> {
+    let instance_no = begin_node(
+        ctx.guard,
+        trace,
+        ctx.phase,
+        cursor.attempt,
+        ChangeStepKind::PhaseLog,
+        EdgeKind::Forward,
+    );
+    emit_node(
+        ctx.guard,
+        ctx.phase,
+        cursor.attempt,
+        ChangeStepKind::PhaseLog,
+        instance_no,
+        StepSettle::running(),
+    );
+    let logged = run_phase_log(
+        ctx.tools,
+        ctx.request,
+        PhaseLogInput {
+            phase: ctx.phase.to_owned(),
+            report: TXT_SKIP_LEGACY_INITIALIZE.to_owned(),
+            checklist: Vec::new(),
+            skipped: true,
+            executor_session_id: None,
+            evaluator_session_id: None,
+            decision_session_id: None,
+        },
+    )
+    .await?;
+    emit_node(
+        ctx.guard,
+        ctx.phase,
+        cursor.attempt,
+        ChangeStepKind::PhaseLog,
+        instance_no,
+        StepSettle::passed(Some(format!(
+            "attempt {} 已落账（skipped：{TXT_SKIP_LEGACY_INITIALIZE}）",
+            logged.attempt
+        ))),
+    );
+    Ok(())
+}
