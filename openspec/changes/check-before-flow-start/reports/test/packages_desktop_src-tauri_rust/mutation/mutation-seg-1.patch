+        commands
+            .iter()
+            .filter_map(|command| match command {
+                ToolCommand::StaticCheck { slot, .. } => Some(("static-check", *slot)),
+                ToolCommand::TestExecution { slot, .. } => Some(("test-execution", *slot)),
