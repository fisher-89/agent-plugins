+/// 报告树锚点，与 walker Terminal 文案 {dir} 供给面同形）。
+fn baseline_check(passed: bool) -> StaticCheckOutcome {
+    StaticCheckOutcome {
+        passed,
+        diagnostics: if passed {
+            String::new()
+        } else {
+            "error[E0308]: baseline 类型错误".to_owned()
+        },
