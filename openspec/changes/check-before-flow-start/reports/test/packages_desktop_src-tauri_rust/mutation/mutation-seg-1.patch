+        let false_count = table.iter().filter(|def| !def.backtrackable).count();
+        assert_eq!(
+            true_count, expect_true_count,
+            "{workflow_type} backtrackable=true 条目数（既有条目全补 true）"
+        );
+        assert_eq!(
