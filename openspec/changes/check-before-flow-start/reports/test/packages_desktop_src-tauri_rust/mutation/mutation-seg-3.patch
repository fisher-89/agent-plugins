+        "身份串 = 边表端点口径（clean 词面在案——fixture 相位随行）"
+    );
+
+    // serde_json 反序列化回环（同词面）
+    let back: RunNodeRecord = serde_json::from_value(value).expect("反序列化应成功");
+    assert_eq!(back, record, "serde_json 回环逐字段相等");
+}
