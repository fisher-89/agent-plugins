{
  "$schema": "https://raw.githubusercontent.com/fisher-89/agent-plugins/refs/heads/master/plugins/dev-team/bin/dev-team-config.schema.json",
  "schema": "spec-driven",
  "static_analysis": "pnpm run -C ./plugins/dev-team check",
  "tests": [
    {
      "root": "plugins/dev-team",
      "framework": "vite-plus",
      "config": "vite.config.ts",
      "includes": ["bin/src/**/*.{ts,tsx}"],
      "excludes": ["bin/src/schemas/**/*", "home-install.ts"],
      "coverage": { "lines": 90, "branches": 85, "functions": 90 },
      "mutation": { "score": 80 }
    },
    {
      "root": "packages/desktop",
      "framework": "vite-plus",
      "config": "vite.config.ts",
      "includes": ["src/**/*.{ts,tsx}"],
      "coverage": { "lines": 90, "branches": 85, "functions": 90 },
      "mutation": { "score": 80 }
    },
    {
      "root": "packages/desktop/src-tauri",
      "framework": "rust",
      "coverage": { "lines": 90, "branches": 85, "functions": 90 },
      "mutation": { "score": 70 }
    }
  ],
  "write_protection": {
    "files": [{ "glob": "plugins/dev-team/bin/knip.json" }]
  }
}
