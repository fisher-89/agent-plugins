{
  "$schema": "https://raw.githubusercontent.com/fisher-89/agent-plugins/refs/heads/master/plugins/dev-team/bin/dev-team-config.schema.json",
  "schema": "spec-driven",
  "static_analysis": "pnpm run -C ./plugins/dev-team check",
  "tests": [
    {
      "root": "plugins/dev-team",
      "framework": "vite-plus",
      "config": "vite.config.ts",
      "includes": ["bin/src/**/*.{ts,tsx}"],
      "excludes": ["bin/src/schemas/**/*"]
    }
  ],
  "write_protection": {
    "files": [{ "glob": "plugins/dev-team/bin/knip.json" }]
  }
}
