{
  "description": "dev-team hooks：PreToolUse 保护受保护文件；SubagentStop static-check 主要作用于 Claude（Cursor 经 agent include 软门禁）。",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/hooks.cjs\" protect-files"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/hooks.cjs\" protect-files"
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/hooks.cjs\" protect-files"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "dev-team:implementation-generator",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/hooks.cjs\" static-check"
          }
        ]
      },
      {
        "matcher": "dev-team:test-gen-generator",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/hooks.cjs\" static-check"
          }
        ]
      }
    ]
  }
}
